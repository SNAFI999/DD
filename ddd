                        end
                    end
                    if not found and langCmd == 'off' then
                        if iddlStore then iddlStore.chatLangIn = 0 end
                        notify('Chat translate IN: OFF')
                    elseif not found then
                        notify('Unknown language: ' .. langCmd)
                    end
