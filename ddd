-- Detect which map the player is closest to based on position
local function detectCurrentMap(car)
    if not car or not car.position then return end
    local px, pz = car.position.x, car.position.z
    local bestIdx = 1
    local bestDist2 = math.huge
    for i = 1, #mapLocations do
        local m = mapLocations[i]
        local dx = px - m.pos.x
        local dz = pz - m.pos.z
        local d2 = dx * dx + dz * dz
        if d2 < bestDist2 then bestDist2 = d2; bestIdx = i end
    end
    local prevMap = currentMapIdx
    currentMapIdx = bestIdx
    -- Bucket assignment is server-side only (MapBucketAssigner scans positions every 2s)
end

-- Count how many connected players are on each map
-- Fetches from server-side endpoint (routing buckets hide cross-map players from client)
local _mapCountFetching = false
local function countPlayersPerMap()
    if _mapCountFetching then return end
    _mapCountFetching = true
    web.get(BASE_URL .. '/maps/player-counts', function(err, resp)
        _mapCountFetching = false
        pcall(function()
            if err or not resp or not resp.body then return end
            local ok, data = pcall(JSON.parse, resp.body)
            if ok and type(data) == 'table' then
                local counts = {}
                for k, v in pairs(data) do
                    counts[tostring(k)] = v
                end
                mapPlayerCounts = counts
            end
        end)
    end)
end





