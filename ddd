-- Cached server-side player info (inputMethod, ping) fetched from /players/online
-- _serverPlayersCache declared near top (forward decl) so countPlayersPerMap() can see it


local function fetchServerPlayersInfo()
    local now = os.clock()
    if now - BR._srvPlFetchTime < BR._srvPlFetchInt then return end
    BR._srvPlFetchTime = now
    pcall(function()
        web.get(BASE_URL .. '/players/online', function(err, resp)
            pcall(function()
            if err then return end
            if not resp or not resp.body then return end
            local ok, data = pcall(JSON.parse, resp.body)
            if ok and type(data) == 'table' then
                local cache = {}
                for _, p in ipairs(data) do
                    if p.name then
                        local prev = _serverPlayersCache[p.name]
                        local av = p.avatar or ''
                        if #av == 0 and prev and #(prev.avatar or '') > 0 then av = prev.avatar end
                        cache[p.name] = { inputMethod = p.inputMethod or 'unknown', ping = p.ping or 0, avatar = av }
                    end
                end
                _serverPlayersCache = cache
            end
            end)
        end)
    end)
end

