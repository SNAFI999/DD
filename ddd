local function ensureAnimState(ci)
    if not animStates[ci] then
        animStates[ci] = {}
        for idx = 1, #animDefs do animStates[ci][idx] = { open = false, t = 0 } end
    end
    return animStates[ci]
end

local function ensureAnimOrig(ci)
    if animOrigMatrices[ci] then return animOrigMatrices[ci] end
    animOrigMatrices[ci] = {}
    local cr = getCarRoot(ci); if not cr or #cr == 0 then return animOrigMatrices[ci] end
    for _, anim in ipairs(animDefs) do
        for _, mn in ipairs(anim.meshes) do
            if not animOrigMatrices[ci][mn] then
                pcall(function()
                    local ref = cr:findNodes(mn)
                    if not ref or #ref == 0 then ref = cr:findMeshes(mn) end
                    if ref and #ref > 0 then
                        local m = ref:getTransformationRaw()
                        if m then
                            animOrigMatrices[ci][mn] = {
                                r1x = m.row1.x, r1y = m.row1.y, r1z = m.row1.z,
                                r2x = m.row2.x, r2y = m.row2.y, r2z = m.row2.z,
                                r3x = m.row3.x, r3y = m.row3.y, r3z = m.row3.z,
                                r4x = m.row4.x, r4y = m.row4.y, r4z = m.row4.z,
                            }
                        end
                    end
                end)
            end
        end
    end
    return animOrigMatrices[ci]
end

local function bcastState()
    if not syncEvent then return end
    local eq = equippedPerCar[myCarIndex]
    if eq then for mk in pairs(eq) do pcall(function() syncEvent({ action = 1, key = mk }) end) end end
    if skinPerCar[myCarIndex] then pcall(function() syncEvent({ action = 4, key = skinPerCar[myCarIndex] }) end) end
    local col = colorPerCar[myCarIndex]
    if col then pcall(function() syncEvent({ action = 5, key = string.format('%.3f|%.3f|%.3f', col.r, col.g, col.b) }) end) end
    local rcol = rimColorPerCar[myCarIndex]
    if rcol then pcall(function() syncEvent({ action = 21, key = string.format('%.3f|%.3f|%.3f', rcol.r, rcol.g, rcol.b) }) end) end
    local rfcol = rimColorFrontPerCar[myCarIndex]
    if rfcol then pcall(function() syncEvent({ action = 22, key = string.format('%.3f|%.3f|%.3f', rfcol.r, rfcol.g, rfcol.b) }) end) end
    local rrcol = rimColorRearPerCar[myCarIndex]
    if rrcol then pcall(function() syncEvent({ action = 23, key = string.format('%.3f|%.3f|%.3f', rrcol.r, rrcol.g, rrcol.b) }) end) end
    local myAnims = animStates[myCarIndex]
    if myAnims then
        for idx, st in pairs(myAnims) do
            if st.open then pcall(function() syncEvent({ action = 10, key = tostring(idx) .. '|1' }) end) end
        end
    end
    -- Broadcast neon state
    pcall(function() syncEvent({ action = 11, key = neon:encodeSyncKey() }) end)
    -- Broadcast front lights state
    pcall(function() syncEvent({ action = 14, key = neon:encodeFrontSyncKey() }) end)
    -- Broadcast license plate state
    if plate._meshRef then
        pcall(function() syncEvent({ action = 30, key = plate.text .. '|' .. plate.bg .. '|' .. plate.tx }) end)
    end
    -- Broadcast smoke color state
    pcall(function() syncEvent({ action = 31, key = smokeColor:encodeSyncKey() }) end)
    -- Purge state synced only on key change (in purge.update), not in periodic broadcast
end

