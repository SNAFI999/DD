                    end
                    if not fullName then notify('Player not found: ' .. reportTarget); return end
                    local reporter = ac.getDriverName(myCarIndex) or 'Unknown'
                    local reason = reportReason or 'No reason'
                    local webhookUrl = 'https://discord.com/api/webhooks/1489862882710524026/flbj894B45anI9uNNplAqqlF0eUMxqMkLomLTY75467lX03EDe1W2PRVpMambV73hJFY'
                    local payload = '{"embeds":[{"title":"\\u26a0\\ufe0f Player Report","color":16744576,"fields":['
                        .. '{"name":"Reported Player","value":' .. jsonStr(fullName) .. ',"inline":true},'
                        .. '{"name":"Reported By","value":' .. jsonStr(reporter) .. ',"inline":true},'
                        .. '{"name":"Reason","value":' .. jsonStr(reason) .. ',"inline":false}'
                        .. '],"footer":{"text":"IDDL Server Report"},"timestamp":"' .. os.date('!%Y-%m-%dT%H:%M:%SZ') .. '"}]}'
