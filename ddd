function purge.toWorld(car, localPos)
    return car.bodyTransform:transformPoint(localPos)
end

function purge.dirToWorld(car, localDir)
    return car.bodyTransform:transformVector(localDir)
end

purge._dbgClock = 0
function purge.update(car)
    if not purge.smoke then return end
    if not car or not car.bodyTransform then return end
    local uDown = ac.isKeyDown(purge._keyCode or 0x55) or isGpPressed(purge._gpCode or 0x1)
    -- BR, showPanel, chat are locals defined later in the file — not visible as upvalues here.
    -- Access them via _G (they shadow as globals if accessed before local decl? No — they're local).
    -- Instead, store refs on purge table from the main loop where they ARE visible.
    local brWantsKbd = purge._brWantsKbd or false
    local panelShown = purge._showPanel or false
    local chatActive = purge._chatActive or false
    local now = os.clock()
    local nowActive = uDown and purge.enabled and not (brWantsKbd and panelShown) and not chatActive
    purge.active = nowActive
    if nowActive then
        local wL = purge.toWorld(car, purge.leftPos)
        local wR = purge.toWorld(car, purge.rightPos)
        local vL = purge.dirToWorld(car, purge.leftVel)
        local vR = purge.dirToWorld(car, purge.rightVel)
        purge.smoke:emit(wL, vL, purge.quantity)
        purge.smoke:emit(wR, vR, purge.quantity)
    end
    -- Purge sound: play/stop on state transitions
    if nowActive ~= purge._soundPlaying then
        purge._soundPlaying = nowActive
        if purge.sound then
            pcall(function()
                if nowActive then
                    if not purge._soundReady then
                        purge.sound:setSource(purge._soundUrl):setAutoPlay(false):setLooping(true):setVolume(1)
                        purge._soundReady = true
                    end
                    purge.sound:play()
                else
                    purge.sound:setCurrentTime(0):pause()
                end
            end)
        end
    end
    if not nowActive then purge._soundStartTime = nil end
    -- Sync state change to other players
    if uDown ~= purge._uWasDown then
        purge._uWasDown = uDown
        if purge._syncEvent then
            pcall(function() purge._syncEvent({ action = 20, key = nowActive and '1' or '0' }) end)
        end
    end
end

function purge.updateRemote(ci, active)
    local rem = purge.remotes[ci]
    if not rem then
        rem = { active = false, smoke = nil }
        pcall(function()
            rem.smoke = ac.Particles.Smoke({
                color = rgbm(1, 1, 1, 0.85),
                colorConsistency = 0.5,
                thickness = 0,
                life = 0.3,
                size = 0.002,
                spreadK = 0.1,
                growK = 0.5,
                targetYVelocity = 0,
            })
        end)
        purge.remotes[ci] = rem
    end
    rem.active = active
    if active and rem.smoke then
        pcall(function()
            local c = ac.getCar(ci)
            if c and c.bodyTransform then
                local wL = purge.toWorld(c, purge.leftPos)
                local wR = purge.toWorld(c, purge.rightPos)
                local vL = purge.dirToWorld(c, purge.leftVel)
                local vR = purge.dirToWorld(c, purge.rightVel)
                rem.smoke:emit(wL, vL, purge.quantity)
                rem.smoke:emit(wR, vR, purge.quantity)
            end
        end)
    end
end

function neon:create()
    if #self.lights > 0 then return end
    -- Compute dynamic count from EasyNeon settings
    self._count = self.sideCount * 2 + self.frontRearCount * 2
    local n = self._count
    local br = self.brightness * 3
    local col = rgb(self.r * br, self.g * br, self.b * br)
    local ok, err = pcall(function()
        for i = 1, n do
            local light = ac.LightSource(ac.LightType.Spot)
            light.range            = self.neonRange
            light.spot             = self.neonSpot
            light.spotSharpness    = self.neonSharpness
            light.rangeGradientOffset = 0.05
            light.specularMultiplier = 0.05
            light.fadeAt           = 150
            light.fadeSmooth       = 40
            light.showInReflections = true
            light.shadows          = false
            light.singleFrequency  = 0
            light.color            = col
            light.direction        = vec3(0, -1, 0)
            light.position         = vec3(0, -100, 0)
            self.lights[i] = light
        end
    end)
    if ok then
        self.apiOk = true
    else
        self.lights = {}
        self.apiOk = false
    end
end

function neon:destroy()
    for _, light in ipairs(self.lights) do
        pcall(function() light:dispose() end)
    end
    self.lights = {}
end

function neon:updateColors()
    local br = self.brightness * 3
    local col = rgb(self.r * br, self.g * br, self.b * br)
    for _, light in ipairs(self.lights) do
        pcall(function() light.color = col end)
    end
end

function neon:save()
    pcall(function()
        if iddlStore then
            iddlStore.neonEnabled = self.enabled and 1 or 0
            iddlStore.neonR = self.r
            iddlStore.neonG = self.g
            iddlStore.neonB = self.b
            iddlStore.neonBrightness = self.brightness
            iddlStore.neonMode = self.mode
        end
    end)
end

-- ── FRONT LIGHTS methods ────────────────────────────────────────────────

local function getCarRoot(ci) return ac.findNodes('carRoot:' .. (tonumber(ci) or 0)) end

-- Read headlight positions from the car's data.acd lights.ini
-- Updates bulb-glow offsets (indices 3,4) to match the POSITION of LIGHT_0 / LIGHT_1.
-- Also finds the headlight mesh NAMEs and stores them for emissive rendering.
function neon:discoverHeadlightOffsets(ci)
    local fl = self.front
    if fl._hlOffsetsDiscovered then return end
    fl._hlOffsetsDiscovered = true
    pcall(function()
        local cid = ac.getCarID(ci)
        if not cid or cid == '' then return end
        local lightsIni = nil
        pcall(function()
            lightsIni = ac.INIConfig.load(
                ac.getFolder(ac.FolderID.ContentCars) .. '/' .. cid .. '/data/lights.ini',
                ac.INIFormat.DefaultAcd)
        end)
        if not lightsIni then
            pcall(function() lightsIni = ac.INIConfig.carData(ci, 'lights.ini') end)
        end
        if not lightsIni then return end

        -- Parse "x, y, z" string into components
        local function parseVec3(str)
            if not str or str == '' then return nil end
            local x, y, z = str:match('([%d%.%-eE]+)%s*[,;]%s*([%d%.%-eE]+)%s*[,;]%s*([%d%.%-eE]+)')
            if x then return tonumber(x), tonumber(y), tonumber(z) end
            return nil
        end

        -- Collect headlight records (LIGHT_0, LIGHT_1 are headlights in AC convention)
        local hlPositions = {}
        local hlMeshNames = {}
        for idx = 0, 9 do
            local sec = 'LIGHT_' .. idx
            local meshName = lightsIni:get(sec, 'NAME', '')
            if meshName == '' then meshName = lightsIni:get(sec, 'MESH', '') end
            if meshName == '' then break end  -- no more lights
            -- Only LIGHT_0 and LIGHT_1 = headlights (AC convention)
            if idx <= 1 then
                local posStr = lightsIni:get(sec, 'POSITION', '')
                local px, py, pz = parseVec3(posStr)
                if px then
                    hlPositions[#hlPositions + 1] = { x = px, y = py, z = pz }
                end
                hlMeshNames[#hlMeshNames + 1] = meshName
            end
        end

        -- Store mesh names for emissive glow
        fl._hlMeshNames = hlMeshNames

        -- Assign positions to ALL 4 lights from lights.ini headlight positions
        -- lights.ini POSITION is car-local: x=side, y=up, z=forward
        -- Projectors (1,2) at headlight positions
        if #hlPositions >= 1 then
            local off1 = { s = hlPositions[1].x, f = hlPositions[1].z, h = hlPositions[1].y }
            fl._offsets[1] = off1  -- left projector
        end
        if #hlPositions >= 2 then
            local off2 = { s = hlPositions[2].x, f = hlPositions[2].z, h = hlPositions[2].y }
            fl._offsets[2] = off2  -- right projector
        elseif #hlPositions == 1 then
            -- Mirror left headlight to right side
            local offM = { s = -hlPositions[1].x, f = hlPositions[1].z, h = hlPositions[1].y }
            fl._offsets[2] = offM  -- right projector
        end

        -- Apply emissive material to headlight meshes so they glow visibly
        local cr = getCarRoot(ci)
        if cr and #cr > 0 and #hlMeshNames > 0 then
            for _, mn in ipairs(hlMeshNames) do
                local meshRef = cr:findMeshes(mn)
                if meshRef and #meshRef > 0 then
                    meshRef:ensureUniqueMaterials()
                    fl._hlMeshRefs = fl._hlMeshRefs or {}
                    fl._hlMeshRefs[#fl._hlMeshRefs + 1] = meshRef
                end
            end
        end
    end)
end

-- Same discovery but for a remote car, caches per car-index
function neon:discoverRemoteHeadlightOffsets(ci)
    if self._remoteHlOffsets[ci] then return end
    self._remoteHlOffsets[ci] = { found = false }
    pcall(function()
        local cid = ac.getCarID(ci)
        if not cid or cid == '' then return end
        local lightsIni = nil
        pcall(function()
            lightsIni = ac.INIConfig.load(
                ac.getFolder(ac.FolderID.ContentCars) .. '/' .. cid .. '/data/lights.ini',
                ac.INIFormat.DefaultAcd)
        end)
        if not lightsIni then
            pcall(function() lightsIni = ac.INIConfig.carData(ci, 'lights.ini') end)
        end
        if not lightsIni then return end

        local function parseVec3(str)
            if not str or str == '' then return nil end
            local x, y, z = str:match('([%d%.%-eE]+)%s*[,;]%s*([%d%.%-eE]+)%s*[,;]%s*([%d%.%-eE]+)')
            if x then return tonumber(x), tonumber(y), tonumber(z) end
            return nil
        end

        local hlPositions = {}
        local hlMeshNames = {}
        for idx = 0, 9 do
            local sec = 'LIGHT_' .. idx
            local meshName = lightsIni:get(sec, 'NAME', '')
            if meshName == '' then meshName = lightsIni:get(sec, 'MESH', '') end
            if meshName == '' then break end
            if idx <= 1 then
                local posStr = lightsIni:get(sec, 'POSITION', '')
                local px, py, pz = parseVec3(posStr)
                if px then hlPositions[#hlPositions + 1] = { x = px, y = py, z = pz } end
                hlMeshNames[#hlMeshNames + 1] = meshName
            end
        end

        self._remoteHlOffsets[ci].meshNames = hlMeshNames

        -- Projectors (1,2) at headlight positions
        if #hlPositions >= 1 then
            local off1 = { s = hlPositions[1].x, f = hlPositions[1].z, h = hlPositions[1].y }
            self._remoteHlOffsets[ci][1] = off1
        end
        if #hlPositions >= 2 then
            local off2 = { s = hlPositions[2].x, f = hlPositions[2].z, h = hlPositions[2].y }
            self._remoteHlOffsets[ci][2] = off2
        elseif #hlPositions == 1 then
            local offM = { s = -hlPositions[1].x, f = hlPositions[1].z, h = hlPositions[1].y }
            self._remoteHlOffsets[ci][2] = offM
        end
        self._remoteHlOffsets[ci].found = (#hlPositions > 0)

        -- Apply emissive to remote car headlight meshes
        local cr = getCarRoot(ci)
        if cr and #cr > 0 and #hlMeshNames > 0 then
            local meshRefs = {}
            for _, mn in ipairs(hlMeshNames) do
                local meshRef = cr:findMeshes(mn)
                if meshRef and #meshRef > 0 then
                    meshRef:ensureUniqueMaterials()
                    meshRefs[#meshRefs + 1] = meshRef
                end
            end
            self._remoteHlOffsets[ci].meshRefs = meshRefs
        end
    end)
end

function neon:createFront()
    local fl = self.front
    if #fl.lights > 0 then return end
    local col = rgb(fl.r * fl.brightness, fl.g * fl.brightness, fl.b * fl.brightness)
    local ok, err = pcall(function()
        for i = 1, fl._count do
            local light = ac.LightSource(ac.LightType.Area)
            light.range = 50.0             -- road projector
            light.spot = 55                -- wider cone
            light.spotSharpness = 0.5      -- soft edges
            light.rangeGradientOffset = 0.05
            light.specularMultiplier = 3.0
            light.fadeAt = 300
            light.fadeSmooth = 60
            light.showInReflections = true
            light.shadows = false
            light.singleFrequency = 0
            light.color = col
            light.direction = vec3(0, 0, 1)
            light.position = vec3(0, -100, 0)
            fl.lights[i] = light
        end
    end)
    if not ok then
        fl.lights = {}
    end
end

function neon:destroyFront()
    local fl = self.front
    for _, light in ipairs(fl.lights) do
        pcall(function() light:dispose() end)
    end
    fl.lights = {}
end

function neon:updateFrontColors()
    local fl = self.front
    for _, light in ipairs(fl.lights) do
        pcall(function()
            light.color = rgb(fl.r * fl.brightness, fl.g * fl.brightness, fl.b * fl.brightness)
        end)
    end
    -- Update emissive on headlight meshes — colored by chosen front color
    if fl._hlMeshRefs and fl._hlEmissiveOn then
        local isOn = (fl.r + fl.g + fl.b) > 0.01
        for _, meshRef in ipairs(fl._hlMeshRefs) do
            pcall(function()
                meshRef:setMaterialProperty('ksEmissive', isOn and rgb(fl.r * 30.0, fl.g * 30.0, fl.b * 30.0) or rgb(0, 0, 0))
                meshRef:setMaterialProperty('ksDiffuse', isOn and 0.0 or 1.0)
                meshRef:setMaterialProperty('ksAmbient', isOn and 10.0 or 0.0)
            end)
        end
    end
end

function neon:saveFront()
    pcall(function()
        if iddlStore then
            local fl = self.front
            iddlStore.flEnabled = fl.enabled and 1 or 0
            iddlStore.flR = fl.r
            iddlStore.flG = fl.g
            iddlStore.flB = fl.b
            iddlStore.flBrightness = fl.brightness
            iddlStore.flMode = fl.mode
        end
    end)
end

function neon:applyFrontAnimColors(dt)
    local fl = self.front
    local mode = fl.mode
    if mode == 'none' then
        fl.r = fl._baseR; fl.g = fl._baseG; fl.b = fl._baseB
        return
    end
    fl._modeTimer = fl._modeTimer + dt
    local t = fl._modeTimer
    if mode == 'rainbow' then
        -- All lights same color, cycling through hues
        local hue = (t * 60) % 360
        local rr, gg, bb = self:hsv2rgb(hue, 1, 1)
        local col = rgb(rr * fl.brightness, gg * fl.brightness, bb * fl.brightness)
        for i = 1, fl._count do
            if fl.lights[i] then
                pcall(function() fl.lights[i].color = col end)
            end
        end
        if fl._hlMeshRefs and fl._hlEmissiveOn then
            for _, meshRef in ipairs(fl._hlMeshRefs) do
                pcall(function() meshRef:setMaterialProperty('ksEmissive', rgb(rr * 30.0, gg * 30.0, bb * 30.0)) end)
            end
        end
        return
    elseif mode == 'police' then
        -- Both lights flash same color simultaneously: red then blue, slow rate
        local cycle = math.floor(t * 2) % 2  -- ~1Hz: 0.5s red, 0.5s blue
        local rr, gg, bb
        if cycle == 0 then
            rr, gg, bb = 1, 0, 0  -- red
        else
            rr, gg, bb = 0, 0, 1  -- blue
        end
        for i = 1, fl._count do
            if fl.lights[i] then
                pcall(function()
                    fl.lights[i].color = rgb(rr * fl.brightness, gg * fl.brightness, bb * fl.brightness)
                end)
            end
        end
        if fl._hlMeshRefs and fl._hlEmissiveOn then
            for _, meshRef in ipairs(fl._hlMeshRefs) do
                pcall(function() meshRef:setMaterialProperty('ksEmissive', rgb(rr * 30.0, gg * 30.0, bb * 30.0)) end)
            end
        end
        return
    elseif mode == 'brake' then
        local car = ac.getCar(0)
        if car and car.brake > 0.05 then
            fl.r = 1; fl.g = 0; fl.b = 0
        else
            fl.r = fl._baseR; fl.g = fl._baseG; fl.b = fl._baseB
        end
    elseif mode == 'strobe' then
        -- Pattern: .  ..  . (flash, long pause, flash-flash, long pause, flash) ~3s cycle
        local cycle = t % 3.0
        local on = false
        if cycle < 0.1 then on = true                          -- .  (first flash)
        elseif cycle >= 1.0 and cycle < 1.1 then on = true     -- .  (first of double)
        elseif cycle >= 1.3 and cycle < 1.4 then on = true     -- .  (second of double)
        elseif cycle >= 2.3 and cycle < 2.4 then on = true     -- .  (last flash)
        end
        if on then
            fl.r = fl._baseR; fl.g = fl._baseG; fl.b = fl._baseB
        else
            fl.r = 0; fl.g = 0; fl.b = 0
        end
    elseif mode == 'wave' then
        -- All lights pulse together
        local phase = math.sin(t * 3)
        local intensity = (phase + 1) / 2
        local col = rgb(fl._baseR * fl.brightness * intensity, fl._baseG * fl.brightness * intensity, fl._baseB * fl.brightness * intensity)
        for i = 1, fl._count do
            if fl.lights[i] then
                pcall(function() fl.lights[i].color = col end)
            end
        end
        if fl._hlMeshRefs and fl._hlEmissiveOn then
            for _, meshRef in ipairs(fl._hlMeshRefs) do
                pcall(function() meshRef:setMaterialProperty('ksEmissive', rgb(fl._baseR * 30.0 * intensity, fl._baseG * 30.0 * intensity, fl._baseB * 30.0 * intensity)) end)
            end
        end
        return
    elseif mode == 'music' then
        -- Beat-reactive: left and right headlights flash separately, alternating on each onset
        local env      = self._beatEnvelope or 0
        local onset    = self._beatOnset    or false
        local hueShift = self._beatHueShift or 0
        -- Lazy-init per-side state on fl table
        fl._flBeatSide   = fl._flBeatSide   or 0
        fl._flOnsetTimer = fl._flOnsetTimer  or 0
        if fl._flOnsetTimer > 0 then
            fl._flOnsetTimer = fl._flOnsetTimer - dt
        end
        if onset then
            fl._flBeatSide   = 1 - fl._flBeatSide   -- toggle: 0=left leads, 1=right leads
            fl._flOnsetTimer = 0.12                  -- flash window 120 ms
        end
        -- Derive color from base + accumulated hue shift
        local h, s, v = self:rgb2hsv(fl._baseR or 1, fl._baseG or 0, fl._baseB or 1)
        h = (h + hueShift) % 360
        s = math.max(s, 0.8)
        v = math.max(v, 0.6)
        local cr, cg, cb = self:hsv2rgb(h, s, v)
        -- Base brightness scales with beat envelope
        local baseBr  = fl.brightness * (0.08 + env * 0.92)
        local flashBr = fl.brightness * 1.8
        local leftBr, rightBr
        if fl._flOnsetTimer > 0 then
            if fl._flBeatSide == 0 then
                leftBr  = flashBr
                rightBr = baseBr * 0.2
            else
                leftBr  = baseBr * 0.2
                rightBr = flashBr
            end
        else
            leftBr  = baseBr
            rightBr = baseBr
        end
        -- lights[1]+[3] = left headlight, lights[2]+[4] = right headlight
        local function setHL(li, br)
            if fl.lights[li] then
                pcall(function() fl.lights[li].color = rgb(cr * br, cg * br, cb * br) end)
            end
        end
        setHL(1, leftBr);  setHL(3, leftBr)
        setHL(2, rightBr); setHL(4, rightBr)
        -- Emissive glow on headlight meshes: odd index=left, even=right
        if fl._hlMeshRefs and fl._hlEmissiveOn then
            local emL = rgb(cr * leftBr  * 20.0, cg * leftBr  * 20.0, cb * leftBr  * 20.0)
            local emR = rgb(cr * rightBr * 20.0, cg * rightBr * 20.0, cb * rightBr * 20.0)
            for idx, meshRef in ipairs(fl._hlMeshRefs) do
                local em = (idx % 2 == 1) and emL or emR
                pcall(function() meshRef:setMaterialProperty('ksEmissive', em) end)
            end
        end
        return
    end
    -- For modes that set fl.r/g/b (brake, strobe), apply uniformly
    self:updateFrontColors()
end

function neon:updateFront(car)
    local fl = self.front
    if not fl.enabled or not car then
        -- Hide lights when disabled
        for _, light in ipairs(fl.lights) do
            pcall(function() light.position = vec3(0, -100, 0) end)
        end
        -- Turn off emissive on headlight meshes
        if fl._hlEmissiveOn then
            fl._hlEmissiveOn = false
            if fl._hlMeshRefs then
                for _, meshRef in ipairs(fl._hlMeshRefs) do
                    pcall(function()
                        meshRef:setMaterialProperty('ksEmissive', 0.0)
                        meshRef:setMaterialProperty('ksDiffuse', 1.0)
                        meshRef:setMaterialProperty('ksAmbient', 0.0)
                    end)
                end
            end
        end
        return
    end
    -- Lazy create
    if #fl.lights == 0 then self:createFront() end
    if #fl.lights == 0 then return end
    -- Discover real headlight node positions (one-time)
    self:discoverHeadlightOffsets(myCarIndex)
    -- Apply emissive glow to headlight meshes (proven approach from backup)
    if fl._hlMeshRefs and not fl._hlEmissiveOn then
        fl._hlEmissiveOn = true
        for _, meshRef in ipairs(fl._hlMeshRefs) do
            pcall(function()
                meshRef:setMaterialProperty('ksEmissive', rgb(fl.r * 30.0, fl.g * 30.0, fl.b * 30.0))
                meshRef:setMaterialProperty('ksDiffuse', 0.0)
                meshRef:setMaterialProperty('ksAmbient', 10.0)
            end)
        end
    end
    local pos = car.position
    local look = car.look
    local side = car.side
    if not pos or not look or not side then return end
    for i = 1, fl._count do
        local off = fl._offsets[i]
        if off and fl.lights[i] then
            pcall(function()
                fl.lights[i].position = pos + side * off.s + look * off.f + vec3(0, off.h, 0)
                fl.lights[i].direction = (look - vec3(0, 0.08, 0)):normalize()
            end)
        end
    end
end

-- HSV to RGB helper (h:0-360,s:0-1,v:0-1)
function neon:hsv2rgb(h, s, v)
    local c = v * s
    local x = c * (1 - math.abs((h / 60) % 2 - 1))
    local m = v - c
    local r, g, b = 0, 0, 0
    if h < 60 then r, g, b = c, x, 0
    elseif h < 120 then r, g, b = x, c, 0
    elseif h < 180 then r, g, b = 0, c, x
    elseif h < 240 then r, g, b = 0, x, c
    elseif h < 300 then r, g, b = x, 0, c
    else r, g, b = c, 0, x end
    return r + m, g + m, b + m
end

-- RGB to HSV helper (r,g,b:0-1 → h:0-360,s:0-1,v:0-1)
function neon:rgb2hsv(r, g, b)
    local mx = math.max(r, g, b)
    local mn = math.min(r, g, b)
    local d = mx - mn
    local h, s, v = 0, 0, mx
    if mx > 0 then s = d / mx end
    if d > 0.0001 then
        if mx == r then h = 60 * (((g - b) / d) % 6)
        elseif mx == g then h = 60 * ((b - r) / d + 2)
        else h = 60 * ((r - g) / d + 4) end
    end
    if h < 0 then h = h + 360 end
    return h, s, v
end

-- Apply animation colors to a set of lights; used for both own and remote
function neon:applyAnimColors(lights, mode, timer, brightness, policePhase, car)
    if not lights or #lights == 0 then return end
    local n = #lights
    local br = brightness * 3
    local TAU = math.pi * 2
    if mode == 'pulse' then
        local tAnim = timer % math.max(0.01, 2.7)
        tAnim = tAnim / 2.7
        local tri = 1.0 - math.abs(2.0 * tAnim - 1.0)
        local base = 0.30
        local pBr = br * (base + (1.0 - base) * tri)
        local col = rgb(self._baseR * pBr, self._baseG * pBr, self._baseB * pBr)
        for i = 1, n do lights[i].color = col end
    elseif mode == 'rgbcycle' then
        local tAnim = (timer / 2.7) % 1
        local a = tAnim * TAU
        local rr = 0.5 + 0.5 * math.sin(a)
        local gg = 0.5 + 0.5 * math.sin(a + 2.0943951)
        local bb = 0.5 + 0.5 * math.sin(a + 4.1887902)
        local col = rgb(rr * br, gg * br, bb * br)
        for i = 1, n do lights[i].color = col end
    elseif mode == 'chase' then
        local tAnim = (timer / 2.7) % 1
        local totalLamps = n
        for i = 1, n do
            local u = (i - 1) / totalLamps
            local dF = (u - tAnim + 1) % 1
            local dB = (tAnim - u + 1) % 1
            local dC = math.min(dF, dB)
            local head = math.max(0, math.min(1, 1 - dC / 0.15))
            local tail = 0
            if dB < 0.5 then tail = math.max(0, math.min(1, 1 - dB / 0.18)); tail = tail * tail end
            local mult = math.max(0, math.min(1, 0.30 + math.max(head, tail)))
            lights[i].color = rgb(self._baseR * br * mult, self._baseG * br * mult, self._baseB * br * mult)
        end
    elseif mode == 'rgbchase' then
        local tAnim = (timer / 2.7) % 1
        local totalLamps = n
        for i = 1, n do
            local u = (i - 1) / totalLamps
            local dF = (u - tAnim + 1) % 1
            local dB = (tAnim - u + 1) % 1
            local dC = math.min(dF, dB)
            local head = math.max(0, math.min(1, 1 - dC / 0.15))
            local tail = 0
            if dB < 0.5 then tail = math.max(0, math.min(1, 1 - dB / 0.18)); tail = tail * tail end
            local mult = math.max(0, math.min(1, 0.30 + math.max(head, tail)))
            local a = (u + tAnim) * TAU
            local rr = (0.5 + 0.5 * math.sin(a)) * br * mult
            local gg = (0.5 + 0.5 * math.sin(a + 2.0943951)) * br * mult
            local bb = (0.5 + 0.5 * math.sin(a + 4.1887902)) * br * mult
            lights[i].color = rgb(rr, gg, bb)
        end
    elseif mode == 'rainbow' then
        for i = 1, n do
            local hue = (timer * 120 + (i - 1) * (360 / n)) % 360
            local ar, ag, ab = self:hsv2rgb(hue, 1.0, 1.0)
            lights[i].color = rgb(ar * br, ag * br, ab * br)
        end
    elseif mode == 'police' then
        -- Left/right alternating red and blue with smooth center blend
        -- LED layout: FRONT(1..frc), RIGHT(frc+1..frc+sc), REAR(frc+sc+1..frc*2+sc), LEFT(frc*2+sc+1..n)
        local cycle = math.floor(timer * 3) % 2
        local frc = self.frontRearCount or 7
        local sc = self.sideCount or 9
        local centerFR = (frc + 1) / 2  -- e.g. 4.0 for 7 LEDs
        local blendWidth = 1.5  -- LEDs over which to blend
        for i = 1, n do
            -- Compute a "side factor": -1 = full left, +1 = full right, 0 = center
            local sf
            if i <= frc then
                -- Front strip: LED 1 = leftmost, LED frc = rightmost
                sf = (i - centerFR) / blendWidth
            elseif i <= frc + sc then
                -- Right side strip: all right
                sf = 1.0
            elseif i <= frc * 2 + sc then
                -- Rear strip: LED layout is reversed (right-to-left)
                local ri = i - frc - sc  -- 1..frc within rear
                sf = (centerFR - ri) / blendWidth
            else
                -- Left side strip: all left
                sf = -1.0
            end
            sf = math.max(-1, math.min(1, sf))
            -- sf: -1=left, +1=right; blend smoothly through 0
            local rightAmount = (sf + 1) * 0.5  -- 0=left, 1=right
            local leftAmount = 1.0 - rightAmount
            local rr, gg, bb
            if cycle == 0 then
                -- left=red, right=blue
                rr = leftAmount * 1.0
                gg = 0
                bb = rightAmount * 1.0
            else
                -- left=blue, right=red
                rr = rightAmount * 1.0
                gg = 0
                bb = leftAmount * 1.0
            end
            lights[i].color = rgb(rr * br, gg, bb * br)
        end
    elseif mode == 'brake' then
        -- Check brake input; if braking â†’ bright red, else â†’ user color
        local braking = car and car.brake and car.brake > 0.05 or false
        if braking then
            local col = rgb(1.0 * br, 0.0, 0.0)
            for i = 1, n do lights[i].color = col end
        else
            local col = rgb(self._baseR * br, self._baseG * br, self._baseB * br)
            for i = 1, n do lights[i].color = col end
        end
    elseif mode == 'breathing' then
        local pulse = (math.sin(timer * 3.0) + 1.0) * 0.5
        local bpBr = br * (0.15 + pulse * 0.85)
        local col = rgb(self._baseR * bpBr, self._baseG * bpBr, self._baseB * bpBr)
        for i = 1, n do lights[i].color = col end
    elseif mode == 'strobe' then
        local cycle = timer % 3.0
        local on = false
        if cycle < 0.1 then on = true
        elseif cycle >= 1.0 and cycle < 1.1 then on = true
        elseif cycle >= 1.3 and cycle < 1.4 then on = true
        elseif cycle >= 2.3 and cycle < 2.4 then on = true
        end
        if on then
            local col = rgb(self._baseR * br, self._baseG * br, self._baseB * br)
            for i = 1, n do lights[i].color = col end
        else
            for i = 1, n do lights[i].color = _C.RGB_BLACK end
        end
    elseif mode == 'wave' then
        for i = 1, n do
            local phase = (timer * 2.5 + (i - 1) * 0.45)
            local w = (math.sin(phase) + 1.0) * 0.5
            local wBr = br * (0.1 + w * 0.9)
            lights[i].color = rgb(self._baseR * wBr, self._baseG * wBr, self._baseB * wBr)
        end
    elseif mode == 'drift' then
        local angle = self._driftAngle or 0
        local speed = self._driftSpeed or 0
        local drifting = (angle > 10 and speed > 20)
        if drifting then
            local intensity = math.min(angle / 60.0, 1.0)
            local dr = self._baseR + (1.0 - self._baseR) * intensity * 0.7
            local dg = self._baseG * (1.0 - intensity * 0.4)
            local db = self._baseB * (1.0 - intensity * 0.8)
            local dBr = br * (0.6 + intensity * 0.8)
            local col = rgb(dr * dBr, dg * dBr, db * dBr)
            for i = 1, n do lights[i].color = col end
        else
            local col = rgb(self._baseR * br, self._baseG * br, self._baseB * br)
            for i = 1, n do lights[i].color = col end
        end
    elseif mode == 'rpm' then
        -- Color shifts green->yellow->orange->red based on engine RPM, flashes near redline
        local rpm = self._rpm or 0
        local rpmMax = self._rpmMax or 8000
        local ratio = math.min(1.0, math.max(0, rpm / math.max(1, rpmMax)))
        local rr, gg, bb
        if ratio < 0.4 then
            local t = ratio / 0.4
            rr = t; gg = 1.0; bb = 0.0
        elseif ratio < 0.7 then
            local t = (ratio - 0.4) / 0.3
            rr = 1.0; gg = 1.0 - t * 0.5; bb = 0.0
        else
            local t = (ratio - 0.7) / 0.3
            rr = 1.0; gg = 0.5 - t * 0.5; bb = 0.0
        end
        local flashMult = 1.0
        if ratio > 0.85 then
            local flashSpeed = 4 + (ratio - 0.85) * 60
            flashMult = (math.sin(timer * flashSpeed * math.pi * 2) + 1) * 0.5
            flashMult = 0.3 + flashMult * 0.7
        end
        local col = rgb(rr * br * flashMult, gg * br * flashMult, bb * br * flashMult)
        for i = 1, n do lights[i].color = col end
    elseif mode == 'music' or mode == 'music_rainbow' or mode == 'music_complement' or mode == 'music_sparkle' or mode == 'music_split' then
        --[[ Music beat-reactive mode — 4 effects: selectable or auto-cycling every 6 beats
             Effect 0 / music_rainbow    — full spectrum across LEDs, brightness wave on beat
             Effect 1 / music_complement — even/odd LEDs get complementary colors, chase wave
             Effect 2 / music_sparkle    — each LED random delay + hue scatter around beat
             Effect 3 / music_split      — two halves mirror-pulse toward center on beat
        ]]
        local env      = self._beatEnvelope or 0
        local onset    = self._beatOnset    or false
        local hueShift = self._beatHueShift or 0
        local now      = os.clock()

        if onset then
            self._beatOnsetTime = now
            self._beatCount = ((self._beatCount or 0) + 1)
        end
        local onsetAge  = now - (self._beatOnsetTime or -999)
        local beatCount = self._beatCount or 0
        local effect
        if     mode == 'music_rainbow'    then effect = 0
        elseif mode == 'music_complement' then effect = 1
        elseif mode == 'music_sparkle'    then effect = 2
        elseif mode == 'music_split'      then effect = 3
        else   effect = math.floor(beatCount / 6) % 4  -- 'music': auto-cycle
        end

        -- When env=0 (music stopped/not playing) baseBr=0 → LEDs go completely dark
        local STAGGER = 0.16
        local PULSE   = 0.22
        local baseBr  = br * env * 0.20

        local function ledPulse(age)
            if age < 0 or age >= PULSE then return 0 end
            if age < 0.025 then return age / 0.025 end
            return math.exp(-(age - 0.025) * 15)
        end

        -- simple integer hash for sparkle offsets (no math.random state issues)
        local function ihash(x)
            x = bit.bxor(x, bit.rshift(x, 16)) * 0x45d9f3b
            return bit.band(bit.bxor(x, bit.rshift(x, 16)), 0xffff)
        end

        for i = 1, n do
            local u   = (i - 1) / math.max(n - 1, 1)  -- 0..1 position along strip
            local h2, s2, pulse

            if effect == 0 then
                -- RAINBOW: hue spreads full 360° across strip, rotates with each beat
                h2 = (hueShift + u * 360) % 360
                s2 = 1.0
                local delay = u * STAGGER
                pulse = ledPulse(onsetAge - delay)

            elseif effect == 1 then
                -- COMPLEMENT: odd LEDs = base hue, even = +180°, staggered cascade
                local base = hueShift % 360
                h2 = (i % 2 == 1) and base or (base + 180) % 360
                s2 = 1.0
                local delay = u * STAGGER
                pulse = ledPulse(onsetAge - delay)

            elseif effect == 2 then
                -- SPARKLE: each LED random hue offset + random delay, scattered burst
                local seed  = bit.band(i + beatCount * 31, 0xffff)
                local rHue  = (ihash(seed)                    / 65536.0) * 120  -- ±60° offset
                local rDel  = (ihash(bit.bxor(seed, 0xA3B1)) / 65536.0) * 0.25
                h2 = (hueShift + rHue) % 360
                s2 = 0.9 + (ihash(bit.bxor(seed, 0x11F5)) / 65536.0) * 0.1
                pulse = ledPulse(onsetAge - rDel)

            else
                -- SPLIT: first half cascades forward, second half cascades backward → meet at center
                local base = hueShift % 360
                h2 = (u < 0.5) and base or (base + 60) % 360
                s2 = 1.0
                local delay = (u < 0.5) and (u * 2 * STAGGER) or ((1 - u) * 2 * STAGGER)
                pulse = ledPulse(onsetAge - delay)
            end

            local cr2, cg2, cb2 = self:hsv2rgb(h2, s2, 1.0)
            local intensity = baseBr + (br * 1.6 - baseBr) * pulse
            lights[i].color = rgb(cr2 * intensity, cg2 * intensity, cb2 * intensity)
        end
    end
end

function neon:update(car)
    if not car or not self.enabled then
        if self.apiOk then
            for _, light in ipairs(self.lights) do
                light.position = _C.VEC3_HIDE
            end
        end
        self._positions = {}
        return
    end
    local look = car.look
    local side = car.side
    if not look or not side then return end
    -- Create lights if needed
    if self.apiOk == nil or (self.apiOk and #self.lights == 0) then self:create() end
    -- Wheel-based center (EasyNeon approach)
    local downDir = car.up and vec3(-car.up.x, -car.up.y, -car.up.z) or _C.VEC3_DOWN
    local w0 = car.wheels[0].position
    local w1 = car.wheels[1].position
    local w2 = car.wheels[2].position
    local w3 = car.wheels[3].position
    local center = (w0 + w1 + w2 + w3) * 0.25 + downDir * self.down
    -- Derived positioning
    local function getShiftY(level) return 0.54 + (level - 1) * (0.08 / 9) end
    local realCurveFwd  = -0.9 + (self.curveFwd  - 1) * 0.2
    local realCurveRear = -0.9 + (self.curveRear - 1) * 0.2
    local realStepSide  = 0.15 + (self.ledStepSide - 1) * 0.01111
    local realStepFR    = 0.15 + (self.ledStepFR   - 1) * 0.01111
    local sidesCenter   = center + car.up * getShiftY(self.shiftYSides)
    local n = self._count
    local curIdx = 1
    -- FRONT
    local half = (self.frontRearCount + 1) / 2
    for i = 1, self.frontRearCount do
        local off   = (i - half) * realStepFR
        local curve = off * off * realCurveFwd
        self._positions[curIdx] = center + car.up * getShiftY(self.shiftYFwd)
                                  + look * (self.offsetFwd + curve) + side * off
        curIdx = curIdx + 1
    end
    -- RIGHT SIDE
    half = (self.sideCount + 1) / 2
    for i = 1, self.sideCount do
        local off = (half - i) * realStepSide
        self._positions[curIdx] = sidesCenter + side * self.offsetSide + look * off
        curIdx = curIdx + 1
    end
    -- REAR
    half = (self.frontRearCount + 1) / 2
    for i = 1, self.frontRearCount do
        local rev = self.frontRearCount - i + 1
        local off   = (rev - half) * realStepFR
        local curve = off * off * realCurveRear
        self._positions[curIdx] = center + car.up * getShiftY(self.shiftYRear)
                                  - look * (self.offsetRear + curve) + side * off
                                  + downDir * self.downRear
        curIdx = curIdx + 1
    end
    -- LEFT SIDE
    half = (self.sideCount + 1) / 2
    for i = 1, self.sideCount do
        local off = (i - half) * realStepSide
        self._positions[curIdx] = sidesCenter - side * self.offsetSide + look * off
        curIdx = curIdx + 1
    end
    -- Update light positions
    if self.apiOk and #self.lights >= n then
        for i = 1, n do
            self.lights[i].position  = self._positions[i]
            self.lights[i].direction = downDir
        end
    end
    -- Apply animation mode
    if self.mode ~= 'none' and self.apiOk and #self.lights >= n then
        self:applyAnimColors(self.lights, self.mode, self._modeTimer, self.brightness, self._policePhase, car)
    end
end

-- Remote neon management: create/update/destroy lights for other players
function neon:setRemote(ci, enabled, r, g, b, brightness)
    if ci == myCarIndex then return end
    if not enabled then
        -- Turn off
        if self.remotes[ci] then
            for _, light in ipairs(self.remotes[ci].lights) do
                pcall(function() light:dispose() end)
            end
            self.remotes[ci] = nil
        end
        return
    end
    if not self.remotes[ci] then
        self.remotes[ci] = { enabled = true, r = r, g = g, b = b, brightness = brightness, lights = {}, positions = {}, mode = 'none', _modeTimer = 0, _policePhase = false, _baseR = r, _baseG = g, _baseB = b }
    else
        self.remotes[ci].enabled = true
        self.remotes[ci].r = r
        self.remotes[ci].g = g
        self.remotes[ci].b = b
        self.remotes[ci].brightness = brightness
    end
-- Update colors on existing lights (but only if not animated â€” animation overrides per-frame)
    if not self.remotes[ci].mode or self.remotes[ci].mode == 'none' then
        local col = rgb(r * brightness * 3, g * brightness * 3, b * brightness * 3)
        for _, light in ipairs(self.remotes[ci].lights) do
            pcall(function() light.color = col end)
        end
    end
end

function neon:createRemoteLights(ci)
    local rem = self.remotes[ci]
    if not rem or #rem.lights > 0 then return end
    if self.apiOk == false then return end
    local brVal = rem.brightness * 3
    local ok = pcall(function()
        local col = rgb(rem.r * brVal, rem.g * brVal, rem.b * brVal)
        for i = 1, self._REMOTE_COUNT do
            local light = ac.LightSource(ac.LightType.Spot)
            light.range            = 2.5
            light.spot             = 130
            light.spotSharpness    = 0.00
            light.rangeGradientOffset = 0.05
            light.specularMultiplier = 0.05
            light.fadeAt           = 100
            light.fadeSmooth       = 30
            light.showInReflections = true
            light.shadows          = false
            light.singleFrequency  = 0
            light.color            = col
            light.direction        = vec3(0, -1, 0)
            light.position         = vec3(0, -100, 0)
            rem.lights[i] = light
        end
    end)
    if not ok then rem.lights = {} end
    if self.apiOk == nil then self.apiOk = ok end
end

function neon:updateRemotes()
    local mc = ac.getCar(myCarIndex)
    if not mc or not mc.position then return end
    local myPos = mc.position
    -- Cache hot constants as locals (avoids self. table lookups in tight loop)
    local cullSq      = self._CULL_DIST_SQ
    local remCount    = self._REMOTE_COUNT
    local gh          = self._REMOTE_GH
    local offsets     = self._remoteOffsets
    local ldt         = self._lastDt or 0.016
    local myX, myZ    = myPos.x, myPos.z
    -- Reuse module-level constants instead of per-frame allocation
    local downDir     = _C.VEC3_DOWN
    local hidePos     = _C.VEC3_HIDE

    for ci, rem in pairs(self.remotes) do
        if not rem.enabled then goto continue end
        local car = ac.getCar(ci)
        if not car or not car.isConnected then
            for _, light in ipairs(rem.lights) do pcall(function() light:dispose() end) end
            self.remotes[ci] = nil
            goto continue
        end
        local pos = car.position
        if not pos then goto continue end
        -- Distance culling
        local dx, dz = pos.x - myX, pos.z - myZ
        local distSq = dx * dx + dz * dz
        if distSq > cullSq then
            -- Only hide if not already hidden this cull cycle (avoids redundant sets)
            if not rem._culled then
                rem._culled = true
                rem._skipFrame = false
                local remLights = rem.lights
                for i = 1, #remLights do remLights[i].position = hidePos end
            end
            goto continue
        end
        rem._culled = false
        -- Create lights if needed
        if #rem.lights == 0 then self:createRemoteLights(ci) end
        if #rem.lights < remCount then goto continue end
        -- Update positions
        local look = car.look
        local side = car.side
        if not look or not side then goto continue end
        local remLights = rem.lights
        local posX, posY, posZ = pos.x, pos.y, pos.z
        local lookX, lookZ = look.x, look.z
        local sideX, sideZ = side.x, side.z
        local positions = rem.positions
        for i = 1, remCount do
            local o  = offsets[i]
            local px = posX + lookX * o.f + sideX * o.s
            local py = posY + gh
            local pz = posZ + lookZ * o.f + sideZ * o.s
            -- Reuse existing position vec3 or create once
            local p = positions[i]
            if p then
                p.x, p.y, p.z = px, py, pz
            else
                p = vec3(px, py, pz)
                positions[i] = p
            end
            remLights[i].position  = p
            remLights[i].direction = downDir
        end
        -- Apply animation mode for remote car
        local rmode = rem.mode or 'none'
        if rmode ~= 'none' then
            rem._modeTimer = (rem._modeTimer or 0) + ldt
            if rmode == 'police' then
                local tick = math.floor(rem._modeTimer * 4)
                rem._policePhase = (tick % 2 == 0)
            end
            self:applyAnimColors(remLights, rmode, rem._modeTimer, rem.brightness, rem._policePhase, car)
        end
        ::continue::
    end
end

-- Encode neon state for sync: "1|r|g|b|brightness|mode" or "0"
function neon:encodeSyncKey()
    if self.enabled then
        return string.format('1|%.3f|%.3f|%.3f|%.1f|%s', self._baseR, self._baseG, self._baseB, self.brightness, self.mode)
    else
        return '0'
    end
end

function neon:decodeSyncKey(key, ci)
    if key == '0' then
        self:setRemote(ci, false, 0, 0, 0, 0)
    else
        local en, rv, gv, bv, br, md = key:match('(%d)|([%d%.]+)|([%d%.]+)|([%d%.]+)|([%d%.]+)|(%a+)')
        if not en then
            -- Fallback: old format without mode
            en, rv, gv, bv, br = key:match('(%d)|([%d%.]+)|([%d%.]+)|([%d%.]+)|([%d%.]+)')
            md = 'none'
        end
        if en == '1' then
            local rr = tonumber(rv) or 0.12
            local gg = tonumber(gv) or 0.91
            local bb = tonumber(bv) or 0.35
            local brit = tonumber(br) or 3.0
            self:setRemote(ci, true, rr, gg, bb, brit)
            if self.remotes[ci] then
                self.remotes[ci].mode = md or 'none'
                self.remotes[ci]._baseR = rr
                self.remotes[ci]._baseG = gg
                self.remotes[ci]._baseB = bb
            end
        end
    end
end

-- ── FRONT LIGHTS sync encoding ──────────────────────────────────────────
function neon:encodeFrontSyncKey()
    local fl = self.front
    if fl.enabled then
        return string.format('1|%.3f|%.3f|%.3f|%.1f|%s', fl._baseR, fl._baseG, fl._baseB, fl.brightness, fl.mode)
    else
        return '0'
    end
end

function neon:decodeFrontSyncKey(key, ci)
    if key == '0' then
        self:setRemoteFront(ci, false, 0, 0, 0, 0, 'none')
    else
        local en, rv, gv, bv, br, md = key:match('(%d)|([%d%.]+)|([%d%.]+)|([%d%.]+)|([%d%.]+)|(%a+)')
        if en == '1' then
            local rr = tonumber(rv) or 0.12
            local gg = tonumber(gv) or 0.91
            local bb = tonumber(bv) or 0.35
            local brit = tonumber(br) or 5.0
            self:setRemoteFront(ci, true, rr, gg, bb, brit, md or 'none')
        end
    end
end

-- Remote front lights
neon.frontRemotes = {}

function neon:setRemoteFront(ci, enabled, r, g, b, brightness, mode)
    if ci == myCarIndex then return end
    if not enabled then
        if self.frontRemotes[ci] then
            for _, light in ipairs(self.frontRemotes[ci].lights) do
                pcall(function() light:dispose() end)
            end
            self.frontRemotes[ci] = nil
        end
        -- Turn off emissive on remote headlight meshes
        local remHL = self._remoteHlOffsets[ci]
        if remHL and remHL.meshRefs then
            for _, meshRef in ipairs(remHL.meshRefs) do
                pcall(function()
                    meshRef:setMaterialProperty('ksEmissive', 0.0)
                    meshRef:setMaterialProperty('ksDiffuse', 1.0)
                    meshRef:setMaterialProperty('ksAmbient', 0.0)
                end)
            end
        end
        return
    end
    if not self.frontRemotes[ci] then
        self.frontRemotes[ci] = { enabled = true, r = r, g = g, b = b, brightness = brightness, lights = {}, mode = mode or 'none', _modeTimer = 0, _policePhase = false, _baseR = r, _baseG = g, _baseB = b }
    else
        local rem = self.frontRemotes[ci]
        rem.enabled = true; rem.r = r; rem.g = g; rem.b = b; rem.brightness = brightness
        rem.mode = mode or 'none'; rem._baseR = r; rem._baseG = g; rem._baseB = b
        if rem.mode == 'none' then
            local col = rgb(r * brightness, g * brightness, b * brightness)
            for _, light in ipairs(rem.lights) do pcall(function() light.color = col end) end
        end
    end
end

function neon:createRemoteFrontLights(ci)
    local rem = self.frontRemotes[ci]
    if not rem or #rem.lights > 0 then return end
    local ok = pcall(function()
        local col = rgb(rem.r * rem.brightness, rem.g * rem.brightness, rem.b * rem.brightness)
        local fl = self.front
        for i = 1, fl._count do
            local light = ac.LightSource(ac.LightType.Area)
            light.range = 50.0
            light.spot = 55
            light.spotSharpness = 0.5
            light.rangeGradientOffset = 0.05
            light.specularMultiplier = 3.0
            light.fadeAt = 200
            light.fadeSmooth = 50
            light.showInReflections = true
            light.shadows = false
            light.singleFrequency = 0
            light.color = col
            light.direction = vec3(0, 0, 1)
            light.position = vec3(0, -100, 0)
            rem.lights[i] = light
        end
    end)
    if not ok then rem.lights = {} end
end

function neon:updateRemoteFronts()
    local mc = ac.getCar(myCarIndex)
    if not mc or not mc.position then return end
    local myPos = mc.position
    local fl       = self.front
    local cullSq   = self._CULL_DIST_SQ
    local myX, myZ = myPos.x, myPos.z
    local ldt      = self._lastDt or 0.016
    for ci, rem in pairs(self.frontRemotes) do
        if not rem.enabled then goto continue end
        local car = ac.getCar(ci)
        if not car or not car.isConnected then
            for _, light in ipairs(rem.lights) do pcall(function() light:dispose() end) end
            self.frontRemotes[ci] = nil
            goto continue
        end
        local pos = car.position
        if not pos then goto continue end
        local dx, dz = pos.x - myX, pos.z - myZ
        local distSq = dx * dx + dz * dz
        if distSq > cullSq then
            if not rem._culled then
                rem._culled = true
                local remLights = rem.lights
                for i = 1, #remLights do remLights[i].position = _C.VEC3_HIDE end
            end
            goto continue
        end
        rem._culled = false
        if #rem.lights == 0 then self:createRemoteFrontLights(ci) end
        if #rem.lights < fl._count then goto continue end
        -- Discover headlight node positions for this remote car (one-time per ci)
        self:discoverRemoteHeadlightOffsets(ci)
        local look = car.look
        local side = car.side
        if not look or not side then goto continue end
        local remHL = self._remoteHlOffsets[ci]
        for i = 1, fl._count do
            local o = (remHL and remHL[i]) and remHL[i] or fl._offsets[i]
            rem.lights[i].position = pos + side * o.s + look * o.f + vec3(0, o.h, 0)
            rem.lights[i].direction = (look - vec3(0, 0.08, 0)):normalize()
        end
        -- Apply animation for remote front lights
        local rmode = rem.mode or 'none'
        local remHL = self._remoteHlOffsets[ci]
        local remMeshRefs = remHL and remHL.meshRefs or nil
        local emR, emG, emB = rem._baseR, rem._baseG, rem._baseB  -- emissive color tracking
        if rmode ~= 'none' then
            rem._modeTimer = (rem._modeTimer or 0) + (self._lastDt or 0.016)
            -- Use the same animation logic but applied to front lights
            local n = fl._count
            if rmode == 'rainbow' then
                local t = rem._modeTimer
                local hue = (t * 60) % 360
                local rr, gg, bb = self:hsv2rgb(hue, 1, 1)
                local col = rgb(rr * rem.brightness, gg * rem.brightness, bb * rem.brightness)
                for i = 1, n do rem.lights[i].color = col end
                emR, emG, emB = rr, gg, bb
            elseif rmode == 'police' then
                local cycle = math.floor(rem._modeTimer * 2) % 2
                local rr, gg, bb
                if cycle == 0 then rr, gg, bb = 1, 0, 0 else rr, gg, bb = 0, 0, 1 end
                local col = rgb(rr * rem.brightness, gg * rem.brightness, bb * rem.brightness)
                for i = 1, n do rem.lights[i].color = col end
                emR, emG, emB = rr, gg, bb
            elseif rmode == 'strobe' then
                local cycle = rem._modeTimer % 3.0
                local on = false
                if cycle < 0.1 then on = true
                elseif cycle >= 1.0 and cycle < 1.1 then on = true
                elseif cycle >= 1.3 and cycle < 1.4 then on = true
                elseif cycle >= 2.3 and cycle < 2.4 then on = true
                end
                local col
                if on then
                    col = rgb(rem._baseR * rem.brightness, rem._baseG * rem.brightness, rem._baseB * rem.brightness)
                else
                    col = rgb(0, 0, 0)
                    emR, emG, emB = 0, 0, 0
                end
                for i = 1, n do rem.lights[i].color = col end
            elseif rmode == 'wave' then
                local t = rem._modeTimer
                local intensity = (math.sin(t * 3) + 1) / 2
                local col = rgb(rem._baseR * rem.brightness * intensity, rem._baseG * rem.brightness * intensity, rem._baseB * rem.brightness * intensity)
                for i = 1, n do rem.lights[i].color = col end
                emR = rem._baseR * intensity; emG = rem._baseG * intensity; emB = rem._baseB * intensity
            elseif rmode == 'brake' then
                local col = rgb(rem._baseR * rem.brightness, rem._baseG * rem.brightness, rem._baseB * rem.brightness)
                for i = 1, n do rem.lights[i].color = col end
            elseif rmode == 'music' then
                -- Mirror local beat state onto remote front lights (L/R separate)
                local env      = self._beatEnvelope or 0
                local hueShift = self._beatHueShift or 0
                local ldt      = self._lastDt or 0.016
                rem._flBeatSide   = rem._flBeatSide   or 0
                rem._flOnsetTimer = rem._flOnsetTimer  or 0
                if rem._flOnsetTimer > 0 then rem._flOnsetTimer = rem._flOnsetTimer - ldt end
                if self._beatOnset then
                    rem._flBeatSide   = 1 - rem._flBeatSide
                    rem._flOnsetTimer = 0.12
                end
                local h, s, v = self:rgb2hsv(rem._baseR or 1, rem._baseG or 0, rem._baseB or 1)
                h = (h + hueShift) % 360
                s = math.max(s, 0.8); v = math.max(v, 0.6)
                local cr, cg, cb = self:hsv2rgb(h, s, v)
                local baseBr  = rem.brightness * (0.08 + env * 0.92)
                local flashBr = rem.brightness * 1.8
                local lBr, rBr
                if rem._flOnsetTimer > 0 then
                    if rem._flBeatSide == 0 then lBr = flashBr; rBr = baseBr * 0.2
                    else lBr = baseBr * 0.2; rBr = flashBr end
                else lBr = baseBr; rBr = baseBr end
                if rem.lights[1] then rem.lights[1].color = rgb(cr*lBr, cg*lBr, cb*lBr) end
                if rem.lights[2] then rem.lights[2].color = rgb(cr*rBr, cg*rBr, cb*rBr) end
                if rem.lights[3] then rem.lights[3].color = rgb(cr*lBr, cg*lBr, cb*lBr) end
                if rem.lights[4] then rem.lights[4].color = rgb(cr*rBr, cg*rBr, cb*rBr) end
                emR = cr * math.max(lBr, rBr); emG = cg * math.max(lBr, rBr); emB = cb * math.max(lBr, rBr)
            end
        else
            local col = rgb(rem._baseR * rem.brightness, rem._baseG * rem.brightness, rem._baseB * rem.brightness)
            for i = 1, n do rem.lights[i].color = col end
        end
        -- Update emissive on remote headlight meshes
        if remMeshRefs and #remMeshRefs > 0 then
            local isOn = (emR + emG + emB) > 0.01
            local emCol = isOn and rgb(emR * 30.0, emG * 30.0, emB * 30.0) or _C.RGB_BLACK
            local diff  = isOn and 0.0 or 1.0
            local amb   = isOn and 10.0 or 0.0
            for _, meshRef in ipairs(remMeshRefs) do
                meshRef:setMaterialProperty('ksEmissive', emCol)
                meshRef:setMaterialProperty('ksDiffuse', diff)
                meshRef:setMaterialProperty('ksAmbient', amb)
            end
        end
        ::continue::
    end
end

-- Time of day: get current visual time-of-day in seconds since midnight
-- ac.getSim().timeHours already returns visual time (no timezone adjustment needed)
local function getDaySeconds()
    local sim = ac.getSim()
    return (sim.timeHours or 0) * 3600 + (sim.timeMinutes or 0) * 60 + (sim.timeSeconds or 0)
end

