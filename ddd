    --------------------------------------------------------------------------
    -- HIDE VANILLA CHAT WINDOW
    --------------------------------------------------------------------------
    pcall(function()
        local now = CC.clock
        if not chat._vanillaWin then
            if now - (chat._vanillaLastTry or -10) < 3 then return end
            chat._vanillaLastTry = now
            local tryNames = { 'Chat', 'chat', 'AC_CHAT', 'ac_chat', 'CHAT' }
            for _, nm in ipairs(tryNames) do
                local w = ac.accessAppWindow(nm)
                if w and w:valid() then chat._vanillaWin = w; break end
            end
        end
        local w = chat._vanillaWin
        if w and w:valid() and (not chat._vanillaHidden or now >= (chat._vanillaReapplyAt or 0)) then
            w:setVisible(false)
            w:resize(vec2(1, 1))
            w:move(vec2(99999, 99999))
            chat._vanillaHidden = true
            chat._vanillaReapplyAt = now + 5
        end
    end)

    --------------------------------------------------------------------------
    -- CHAT OVERLAY â€” HTML browser-based Discord-style UI
    --------------------------------------------------------------------------
    if iddlStore and iddlStore.showChat == 0 then
        chat.active = false
        chat.browserWantsKbd = false
    end
    pcall(function()
        if iddlStore and iddlStore.showChat == 0 then return end
        local uiState = CC.ui
        local sw = (uiState and uiState.windowSize and uiState.windowSize.x) or 1920
        local sh = (uiState and uiState.windowSize and uiState.windowSize.y) or 1080
        local now = CC.clock
        local chatW = chat.w    -- 420
        local chatH = chat.h    -- 480

        -- Init position bottom-left
        if not chat.pos then
            if iddlStore and iddlStore.chatPosX >= 0 and iddlStore.chatPosY >= 0 then
                chat.pos = vec2(iddlStore.chatPosX, iddlStore.chatPosY)
            else
                chat.pos = vec2(16, sh - chatH - 60)
            end
        end

        -- Clamp chat position to screen bounds (prevents off-screen after resolution change)
        if chat.pos then
            chat.pos.x = math.max(-chatW + 60, math.min(chat.pos.x, sw - 60))
            chat.pos.y = math.max(0, math.min(chat.pos.y, sh - 40))
        end

        -- Update fade for passive mode
        for _, m in ipairs(chat.msgs) do
            local age = now - m.time
            if age > chat.fadeTime then
                m.fade = math.max(0, 1 - (age - chat.fadeTime) / chat.fadeDur)
            else
                m.fade = 1
            end
        end

        -- Chat browser: retry navigate if not ready (infinite retry, every 5s)
        if chat.browser and not chat.browserReady then
            local elapsed = now - (chat._lastNavTime or 0)
            -- Also actively check page title as ready indicator (callbacks may not fire)
            pcall(function()
                local t = chat.browser:title() or ''
                if t == 'IDDLCHAT:ready' then
                    chat.browserReady = true
                    chat._jsReady = true
                    chat._lastSendOk = now
                    chat.initSent = false
                    chat._welcomeSent = false
                end
            end)
            if not chat.browserReady and elapsed > 5.0 then
                chat._navRetries = (chat._navRetries or 0) + 1
                chat._lastNavTime = now
                -- Refresh BASE_URL in case ac.getServerIP() wasn't ready at script load
                local freshUrl = getBaseUrl()
                if freshUrl ~= BASE_URL then BASE_URL = freshUrl; BEAT_BASE = BASE_URL .. '/music' end
                pcall(function() chat.browser:navigate(BASE_URL .. '/iddl/chat.html?r=' .. chat._navRetries) end)
            end
        end

        -- Chat-specific heartbeat: if chat was ready but stopped responding, re-navigate
        -- Timeout raised to 60s — false positives from slow sendAsync callbacks were killing chat
        if chat.browser and chat.browserReady and chat._lastSendOk then
            if now - chat._lastSendOk > 60.0 then
                chat.browserReady = false
                chat._jsReady = false
                chat._lastNavTime = now
                chat._lastSendOk = nil
                chat.initSent = false
                chat._welcomeSent = false
                pcall(function() chat.browser:navigate(BASE_URL .. '/iddl/chat.html?hb=' .. tostring(now):gsub('%.','')) end)
            end
        end

        -- Push init data to chat browser (once) — runs for BOTH sidebar and overlay modes
        if chat.browser and chat.browserReady and not chat.initSent then
            pcall(function()
                chat.browser:sendAsync('chatinit', {
                    myName = ac.getDriverName(myCarIndex) or '',
                    showNotifs = (iddlStore and iddlStore.showChatNotifs or 1),
                    langIn = iddlStore and iddlStore.chatLangIn or 0,
                    langOut = iddlStore and iddlStore.chatLangOut or 0,
                    showOrig = iddlStore and iddlStore.transShowOrig or 0
                }, NOOP)
            end)
            chat.initSent = true

            -- Sync existing messages to browser as single batch (oldest first)
            pcall(function()
                local batch = {}
                for i = #chat.msgs, 1, -1 do
                    local m = chat.msgs[i]
                    local hexCol = '#e8ecf4'
                    if m.color then
                        hexCol = string.format('#%02x%02x%02x',
                            math.floor(math.min(1, m.color.r) * 255),
                            math.floor(math.min(1, m.color.g) * 255),
                            math.floor(math.min(1, m.color.b) * 255))
                    end
                    local dr = _discordRoles[m.name]
                    local av = ''
                    if _serverPlayersCache and _serverPlayersCache[m.name] then
                        av = _serverPlayersCache[m.name].avatar or ''
                    end
                    batch[#batch + 1] = {
                        name = m.name,
                        text = m.text,
                        color = hexCol,
                        isMe = (m.color and m.color.r == C.accent.r and m.color.g == C.accent.g),
                        isMention = m.mention or false,
                        replyTo = m.replyTo,
                        avatar = av,
                        discordRole = dr and dr.role or nil,
                        discordRoleColor = dr and dr.color or nil,
                    }
                end
                if #batch > 0 then
                    chat.browser:sendAsync('msgBatch', batch, NOOP)
                end
            end)

            -- Welcome message (send only once per session)
            if not chat._welcomeSent then
                chat._welcomeSent = true
                pcall(function()
                    local pName = ac.getDriverName(myCarIndex) or 'Driver'
                    chat.browser:sendAsync('sysmsg', {
                        text = 'Welcome to Illegal Drift DL, ' .. pName .. '!',
                        icon = '\240\159\143\129\239\184\143',
                        color = '#a78bfa'
                    }, NOOP)
                    chat.browser:sendAsync('sysmsg', {
                        text = 'Use T to open chat, /help for commands',
                        icon = '\240\159\146\161',
                        color = '#60a5fa'
                    }, NOOP)
                end)
            end
        end

        -- Auto-messages (rotating tips every 5 min)
        if not chat._autoMsgs then
            chat._autoMsgs = {
                { text = 'Join our Discord for events & updates!', icon = '\240\159\142\174', color = '#7c3aed' },
                { text = 'Use @ to mention players in chat', icon = '\240\159\146\172', color = '#60a5fa' },
                { text = 'Press F to give respect during tandem!', icon = '\240\159\148\165', color = '#f59e0b' },
                { text = 'Check settings (gear icon) for chat options', icon = '\226\154\153\239\184\143', color = '#94a3b8' },
                { text = 'Report rammers with /report <name>', icon = '\240\159\155\161\239\184\143', color = '#ef4444' },
            }
            chat._autoMsgIdx = 0
            chat._autoMsgTime = now + 300
        end
        if chat.browser and chat.browserReady and now > chat._autoMsgTime then
            chat._autoMsgTime = now + 300
            chat._autoMsgIdx = (chat._autoMsgIdx % #chat._autoMsgs) + 1
            local tip = chat._autoMsgs[chat._autoMsgIdx]
            pcall(function()
                chat.browser:sendAsync('sysmsg', tip, NOOP)
            end)
        end

        -- Push player list to chat browser (every 2s) — runs for BOTH sidebar and overlay modes
        if chat.browser and chat.browserReady and now - chat.lastPlayerPush > 2 then
            chat.lastPlayerPush = now
            fetchServerPlayersInfo()
            fetchDiscordRoles()
            fetchCrewTags()
            fetchTabPermissions()
            pcall(function()
                local pl = {}
                local localNames = {}
                local sim = CC.sim
                local total = sim.carsCount or 0
                for i = 0, total - 1 do
                    local car = ac.getCar(i)
                    if car and car.isConnected then
                        local pn = ac.getDriverName(i) or ('Car ' .. i)
                        localNames[pn] = true
                        local av = ''
                        if _serverPlayersCache and _serverPlayersCache[pn] then
                            av = _serverPlayersCache[pn].avatar or ''
                        end
                        local dr = _discordRoles[pn]
                        pl[#pl + 1] = { name = pn, idx = i, isMe = (i == myCarIndex), avatar = av,
                            discordRole = dr and dr.role or nil,
                            discordRoleColor = dr and dr.color or nil }
                    end
                end
                -- Add cross-bucket players from server cache
                if _serverPlayersCache then
                    for pn, srv in pairs(_serverPlayersCache) do
                        if not localNames[pn] then
                            local dr = _discordRoles[pn]
                            pl[#pl + 1] = { name = pn, idx = -1, isMe = false, avatar = srv.avatar or '',
                                discordRole = dr and dr.role or nil,
                                discordRoleColor = dr and dr.color or nil }
                        end
                    end
                end
                chat.browser:sendAsync('players', pl, function() chat._lastSendOk = os.clock() end)
            end)
        end

        -- ── Cross-bucket chat polling (every 1s) ──
        if not chat._relaySeq then chat._relaySeq = 0 end
        if not chat._relayPollTime then chat._relayPollTime = 0 end
        if not chat._relayPolling then chat._relayPolling = false end
        if not chat._recentNative then chat._recentNative = {} end
        -- Purge dedup entries older than 15s
        for k, t in pairs(chat._recentNative) do
            if now - t > 15 then chat._recentNative[k] = nil end
        end
        if now - chat._relayPollTime > 1 and not chat._relayPolling then
            chat._relayPollTime = now
            chat._relayPolling = true
            local sinceSeq = chat._relaySeq
            pcall(function()
                web.get(BASE_URL .. '/players/chat-poll?since=' .. tostring(sinceSeq), function(err, resp)
                    chat._relayPolling = false
                    pcall(function()
                    if err or not resp or not resp.body then return end
                    -- Polling succeeded — keep heartbeat alive so it doesn't false-positive timeout
                    chat._lastSendOk = os.clock()
                    local ok, data = pcall(JSON.parse, resp.body)
                    if not ok or type(data) ~= 'table' then return end
                    if data.seq then chat._relaySeq = data.seq end
                    if not data.msgs or #data.msgs == 0 then return end
                    local myName = ac.getDriverName(myCarIndex) or ''
                    for _, m in ipairs(data.msgs) do
                        local mName = m.name or ''
                        -- Skip messages already received via native ac.onChatMessage
                        local dedupKey = mName .. '\t' .. (m.message or '')
                        if chat._recentNative and chat._recentNative[dedupKey] then
                            -- Already shown via native AC chat, skip
                        elseif mName == myName then
                            -- Skip own messages (shown immediately by _relayChatMsg)
                        else
                            local nameCol = C.text
                            local isMention = myName ~= '' and (m.message or ''):lower():find('@' .. myName:lower(), 1, true)
                            -- Parse reply
                            local replyToName = nil
                            local msgBody = m.message or ''
                            local rN, rB = msgBody:match('^↩@(.+) » (.+)$')
                            if rN and rB then replyToName = rN; msgBody = rB end
                            -- Add to chat.msgs
                            table.insert(chat.msgs, 1, {
                                name = mName, text = msgBody, time = os.clock(),
                                color = nameCol, fade = 1,
                                mention = isMention or false, replyTo = replyToName,
                            })
                            while #chat.msgs > chat.maxMsgs do table.remove(chat.msgs) end
                            if isMention then chat.msgs[1].fadeTime = 20 end
                            -- Push to HTML chat browser
                            pcall(function()
                                if chat.browser and chat.browserReady then
                                    local hexCol = '#e8ecf4'
                                    local dr = _discordRoles[mName]
                                    local drc = dr and dr.color or nil
                                    if drc then hexCol = drc end
                                    chat.browser:sendAsync('msg', {
                                        name = mName, text = msgBody, color = hexCol,
                                        isMe = false, isMention = isMention or false,
                                        replyTo = replyToName, avatar = m.avatar or '',
                                        discordRole = dr and dr.role or nil,
                                        discordRoleColor = drc,
                                    }, NOOP)
                                end
                            end)
                        end
                    end
                    end) -- pcall inside chat-poll callback
                end)
            end)
        end

        -- When sidebar chat is registered, skip floating overlay entirely
        if chat.sidebarOk then return end

        -- T key toggle
        if not chat.active and not (BR.wantsKbd and showPanel) and not tutorialActive then
            if ac.isKeyDown(ui.KeyIndex.T) and not chat._tWasDown then
                chat.active = true
                for _, m in ipairs(chat.msgs) do m.time = now end
                -- Tell browser to focus input
                pcall(function()
                    if chat.browser and chat.browserReady then
                        chat.browser:sendAsync('focus', true, NOOP)
                    end
                end)
            end
        end
        chat._tWasDown = ac.isKeyDown(ui.KeyIndex.T)

        -- Check passive visibility
        local hasVisible = false
        if not chat.active then
            for _, m in ipairs(chat.msgs) do
                if m.fade > 0.01 then hasVisible = true; break end
            end
        end

        local myName = ac.getDriverName(myCarIndex) or ''

        -- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
        -- PASSIVE MODE â€” floating messages with glow text (ImGui)
        -- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
        if not chat.active and hasVisible and not (iddlStore and iddlStore.showChatNotifs == 0) then
            local passiveMsgs = {}
            for _, m in ipairs(chat.msgs) do
                if m.fade > 0.01 then
                    passiveMsgs[#passiveMsgs + 1] = m
                    if #passiveMsgs >= 8 then break end
                end
            end
            local lineH = chat.lineH
            local pH = #passiveMsgs * (lineH - 2) + 8
            local pY = chat.pos.y + chatH - pH
            ui.transparentWindow('iddlChatPassive', vec2(chat.pos.x, pY), vec2(chatW, pH), function()
                -- Click on passive messages to open full chat
                if ui.mouseClicked(ui.MouseButton.Left) then
                    local mlp = ui.mouseLocalPos()
                    if mlp.x >= 0 and mlp.x <= chatW and mlp.y >= 0 and mlp.y <= pH then
                        chat.active = true
                        for _, mm in ipairs(chat.msgs) do mm.time = now end
                        pcall(function()
                            if chat.browser and chat.browserReady then
                                chat.browser:sendAsync('focus', true, NOOP)
                            end
                        end)
                    end
                end

                local y = 2
                for i = #passiveMsgs, 1, -1 do
                    local m = passiveMsgs[i]
                    local a = m.fade

                    -- Soft bg pill
                    ui.drawRectFilled(vec2(2, y - 1), vec2(chatW - 2, y + lineH - 5),
                        rgbm(0.02, 0.02, 0.04, 0.55 * a), 6)

                    -- Name
                    ui.pushDWriteFont('Segoe UI;Weight=Bold')
                    local nameT = m.name
                    local nW = ui.measureDWriteText(nameT, 13).x
                    ui.dwriteDrawText(nameT, 13, vec2(11, y + 2), rgbm(0, 0, 0, 0.8 * a))
                    ui.dwriteDrawText(nameT, 13, vec2(10, y + 1), rgbm(m.color.r, m.color.g, m.color.b, a))
                    ui.popDWriteFont()

                    -- Discord role badge (passive)
                    local pdr = _discordRoles[m.name]
                    local roleOffset = 0
                    if pdr and pdr.role then
                        local rn = pdr.role
                        ui.pushDWriteFont('Segoe UI;Weight=Bold')
                        local rnW = ui.measureDWriteText(rn, 9).x
                        local rbW = rnW + 8
                        local rbX = 10 + nW + 5
                        local rbY = y + 3
                        local rbH = 13
                        local rc = rgbm(0.5, 0.5, 0.5, a)
                        if pdr.color and #pdr.color >= 7 then
                            local rr = (tonumber(pdr.color:sub(2, 3), 16) or 128) / 255
                            local gg = (tonumber(pdr.color:sub(4, 5), 16) or 128) / 255
                            local bb = (tonumber(pdr.color:sub(6, 7), 16) or 128) / 255
                            rc = rgbm(rr, gg, bb, a)
                        end
                        ui.drawRectFilled(vec2(rbX, rbY), vec2(rbX + rbW, rbY + rbH),
                            rgbm(rc.r * 0.2, rc.g * 0.2, rc.b * 0.2, 0.7 * a), rbH / 2)
                        local rnMeas = ui.measureDWriteText(rn, 9)
                        ui.dwriteDrawText(rn, 9,
                            vec2(rbX + (rbW - rnMeas.x) / 2, rbY + (rbH - rnMeas.y) / 2), rc)
                        ui.popDWriteFont()
                        roleOffset = rbW + 4
                    end

                    -- Separator dot
                    ui.drawCircleFilled(vec2(10 + nW + roleOffset + 8, y + 10), 2, rgbm(0.4, 0.4, 0.5, 0.5 * a), 8)

                    -- Text (strip [gif]URL[/gif] for passive mode)
                    local displayText = m.text:gsub('%[gif%].-%[/gif%]', '[GIF \u{1F3AC}]')
                    ui.pushDWriteFont('Segoe UI;Weight=Regular')
                    local isMen = myName ~= '' and m.text:lower():find('@' .. myName:lower(), 1, true)
                    local tc = isMen and rgbm(1, 0.82, 0.2, a) or rgbm(0.92, 0.93, 0.97, a)
                    ui.dwriteDrawText(displayText, 13, vec2(11 + nW + roleOffset + 16, y + 2), rgbm(0, 0, 0, 0.8 * a))
                    ui.dwriteDrawText(displayText, 13, vec2(10 + nW + roleOffset + 16, y + 1), tc)
                    ui.popDWriteFont()

                    y = y + lineH - 2
                end
            end)
        end

        -- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
        -- ACTIVE MODE â€” HTML browser chat window
        -- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
        if chat.active and not chat.browser then
            -- Browser creation failed — reset so T key isn't permanently stuck
            chat.active = false
            chat.browserWantsKbd = false
        end

        if chat.active and chat.browser then
            -- Dragging (header area = top 42px)
            local cmp = ui.mousePos()
            local clp = cmp - (chat.pos or vec2(0, 0))
            local cClicked = ui.mouseClicked(ui.MouseButton.Left)
            -- Start drag only in header area but NOT on close/settings buttons (right 60px)
            if cClicked and not chat.dragging and inRect(clp, vec2(0, 0), vec2(chatW - 60, 42)) then
                chat.dragging = true; chat.dragOff = clp:clone()
            end
            if chat.dragging then
                if ui.mouseDown(ui.MouseButton.Left) then
                    chat.pos = cmp - chat.dragOff
                    local _ui = CC.ui
                    local _sw = (_ui and _ui.windowSize and _ui.windowSize.x) or 1920
                    local _sh = (_ui and _ui.windowSize and _ui.windowSize.y) or 1080
                    chat.pos.x = math.max(0, math.min(_sw - chatW, chat.pos.x))
                    chat.pos.y = math.max(0, math.min(_sh - chatH, chat.pos.y))
                else
                    chat.dragging = false
                    if iddlStore then iddlStore.chatPosX = chat.pos.x; iddlStore.chatPosY = chat.pos.y end
                end
            end

            ui.transparentWindow('iddlChatBrowser', chat.pos, vec2(chatW, chatH), function()
                chat.browser:draw(vec2(0, 0), vec2(chatW, chatH), true)

                if not chat.dragging then
                    local uis = CC.ui
                    local mlp = ui.mouseLocalPos()
                    local mouseNorm = vec2(mlp.x / chatW, mlp.y / chatH)
                    local btns = {
                        uis.isMouseLeftKeyDown,
                        uis.isMouseRightKeyDown,
                        uis.isMouseMiddleKeyDown
                    }
                    chat.browser:mouseInput(mouseNorm, btns, uis.mouseWheel)
                end
                chat.browser:focus(true)
                ui.setMouseCursor(chat.browser:mouseCursor())

                local kbState = ui.captureKeyboard(true, true)
                if kbState then
                    chat.browser:keyboard(kbState)
                end
            end)

            -- Click outside chat window to close
            if cClicked and not chat.dragging and not inRect(clp, vec2(0, 0), vec2(chatW, chatH)) then
                chat.active = false
                chat.browserWantsKbd = false
                chat.dragging = false
                pcall(function() chat.browser:sendAsync('blur', true, NOOP) end)
            end

            -- Escape to close (Lua fallback)
            if ac.isKeyDown(ui.KeyIndex.Escape) then
                chat.active = false
                chat.browserWantsKbd = false
                chat.dragging = false
                pcall(function() chat.browser:sendAsync('blur', true, NOOP) end)
            end
        end

        -- Hint
        if not chat.active and not hasVisible then
            ui.transparentWindow('iddlChatHint', vec2((chat.pos or vec2(16, sh - 100)).x,
                (chat.pos or vec2(16, sh - 100)).y + chatH - 16), vec2(140, 16), function()
                ui.pushDWriteFont('Segoe UI;Weight=Regular')
                ui.dwriteDrawText('Press T to chat', 10, vec2(4, 0), rgbm(0.45, 0.45, 0.52, 0.3))
                ui.popDWriteFont()
            end)
        end
    end)

    --------------------------------------------------------------------------
    -- NORMAL MENU PANEL (only when not in tutorial)
    --------------------------------------------------------------------------
    if not tutorialActive then
    -- Panel open/close animation
    if showPanel then
        panelAlpha = lerp(panelAlpha, 1, dt * 8)
        if panelAlpha > 0.99 then panelAlpha = 1 end
    else
        panelAlpha = lerp(panelAlpha, 0, dt * 8)
        if panelAlpha < 0.01 then panelAlpha = 0 end
    end
    if panelAlpha >= 0.01 then

    -- Init position (restore from storage if available)
    if not panelPos then
        if iddlStore and iddlStore.menuPosX >= 0 and iddlStore.menuPosY >= 0 then
            panelPos = vec2(iddlStore.menuPosX, iddlStore.menuPosY)
        else
            local s = CC.sim
            panelPos = vec2(40, (s.windowHeight - panelSize.y) / 2)
        end
    end

    -- Animated position (slide from left)
    local slideOffset = (1 - panelAlpha) * -30
    local drawPos = vec2(panelPos.x + slideOffset, panelPos.y)

    -- Dragging (header area = top 56px)
    local mp = ui.mousePos()
    local lp = mp - drawPos
    local clicked = ui.mouseClicked(ui.MouseButton.Left)
    if clicked and not panelDragging and inRect(lp, vec2(0, 0), vec2(panelSize.x - 40, 56)) then
        panelDragging = true; panelDragOff = lp:clone()
    end
    if panelDragging then
        if ui.mouseDown(ui.MouseButton.Left) then
            panelPos = mp - panelDragOff - vec2(slideOffset, 0)
            local _ui = CC.ui
            local _sw = (_ui and _ui.windowSize and _ui.windowSize.x) or 1920
            local _sh = (_ui and _ui.windowSize and _ui.windowSize.y) or 1080
            panelPos.x = math.max(0, math.min(_sw - panelSize.x, panelPos.x))
            panelPos.y = math.max(0, math.min(_sh - panelSize.y, panelPos.y))
        else
            panelDragging = false
            if iddlStore then iddlStore.menuPosX = panelPos.x; iddlStore.menuPosY = panelPos.y end
        end
    end

    -- Render WebBrowser
    if browser then
        ui.transparentWindow('iddlMenu', drawPos, panelSize, function()
            -- Draw first so _alive gets set for mouseInput
            browser:draw(vec2(0, 0), panelSize, true)

            -- Manual mouse + keyboard input
            if not panelDragging then
                local uis = CC.ui
                local mlp = ui.mouseLocalPos()
                local mouseNorm = vec2(mlp.x / panelSize.x, mlp.y / panelSize.y)
                local btns = {
                    uis.isMouseLeftKeyDown,
                    uis.isMouseRightKeyDown,
                    uis.isMouseMiddleKeyDown
                }
                browser:mouseInput(mouseNorm, btns, uis.mouseWheel)
                browser:focus(true)
                ui.setMouseCursor(browser:mouseCursor())

                -- ESC closes the panel (always works, even with keyboard capture)
                if ac.isKeyDown(ui.KeyIndex.Escape) then
                    showPanel = false
                    BR.wantsKbd = false
                end

                -- Only capture keyboard when browser has a text input focused
                -- This allows camera keys, ESC, etc. to work normally
                if BR.wantsKbd then
                    local kbState = ui.captureKeyboard(true, true)
                    if kbState then
                        browser:keyboard(kbState)
                    end
                end
            end
        end)
    end

    end -- panelAlpha >= 0.01

    end -- not tutorialActive

    -- Invite popup browser — center-top of screen, always visible (independent of menu)
    if INV.show and INV.browser then
        local sw = CC.sim.windowWidth or 1920
        local invPos = vec2((sw - INV.size.x) / 2, 20)
        ui.transparentWindow('iddlInvite', invPos, INV.size, function()
            INV.browser:draw(vec2(0, 0), INV.size, true)
            local uis = CC.ui
            local mlp = ui.mouseLocalPos()
            local mouseNorm = vec2(mlp.x / INV.size.x, mlp.y / INV.size.y)
            local btns = { uis.isMouseLeftKeyDown, uis.isMouseRightKeyDown, uis.isMouseMiddleKeyDown }
            INV.browser:mouseInput(mouseNorm, btns, uis.mouseWheel)
            ui.setMouseCursor(INV.browser:mouseCursor())
        end)
    end

    -- Push data to browser
    -- Re-navigate browser if JS 'ready' signal hasn't arrived (page failed to load, e.g. server HTTP not ready yet)
    if not BR._jsReady and browser and BR._navRetries < 12 then
        local elapsed = CC.clock - BR._lastNavTime
        -- First retry after 4s, then every 3s (up to 12 retries = ~40s total)
        local retryAfter = (BR._navRetries == 0) and 4.0 or 3.0
        if elapsed > retryAfter then
            BR._navRetries = BR._navRetries + 1
            BR._lastNavTime = CC.clock
            BR.ready = false
            -- Refresh BASE_URL in case ac.getServerIP() wasn't ready at script load
            local freshUrl = getBaseUrl()
            if freshUrl ~= BASE_URL then BASE_URL = freshUrl; BEAT_BASE = BASE_URL .. '/music' end
            pcall(function()
                browser:navigate(BASE_URL .. '/iddl/index.html?v=' .. tostring(os.clock()):gsub('%.', ''))
            end)
            -- HUD browsers only retry if they haven't loaded yet (chat has its own retry system)
            if _driftHudBrowser and not _driftHudReady then
                pcall(function()
                    _driftHudBrowser:navigate(BASE_URL .. '/iddl/drift_hud.html?v=' .. tostring(os.clock()):gsub('%.', ''))
                end)
            end
            if _angleBrowser and not _angleReady then
                pcall(function()
                    _angleBrowser:navigate(BASE_URL .. '/iddl/angle_hud.html?v=' .. tostring(os.clock()):gsub('%.', ''))
                end)
            end
            if _speedoBrowser and not _speedoReady then
                pcall(function()
                    _speedoBrowser:navigate(BASE_URL .. '/iddl/speedo_hud.html?v=' .. tostring(os.clock()):gsub('%.', ''))
                end)
            end
            if _lbHudBrowser and not _lbHudReady then
                pcall(function()
                    _lbHudBrowser:navigate(BASE_URL .. '/iddl/lb_hud.html?v=' .. tostring(os.clock()):gsub('%.', ''))
                end)
            end
        end
    end
    -- Fallback: force BR.ready after 3s from last navigation (so data pushes can start)
    if not BR.ready and browser and (CC.clock - BR._lastNavTime > 3.0) then
        BR.ready = true
    end

    -- Heartbeat recovery: if HUD browser was ready but sendAsync stopped completing, re-navigate it
    -- This catches mid-session freezes (browser JS context became unresponsive)
    local _hbTimeout = 10.0
    -- Menu browser heartbeat (15s timeout since it sends at lower rate when menu is closed)
    if BR.acked and browser and BR._lastTickOk then
        if CC.clock - BR._lastTickOk > 15.0 then
            BR._jsReady = false
            BR.ready = false
            BR.acked = false
            BR.initSent = false
            BR.skinsSent = false
            BR.mapsSent = false
            BR.defsSent = false
            BR._navRetries = 0
            BR._lastNavTime = CC.clock
            BR._lastTickOk = nil
            pcall(function()
                browser:navigate(BASE_URL .. '/iddl/index.html?v=' .. tostring(os.clock()):gsub('%.', ''))
            end)
        end
    end
    if _driftHudBrowser and _driftHudReady and _driftHudLastOk then
        if CC.clock - _driftHudLastOk > _hbTimeout then
            _driftHudReady = false
            _driftHudNavTime = CC.clock
            _driftHudLastOk = nil
            pcall(function()
                _driftHudBrowser:navigate(BASE_URL .. '/iddl/drift_hud.html?v=' .. tostring(os.clock()):gsub('%.', ''))
            end)
        end
    end
    if _angleBrowser and _angleReady and _angleLastOk then
        if CC.clock - _angleLastOk > _hbTimeout then
            _angleReady = false
            _angleNavTime = CC.clock
            _angleLastOk = nil
            pcall(function()
                _angleBrowser:navigate(BASE_URL .. '/iddl/angle_hud.html?v=' .. tostring(os.clock()):gsub('%.', ''))
            end)
        end
    end
    if _speedoBrowser and _speedoReady and _speedoLastOk then
        if CC.clock - _speedoLastOk > _hbTimeout then
            _speedoReady = false
            _speedoNavTime = CC.clock
            _speedoLastOk = nil
            pcall(function()
                _speedoBrowser:navigate(BASE_URL .. '/iddl/speedo_hud.html?v=' .. tostring(os.clock()):gsub('%.', ''))
            end)
        end
    end
    if _lbHudBrowser and _lbHudReady and _lbHudLastOk then
        if CC.clock - _lbHudLastOk > _hbTimeout then
            _lbHudReady = false
            _lbHudNavTime = CC.clock
            _lbHudLastOk = nil
            pcall(function()
                _lbHudBrowser:navigate(BASE_URL .. '/iddl/lb_hud.html?v=' .. tostring(os.clock()):gsub('%.', ''))
            end)
        end
    end

    if BR.ready and browser then
        local now = CC.clock

        -- Retry all pushes every 2s until JS confirms receipt (ack-init)
        if not BR.acked and (now - BR.lastRetry > 2.0) then
            BR.lastRetry = now
            BR.initSent = false
            BR.skinsSent = false
            BR.mapsSent = false
            BR.defsSent = false
        end

        -- Init data (carId, sync state)
        if not BR.initSent then
            pushInitToBrowser()
        end

        -- Skins
        if not BR.skinsSent and BR.initSent then
            pushSkinsToBrowser()
            pushCarsListToBrowser()
            BR.skinsSent = true
        end

        -- Maps
        if not BR.mapsSent and BR.initSent then
            pushMapsToBrowser()
            BR.mapsSent = true
        end

        -- Tab permissions (fetch + push when loaded)
        if BR.initSent then
            fetchTabPermissions()
            if BR._tpLastHash ~= '' and not BR.tabPermsSent then
                pushTabPermsToBrowser()
                BR.tabPermsSent = true
            end
        end

        -- Crew data (initial + periodic refresh)
        if BR.initSent then
            local now = os.clock()
            if now - crewData.lastFetch >= crewData.fetchInterval then
                pushCrewToBrowser()
            end
        end

        -- Defs + equipped (wait for HTTP fetch to complete)
        if BR.initSent and defsLoaded and categoriesBuilt and not BR.defsSent then
            pushDefsToBrowser()
            pushEquippedToBrowser()
            pushPresetsToBrowser()
            BR.defsSent = true
        end

        -- If defs fetch errored, still mark as sent
        if BR.initSent and defsLoaded and defsError and not BR.defsSent then
            pcall(function() browser:sendAsync('notify', 'Parts unavailable', NOOP) end)
            BR.defsSent = true
        end

        -- Tick data at ~10Hz (was 20Hz â€” reduced for scroll perf)
        if now - BR.lastTick > 0.1 then
            BR.lastTick = now
            -- Detect current map based on position (every ~2s)
            mapDetectTimer = mapDetectTimer + dt
            if mapDetectTimer > 2 then
                mapDetectTimer = 0
                local car = ac.getCar(myCarIndex)
                if car then
                    detectCurrentMap(car)
                    countPlayersPerMap()
                end
            end
            BR._tickTimer = (BR._tickTimer or 0) + dt
            BR._tickFull = (BR._tickFull or 0) + dt
            if BR._tickTimer >= 0.1 then
                BR._tickTimer = 0
                -- Full tick only when menu/tutorial open (skip expensive JSON serialize otherwise)
                local fullTick = false
                if (showPanel or tutorialActive) and BR._tickFull >= 0.2 then
                    fullTick = true
                    BR._tickFull = 0
                elseif BR._tickFull >= 1.0 then
                    -- Slow background full tick (1Hz) to keep state roughly current
                    fullTick = true
                    BR._tickFull = 0
                end
                pushTickToBrowser(fullTick)
            end
        end

        -- Players at ~2Hz
        if now - BR.lastPlayers > 0.5 then
            BR.lastPlayers = now
            pushPlayersToBrowser()
        end

        -- Invite polling (~5s)
        if now - INV.lastPoll > 5 then
            INV.lastPoll = now
            pcall(function()
                local sid = 0
                pcall(function() sid = ac.getCar(myCarIndex).sessionID or 0 end)
                web.get(BASE_URL .. '/lobby/invites?sessionId=' .. tostring(sid), function(err, resp)
                    if err or not resp or not resp.body then return end
                    local ok, data = pcall(JSON.parse, resp.body)
                    if ok and data and data.hasInvite then
                        if not INV.show then
                            INV.pendingInvite = data
                            INV.show = true
                            if INV.browser and INV.ready then
                                INV.browser:sendAsync('invite', {
                                    inviterName = data.inviterName,
                                    bucketName = data.bucketName,
                                    secondsLeft = 60,
                                    sessionId = sid,
                                    apiBase = BASE_URL,
                                }, NOOP)
                            end
                        end
                    end
                end)
            end)
        end
    end

end

function script.update(dt)
    dt = dt or 0.016
    -- Throttle gamepad scan to every 3 frames (~50ms @ 60fps) — ac.isGamepadButtonPressed is very slow
    _gpCacheFrame = _gpCacheFrame + 1
    if _gpCacheFrame >= 3 then
        _gpCacheFrame = 0
        _refreshGpCache()
    end
    local myCar = ac.getCar(myCarIndex)

    -- Pit override: AC's built-in pit teleport always goes to map 1 (Englishtown).
    -- Detect isInPit rising edge BEFORE rendering and re-teleport to correct map.
    pcall(function()
        local car = myCar
        if car then
            local inPit = car.isInPit or false
            if inPit and not _pitOverride.wasInPit then
                -- Wipe drift score on pit reset
                if drift then
                    drift.currentScore = 0
                    drift.displayScore = 0
                    drift.displayBonus = 0
                    drift.bonusScore = 0
                    drift._peakDisplay = 0
                    drift._peakBonus = 0
                    drift.combo = 1
                    drift.comboReached = 0
                    drift.inDrift = false
                    drift.spinDetected = false
                    drift._spinTimer = 0
                end
                local mi = _pitOverride.mapBefore
                if mi > 1 and mi <= #mapLocations then
                    local m = mapLocations[mi]
                    currentMapIdx = mi
                    doTeleport(m.pos, m.dir, 'Teleported to ' .. m.name .. ' pits')
                    -- Bucket re-assignment is server-side (MapBucketAssigner scans positions)
                end
            end
            _pitOverride.wasInPit = inPit
            if not inPit then
                _pitOverride.mapBefore = currentMapIdx
            end
        end
    end)

    -- Re-navigate browsers after BASE_URL localhost fallback
    if IDDL_CFG._browserReload then
        IDDL_CFG._browserReload = false
        pcall(function()
            if browser then browser:navigate(BASE_URL .. '/iddl/index.html?v=' .. tostring(os.clock()):gsub('%.', '')) end
        end)
        pcall(function()
            if chat and chat.browser then
                chat.browserReady = false
                chat._jsReady = false
                chat._lastNavTime = os.clock()
                chat.initSent = false
                chat._welcomeSent = false
                chat.browser:navigate(BASE_URL .. '/iddl/chat.html')
            end
        end)
    end

    -- Control Lock: camera while menu is open (no brake – allow driving with menu)
    local menuOpen = showPanel or tutorialActive
    if menuOpen and not _menuLock.active then
        _menuLock.active = true
        if not tuningCam.active and not walk.active and not _menuLock.cam then
            pcall(function() _menuLock.cam = ac.grabCamera('IDDL Menu Lock') end)
        end
    elseif not menuOpen and _menuLock.active then
        _menuLock.active = false
        if _menuLock.cam then
            pcall(function() _menuLock.cam:dispose() end)
            _menuLock.cam = nil
        end
    end
    -- Keep menu-lock camera passthrough (grab prevents camera mode switching)
    if _menuLock.cam then
        pcall(function()
            if _menuLock.cam:active() then
                _menuLock.cam.ownShare = 0
            else
                _menuLock.cam = nil
            end
        end)
    end

    -- Cache per-frame values
    CC.clock = os.clock()
    CC.sim = ac.getSim()


    -- Music player retry: delayed play() call after source is set
    if MUS.playRetryTimer > 0 then
        MUS.playRetryTimer = MUS.playRetryTimer - dt
        if MUS.playRetryTimer <= 0 then
            MUS.playRetryTimer = 0
            pcall(function()
                if MUS.player and MUS.playing then
                    MUS.player:play()
                    -- Probe time/duration (property first, method fallback)
                    local ct = tonumber(MUS.player.currentTime) or 0
                    if ct == 0 then
                        local ok, v = pcall(MUS.player.currentTime, MUS.player)
                        if ok then ct = tonumber(v) or 0 end
                    end
                    local dr = tonumber(MUS.player.duration) or 0
                    if dr == 0 then
                        local ok, v = pcall(MUS.player.duration, MUS.player)
                        if ok then dr = tonumber(v) or 0 end
                    end
                    if MUS.knownDuration <= 0 and dr > 10 then
                        MUS.knownDuration = dr
                    end
                end
            end)
        end
    end

    -- Track end grace timer
    if MUS.trackEndGrace > 0 then
        MUS.trackEndGrace = MUS.trackEndGrace - dt
    end

    -- Increment elapsed timer when music is playing
    if MUS.playing and not MUS.paused then
        MUS.elapsed = MUS.elapsed + dt
        -- If we still don't know the duration, probe MediaPlayer every ~2s
        if MUS.knownDuration <= 0 and MUS.player and math.floor(MUS.elapsed * 2) ~= math.floor((MUS.elapsed - dt) * 2) then
            pcall(function()
                local dr = tonumber(MUS.player.duration) or 0
                if dr > 10 then
                    MUS.knownDuration = dr
                end
            end)
        end
    end

    -- Auto-play next track from playlist when current track ends
    if MUS.playing and not MUS.paused and MUS.trackEndGrace <= 0 then
        pcall(function()
            local trackEnded = false

            -- Primary method: elapsed time >= known duration from YouTube API
            if MUS.knownDuration > 10 and MUS.elapsed >= MUS.knownDuration then
                trackEnded = true
            end

            -- Fallback: if no known duration, use a generous maximum (10 min)
            if MUS.knownDuration <= 10 and MUS.elapsed > 600 then
                trackEnded = true
            end

            if trackEnded then
                MUS.stallTimer = 0
                MUS.lastTime = -1
                if MUS.activePlaylist >= 0 then
                    local pl = MUS.playlists[MUS.activePlaylist + 1]
                    if pl and pl.tracks then
                        local nextIdx = MUS.activeTrackIdx + 1
                        if nextIdx < #pl.tracks then
                            -- Play next track
                            MUS.activeTrackIdx = nextIdx
                            local t = pl.tracks[nextIdx + 1]
                            notify('Next: ' .. t.title)
                            MUS.playFn(t)
                        else
                            -- End of playlist, stop
                            MUS.activePlaylist = -1
                            MUS.activeTrackIdx = -1
                            MUS.stopFn()
                            notify('Playlist ended')
                        end
                    else
                        MUS.stopFn()
                    end
                else
                    -- Not from playlist, just stop
                    MUS.stopFn()
                end
            end
        end)
    end

    -- Process one deferred placement per frame (KN5 same-file fix)
    if #deferredPlacementOps > 0 then
        local op = table.remove(deferredPlacementOps, 1)
        if op then pcall(op) end
    end

    -- Cleanup: unequip parts + caches from disconnected remote cars (every ~3s)
    pcall(function()
        if not _cleanupTimer then _cleanupTimer = 0 end
        _cleanupTimer = _cleanupTimer + dt
        if _cleanupTimer > 3 then
            _cleanupTimer = 0
            for ci, carEq in pairs(equippedPerCar) do
                if ci ~= myCarIndex then
                    local c = ac.getCar(ci)
                    if not c or not c.isConnected then
                        for mk in pairs(carEq) do unequipMod(mk, ci) end
                        equippedPerCar[ci] = nil
                        -- Clean up caches that leak per disconnected car
                        if _nametagLastData then _nametagLastData[ci] = nil end
                        if _animNodeCache then _animNodeCache[ci] = nil end
                        if _remoteDefsCache then
                            local tid = ac.getCarID(ci)
                            if tid then _remoteDefsCache[tid] = nil end
                        end
                        equippedByCatPerCar[ci] = nil
                        skinPerCar[ci] = nil
                        colorPerCar[ci] = nil
                        rimColorPerCar[ci] = nil
                        rimColorFrontPerCar[ci] = nil
                        rimColorRearPerCar[ci] = nil
                        -- Clean up remote smoke + neon
                        if smokeColor.remotes[ci] then smokeColor.remotes[ci] = nil end
                        if smokeColor._remoteFade[ci] then smokeColor._remoteFade[ci] = nil end
                        if neon.remotes and neon.remotes[ci] then neon.remotes[ci] = nil end
                    end
                end
            end
        end
    end)

    -- Process deferred equip queue (remote cars whose model wasn't ready yet)
    if #deferredEquipQueue > 0 then
        local now = os.clock()
        local i = 1
        while i <= #deferredEquipQueue do
            local dq = deferredEquipQueue[i]
            if now >= dq.nextRetry then
                dq.retries = dq.retries + 1
                if dq.retries > 120 then
                    table.remove(deferredEquipQueue, i)
                else
                    -- Check if all attach nodes are ready before equipping
                    local cr = getCarRoot(dq.ci)
                    local ready = false
                    local remoteDefs = getDefsForCar(dq.ci)
                    local md = remoteDefs and remoteDefs[dq.mk]
                    if not md then md = definitions and definitions[dq.mk] end
                    if cr and #cr > 0 then
                        ready = true
                        if md and md.placements then
                            for _, pd in ipairs(md.placements) do
                                if pd.attachNode and pd.attachNode ~= '' then
                                    local nr = cr:findNodes(pd.attachNode)
                                    if not nr or #nr == 0 then ready = false; break end
                                end
                            end
                        end
                    end
                    if ready then
                        table.remove(deferredEquipQueue, i)
                        equipMod(dq.mk, dq.ci, remoteDefs)
                    else
                        dq.nextRetry = now + 0.2
                        i = i + 1
                    end
                end
            else
                i = i + 1
            end
        end
    end

    -- Process pending sync equips (remote defs fetched but equipMod not callable from web.get callback)
    if #_pendingSyncEquips > 0 then
        local remaining = {}
        for _, p in ipairs(_pendingSyncEquips) do
            -- Drop entries for disconnected cars (prevents unbounded growth)
            local pCar = ac.getCar(p.ci)
            if not pCar or not pCar.isConnected then
                -- car left — discard
            else
                local remoteDefs = getDefsForCar(p.ci)
                if remoteDefs then
                    local md = remoteDefs[p.mk]
                    if md then
                        pcall(equipMod, p.mk, p.ci, remoteDefs)
                    end
                    -- Either equipped or no such mod — drop from queue
                else
                    -- Defs still loading — keep in queue
                    remaining[#remaining + 1] = p
                end
            end
        end
        _pendingSyncEquips = remaining
    end

    -- Update transforms and animations (pcall to protect script.update from dying)
    pcall(updateTransforms)
    pcall(updateAnimations, dt)

    -- Update tuning camera (Forza-style part focus)
    pcall(updateTuningCam, dt)

    -- Update walking camera
    pcall(updateWalkingCamera, dt)

    -- Flashlight toggle (F key) while walking
    pcall(function()
        if walk.active then
            local fDown = ac.isKeyDown(ac.KeyIndex.F)
            if fDown and not walk._fWasDown then
                walk.flashlight = not walk.flashlight
                notify(walk.flashlight and 'Flashlight ON' or 'Flashlight OFF')
            end
            walk._fWasDown = fDown
        end
    end)

    -- Update drift scoring (pcall — a crash here killed the ENTIRE script including chat)
    pcall(updateDrift, dt, myCar)

    -- Copy drift and RPM data used by neon modes
    neon._driftAngle = drift.angle or 0
    neon._driftSpeed = drift.speed or 0
    if myCar then
        neon._rpm = myCar.rpm or 0
        neon._rpmMax = myCar.rpmLimiter or 8000
    end
    -- Music beat sync: poll Python beat_server.py on localhost:7842 every 50ms
    -- Fallback to synthetic 128 BPM if server not responding
    if neon.mode == 'music' or neon.mode == 'music_rainbow' or neon.mode == 'music_complement' or neon.mode == 'music_sparkle' or neon.mode == 'music_split'
    or neon.front.mode == 'music' or neon.front.mode == 'music_rainbow' or neon.front.mode == 'music_complement' or neon.front.mode == 'music_sparkle' or neon.front.mode == 'music_split' then
        neon._beatPollTimer = (neon._beatPollTimer or 0) + dt
        if neon._beatPollTimer >= 0.1 then
            neon._beatPollTimer = 0
            local pollOk, _ = pcall(function()
                web.get(BEAT_BASE .. '/beat', function(err, resp)
                    pcall(function()
                        if err or not resp or not resp.body then
                            neon._beatServerOk = false
                            return
                        end
                        local ok, data = pcall(JSON.parse, resp.body)
                        if not ok or type(data) ~= 'table' then return end
                        local env  = tonumber(data.envelope) or 0
                        local peak = tonumber(data.peak)     or 0
                        local onset = data.onset == true
                        neon._beatEnvelope = env
                        neon._beatPeak     = peak
                        if onset then
                            neon._beatOnset = true
                            neon._beatHueShift = ((neon._beatHueShift or 0) + 40) % 360
                        else
                            neon._beatOnset = false
                        end
                        neon._beatServerOk     = true
                        neon._beatServerLastOk = os.clock()
                    end)
                end)
            end)
        end
    end
    -- Update neon animation timer & police phase
    neon._modeTimer = neon._modeTimer + dt
    neon._lastDt = dt
    if neon.mode == 'police' then
        local tick = math.floor(neon._modeTimer * 4)
        neon._policePhase = (tick % 2 == 0)
    end
    -- Update underglow neon lights (own + remote players)
    pcall(function()
        neon:update(myCar)
        neon:updateRemotes()
    end)

    -- NOS purge smoke (U key hold)
    do
        -- Pass BR/showPanel/chat/syncEvent state into purge table (purge.update is defined before these locals)
        purge._brWantsKbd = BR.wantsKbd
        purge._showPanel = showPanel
        purge._chatActive = chat.active
        purge._syncEvent = syncEvent
        local pOk, pErr = pcall(function() purge.update(myCar) end)
        if not pOk then end
    end
    -- Keep remote purge emitters alive (they emit only when active from sync)
    pcall(function()
        for ci, rem in pairs(purge.remotes) do
            if rem.active and rem.smoke then
                local c = ac.getCar(ci)
                if c and c.bodyTransform then
                    local wL = purge.toWorld(c, purge.leftPos)
                    local wR = purge.toWorld(c, purge.rightPos)
                    local vL = purge.dirToWorld(c, purge.leftVel)
                    local vR = purge.dirToWorld(c, purge.rightVel)
                    rem.smoke:emit(wL, vL, purge.quantity)
                    rem.smoke:emit(wR, vR, purge.quantity)
                end
            end
        end
    end)

    -- Tire smoke color emission (local car + remote cars)
    pcall(function()
        if smokeColor.enabled and smokeColor.smoke then
            -- Apply smoke mode animation (rainbow, police, etc.)
            smokeColor:applyMode(dt)
            -- Suppress default rear tire smoke; use surfaceHeat when tires are hot
            local wheels = myCar.wheels
            for wi = 2, 3 do
                local w = wheels and wheels[wi]
                local sHeat = 0
                if w then
                    local coreT = w.tyreCoreTemperature or 80
                    local optT = w.tyreOptimumTemperature or 85
                    if coreT > optT then
                        sHeat = math.min(1, (coreT - optT) / (optT * 0.5))
                    end
                end
                pcall(function() ac.overrideTyreSmoke(wi, 0, 0, sHeat) end)
            end
            smokeColor:emitForCar(myCar, myCarIndex, dt)
        else
            -- Even if local smoke disabled, update remote mode animations
            smokeColor._modeTimer = smokeColor._modeTimer + dt
        end
        -- Apply remote mode animations (runs regardless of local smoke state)
        pcall(function()
            local t = smokeColor._modeTimer
            for ci, rem in pairs(smokeColor.remotes) do
                if rem.smoke and rem.mode and rem.mode ~= 'none' then
                    local r, g, b = rem.r, rem.g, rem.b
                    if rem.mode == 'rainbow' then
                        local hue = (t * 90) % 360
                        r, g, b = smokeColor:hsv2rgb(hue, 1, 1)
                    elseif rem.mode == 'police' then
                        local cycle = math.floor(t * 3) % 2
                        if cycle == 0 then r, g, b = 1, 0, 0 else r, g, b = 0, 0, 1 end
                    elseif rem.mode == 'drift' then
                        local rc = ac.getCar(ci)
                        local rspd = rc and math.abs(rc.speedKmh or 0) or 0
                        local hue = math.max(0, 120 - rspd * 0.8)
                        r, g, b = smokeColor:hsv2rgb(hue, 1, 1)
                    elseif rem.mode == 'breathing' then
                        local pulse = (math.sin(t * 2) + 1) * 0.5
                        r = rem.r * (0.3 + 0.7 * pulse)
                        g = rem.g * (0.3 + 0.7 * pulse)
                        b = rem.b * (0.3 + 0.7 * pulse)
                    elseif rem.mode == 'strobe' then
                        local on = math.floor(t * 8) % 2 == 0
                        if not on then r, g, b = 0, 0, 0 end
                    end
                    pcall(function() rem.smoke.color = rgbm(r, g, b, smokeColor._alpha) end)
                end
            end
        end)
        -- Emit for remote cars with custom smoke
        for ci, rem in pairs(smokeColor.remotes) do
            if rem.smoke then
                local c = ac.getCar(ci)
                if c and c.isConnected then
                    smokeColor:emitForCar(c, ci, dt)
                end
            end
        end
    end)

    -- Enforce ghost local visibility (if user hid it, keep it hidden each frame)
    if not ghostUI.localVisible then
        pcall(function()
            if not ghostUI._cachedNodes then
                ghostUI._cachedNodes = ac.findNodes('TG_ServerGhost')
            end
            local gn = ghostUI._cachedNodes
            if gn and #gn > 0 then gn:setVisible(false) end
        end)
    end

    -- Auto-follow car headlights: when headlights ON -> front lights ON, OFF -> OFF
    pcall(function()
        local fl = neon.front
        local car = myCar
        local hlOn = car and car.headlightsActive or false
        if hlOn and not fl._prevHeadlights then
            -- Headlights just turned ON → enable front lights
            if not fl.enabled then
                fl.enabled = true
                neon:createFront()
                neon:updateFrontColors()
                neon:saveFront()
                if syncEvent then pcall(function() syncEvent({ action = 14, key = neon:encodeFrontSyncKey() }) end) end
            end
        elseif not hlOn and fl._prevHeadlights then
            -- Headlights just turned OFF → disable front lights
            if fl.enabled then
                fl.enabled = false
                neon:destroyFront()
                neon:saveFront()
                if syncEvent then pcall(function() syncEvent({ action = 14, key = neon:encodeFrontSyncKey() }) end) end
            end
        end
        fl._prevHeadlights = hlOn
        -- Update front lights visuals
        if fl.enabled and #fl.lights > 0 then
            neon:applyFrontAnimColors(dt)
            neon:updateFront(car)
        end
        neon:updateRemoteFronts()
    end)

    -- Keybind checks (keyboard + gamepad) — binding mode DISABLED, normal hotkeys only
    pcall(function()
            -- Normal handling: check both keyboard AND gamepad
            for id, cfg in pairs(keyCfg) do
                local kbDown = ac.isKeyDown(cfg.code)
                local gpDown = isGpPressed(cfg.gpCode)
                if kbDown and not cfg.wasDown and not (BR.wantsKbd and showPanel) and not chat.active then
                    if id == 'menu' then showPanel = not showPanel
                    elseif id == 'save' then savePosition()
                    elseif id == 'tp' then teleport()
                    elseif id == 'walk' then walkToggle() end
                end
                if gpDown and not cfg.gpWasDown then
                    if id == 'menu' then showPanel = not showPanel
                    elseif id == 'save' then savePosition()
                    elseif id == 'tp' then teleport()
                    elseif id == 'walk' then walkToggle() end
                end
                cfg.wasDown = kbDown
                cfg.gpWasDown = gpDown
            end
    end)

    -- Gamepad menu nav (DPad Up/Down = scroll, A = select, B = back)
    pcall(function()
        if showPanel then
            local gUp  = isGpPressed(0x1)   -- DPadUp
            local gDn  = isGpPressed(0x2)   -- DPadDown
            local gA   = isGpPressed(0x1000) -- A
            local gB   = isGpPressed(0x2000) -- B
            local gLB  = isGpPressed(0x100)  -- LB
            local gRB  = isGpPressed(0x200)  -- RB
            local nav = nil
            local gp = purge._gpNav
            if gUp  and not (gp and gp.up)  then nav = 'up' end
            if gDn  and not (gp and gp.dn)  then nav = (nav and nav..'+' or '') .. 'down' end
            if gA   and not (gp and gp.a)   then nav = (nav and nav..'+' or '') .. 'click' end
            if gB   and not (gp and gp.b)   then nav = (nav and nav..'+' or '') .. 'back' end
            if gLB  and not (gp and gp.lb)  then nav = (nav and nav..'+' or '') .. 'lb' end
            if gRB  and not (gp and gp.rb)  then nav = (nav and nav..'+' or '') .. 'rb' end
            purge._gpNav = { up = gUp, dn = gDn, a = gA, b = gB, lb = gLB, rb = gRB }
            if nav and browser and BR.ready then
                pcall(function() browser:sendAsync('gpNav', nav, NOOP) end)
            end
        else
            purge._gpNav = nil
        end
    end)

    -- Defs timeout
    if not defsLoaded and defsFetchTime > 0 and (CC.clock - defsFetchTime) > 5 then
        defsError = 'Server timeout'; defsLoaded = true
    end

    -- Sync request (also fire for cars without definitions so they still request others' state)
    if defsLoaded and not syncSent then
        syncSent = true
        if syncEvent then pcall(function() syncEvent({ action = 3, key = '' }) end) end
    end

    -- Process staggered bcastState (action=3 responses spread over time)
    if _bcastDelayTimer > 0 then
        _bcastDelayTimer = _bcastDelayTimer - dt
        if _bcastDelayTimer <= 0 then
            _bcastDelayTimer = 0
            pcall(bcastState)
        end
    end

    -- Process staggered newCarSeen broadcast
    if _newCarBcastDelay > 0 then
        _newCarBcastDelay = _newCarBcastDelay - dt
        if _newCarBcastDelay <= 0 then
            _newCarBcastDelay = 0
            pcall(bcastState)
            pcall(function() syncEvent({ action = 3, key = '' }) end)
        end
    end

    -- Process queued heavy sync operations (max N per frame to prevent stutter)
    if #_syncOpQueue > 0 then
        local count = math.min(_syncOpsPerFrame, #_syncOpQueue)
        for _ = 1, count do
            local op = table.remove(_syncOpQueue, 1)
            if op then pcall(op) end
        end
    end

    -- Process avatar decode queue (max 1 per frame to prevent stutter)
    if #_avatarDecodeQueue > 0 then
        local url = table.remove(_avatarDecodeQueue, 1)
        if url then pcall(function() ui.decodeImage(url) end) end
    end

    -- Bucket transition detection: when a new car appears (routing bucket change),
    -- schedule a staggered broadcast so the new car sees our state
    pcall(function()
        if syncEvent and defsLoaded then
            local totalCars = ac.getSim().carsCount or 0
            local now = CC.clock
            local newCarSeen = false
            for ci = 0, totalCars - 1 do
                if ci ~= myCarIndex then
                    local isConn = false
                    pcall(function() local c = ac.getCar(ci); isConn = c and c.isConnected end)
                    if isConn and not _seenConnected[ci] then
                        _seenConnected[ci] = true
                        newCarSeen = true
                    elseif not isConn and _seenConnected[ci] then
                        _seenConnected[ci] = nil
                    end
                end
            end
            if newCarSeen and (now - _lastNewCarBcast) > 2 then
                _lastNewCarBcast = now
                -- Stagger: random 0.2-1.0s delay instead of immediate broadcast
                _newCarBcastDelay = 0.2 + math.random() * 0.8
            end
        end
    end)

    -- Periodic broadcast
    pcall(function()
        if syncEvent and defsLoaded then
            local now = CC.clock
            if now - lastSyncBcast > SYNC_INTERVAL then
                lastSyncBcast = now; bcastState()
            end
        end
    end)

end

