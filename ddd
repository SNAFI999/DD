                -- Outgoing translation
                local outLang = iddlStore and iddlStore.chatLangOut or 0
                local function _relayChatMsg(txt)
                    -- Show own message immediately in local chat
                    local myN = ac.getDriverName(myCarIndex) or ''
                    table.insert(chat.msgs, 1, {
                        name = myN, text = txt, time = os.clock(),
