-- Check for physics API availability (like FastTravelPlugin does)
local hasGentleStop = (physics.setGentleStop ~= nil)
local hasCollisionCtrl = (physics.disableCarCollisions ~= nil)

local collisionReEnableTime = 0 -- os.clock() at which we re-enable collisions
local _pitOverride = { wasInPit = false, mapBefore = 1, fadeUntil = 0 } -- track pit teleport for override

local function doTeleport(pos, dir, label)
    -- Release gentle stop if active
    if hasGentleStop then
        pcall(function() physics.setGentleStop(0, false) end)
    end
    -- Disable collisions temporarily (re-enabled in tick)
    if hasCollisionCtrl then
        pcall(function() physics.disableCarCollisions(0, true) end)
        collisionReEnableTime = os.clock() + 5.0
    end
    -- Wipe drift score on any teleport/reset
    if drift then
        drift.currentScore = 0
        drift.displayScore = 0
        drift.displayBonus = 0
        drift.bonusScore = 0
        drift._peakDisplay = 0
        drift._peakBonus = 0
        drift.combo = 1
        drift.comboReached = 0
        drift.inDrift = false
        drift.spinDetected = false
        drift._spinTimer = 0
    end
    -- Actually teleport
    physics.setCarPosition(0, pos, dir)
    notify(label or 'Teleported!')
end

local function savePosition()
    local car = ac.getCar(myCarIndex)
    if not car then notify('No car'); return end
    savedPos = car.position:clone(); savedDir = car.look:clone(); savedUp = car.up:clone()
    notify('Position saved!')
end

local function teleport()
    if not savedPos then notify('No saved pos'); return end
    local flipDir = vec3(-savedDir.x, savedDir.y, -savedDir.z)
    local ok, err = pcall(doTeleport, savedPos, flipDir, 'Teleported!')
    if not ok then notify('Teleport failed: ' .. tostring(err)) end
end

local function teleportToMap(mapIdx)
    notify('Teleporting to map ' .. tostring(mapIdx) .. '...')
    local m = mapLocations[mapIdx]
    if not m then notify('Unknown map'); return end
    local ok, err = pcall(function()
        currentMapIdx = mapIdx
        doTeleport(m.pos, m.dir, 'Teleported to ' .. m.name .. '!')
        -- Bucket assignment is server-side (MapBucketAssigner scans positions every 2s)
    end)
    if not ok then
        notify('Teleport failed: ' .. tostring(err))
    end
end

local function teleportToPlayer(ci)
    local target = ac.getCar(ci)
    if not target then notify('Player not found'); return end
    local pos = target.position:clone()
    local look = target.look:clone()
    pos.x = pos.x - look.x * 12
    pos.z = pos.z - look.z * 12
    local flipDir = vec3(-look.x, look.y, -look.z)
    local ok, err = pcall(doTeleport, pos, flipDir, 'Teleported to ' .. (ac.getDriverName(ci) or 'Car ' .. ci))
    if not ok then notify('TP failed') end
end

