                            chat.browser:sendAsync('msg', {
                                name = myN, text = txt, color = hexCol,
                                isMe = true, isMention = false, replyTo = nil,
                                avatar = av,
                                discordRole = dr and dr.role or nil,
                                discordRoleColor = dr and dr.color or nil,
                            }, NOOP)
                        end
                    end)
                    -- Send via native AC (same bucket) for other players
                    ac.sendChatMessage(txt)
                    -- Also relay via HTTP to all other buckets
                    pcall(function()
                        local function _esc(s)
                            if not s then return '""' end
                            return '"' .. tostring(s):gsub('\\', '\\\\'):gsub('"', '\\"'):gsub('\n', '\\n'):gsub('\r', '') .. '"'
