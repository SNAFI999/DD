----------------------------------------------------------------------
-- REMOTE DEFINITIONS CACHE (for syncing parts on different car models)
----------------------------------------------------------------------
getDefsForCar = function(ci)
    if ci == myCarIndex then return definitions end
    local tid = nil
    pcall(function() tid = ac.getCarID(ci) end)
    if not tid or tid == '' then return nil end
    if tid == carId then return definitions end -- same model as ours
    local cache = _remoteDefsCache[tid]
    if cache and cache.defs then return cache.defs end
    -- Not cached yet — fetch
    if cache and cache.fetching then return nil end -- already in flight
    _remoteDefsCache[tid] = { defs = nil, fetching = true }
    pcall(function()
        web.get(BASE_URL .. '/carpartswapper/definitions/' .. tid, function(err, resp)
            -- Wrap entire callback in pcall to protect CSP's HTTP dispatch from crashes
            pcall(function()
                if err or not resp or not resp.body or resp.body == '' then
                    _remoteDefsCache[tid] = { defs = {}, meta = {}, fetching = false }
                    return
                end
                local ok, data = pcall(JSON.parse, resp.body)
                if not ok or type(data) ~= 'table' then
                    _remoteDefsCache[tid] = { defs = {}, meta = {}, fetching = false }
                    return
                end
                local defs = data.mods or {}
                local remoteMeta = defs['__CAR__'] or {}
                defs['__CAR__'] = nil
                -- Split rims categories
                for mk, md in pairs(defs) do
                    if md.category == 'rims' and md.placements then
                        local hasFront, hasRear = false, false
                        for _, pl in ipairs(md.placements) do
                            local an = (pl.attachNode or ''):upper()
                            if an:find('_LF') or an:find('_RF') then hasFront = true end
                            if an:find('_LR') or an:find('_RR') then hasRear = true end
                        end
                        if hasFront and not hasRear then md.category = 'front rims'
                        elseif hasRear and not hasFront then md.category = 'rear rims' end
                    end
                end
                _remoteDefsCache[tid] = { defs = defs, meta = remoteMeta, fetching = false }
                -- NOTE: pending sync equips are processed in script.update where equipMod is in scope
            end)
        end)
    end)
    return nil
end

----------------------------------------------------------------------
-- FETCH DEFINITIONS
----------------------------------------------------------------------
local defsFetchTime = 0
local function fetchDefs()
    defsFetchTime = os.clock()
    pcall(function()
        web.get(BASE_URL .. '/carpartswapper/definitions/' .. carId, function(err, resp)
            pcall(function()
            if err then defsError = tostring(err); defsLoaded = true; return end
            if not resp or not resp.body or resp.body == '' then defsError = 'No defs'; defsLoaded = true; return end
            local ok, data = pcall(JSON.parse, resp.body)
            if not ok or type(data) ~= 'table' then defsError = 'Parse err'; defsLoaded = true; return end
            definitions = data.mods or {}
            -- Extract __CAR__ meta (CAR_COLOR, RIMS_ORIGINAL) before category build
            carMeta = definitions['__CAR__'] or {}
            definitions['__CAR__'] = nil
            -- Split rims into front/rear based on wheel attachment nodes
            for mk, md in pairs(definitions) do
                if md.category == 'rims' and md.placements then
                    local hasFront, hasRear = false, false
                    for _, pl in ipairs(md.placements) do
                        local an = (pl.attachNode or ''):upper()
                        if an:find('_LF') or an:find('_RF') then hasFront = true end
                        if an:find('_LR') or an:find('_RR') then hasRear = true end
                    end
                    if hasFront and not hasRear then md.category = 'front rims'
                    elseif hasRear and not hasFront then md.category = 'rear rims' end
                end
            end
            local cm = {}
            for mk, md in pairs(definitions) do
                local cn = md.category or 'other'
                if not cm[cn] then cm[cn] = { name = cn, mods = {} } end
                table.insert(cm[cn].mods, { key = mk, displayName = md.displayName or mk, placements = md.placements or {} })
            end
            categories = {}
            for _, c in pairs(cm) do
                table.sort(c.mods, function(a, b) return a.displayName < b.displayName end)
                table.insert(categories, c)
            end
            table.sort(categories, function(a, b) return a.name < b.name end)
            categoriesBuilt = true; defsLoaded = true
            -- Parse animations
            animDefs = {}
            if data._animations and type(data._animations) == 'table' then
                for i, ad in ipairs(data._animations) do
                    local pv = ad.pivot or {}
                    table.insert(animDefs, {
                        name = ad.name or ('Anim ' .. i),
                        meshes = ad.meshes or {},
                        axis = ad.axis or 'x',
                        angle = ad.angle or 45,
                        speed = ad.speed or 90,
                        pivot = { x = pv.x or 0, y = pv.y or 0, z = pv.z or 0 },
                        twoSided = ad.twoSided or false,
                    })
                end
            end
            end) -- pcall inside callback
        end)
    end)
end

----------------------------------------------------------------------
-- KN5 LOADING
----------------------------------------------------------------------
local nextPid = 1
local function getKN5Path(mk, tid)
    tid = tid or carId
    -- Use ContentCars folder (CSP trusted path)
    local cd = ac.getFolder(ac.FolderID.ContentCars)
    if not cd or cd == '' then
        local r = ac.getFolder(ac.FolderID.Root) or IDDL_CFG.acRoot
        cd = r .. '/content/cars'
    end
    -- Primary: inside car content folder (CSP trusted) - iddl_mods subfolder
    local carModPath = cd .. '/' .. tid .. '/iddl_mods/' .. mk
    -- Also try IDDLTUNING centralized folder
    local tuningPath = IDDL_CFG.tuningPartsPath .. '/' .. mk
    local tuningCarPath = IDDL_CFG.tuningPartsPath .. '/' .. tid .. '/' .. mk
    -- Old style path
    local oldPath = cd .. '/' .. tid .. '/carpartswapper_mods/' .. mk
    return carModPath, tuningCarPath, tuningPath, oldPath
end

local function loadKN5(mk, tid, parent, cb, fileVersion)
    local pathCarMod, pathTuningCar, pathTuning, pathOld = getKN5Path(mk, tid)
    local id = nextPid; nextPid = nextPid + 1
    local node = parent:createBoundingSphereNode('CPS_' .. id, 15)
    if not node then if cb then cb(nil, nil) end; return end

    local function fin()
        local m = node:findMeshes('?')
        local count = m and #m or 0
        if m and count > 0 then m:ensureUniqueMaterials() end
        _modLoadStatus[mk] = nil
        pushModLoadStatusToBrowser()
        if cb then cb(node, m) end
    end

    local function fail()
        node:dispose()
        _modLoadStatus[mk] = nil
        pushModLoadStatusToBrowser()
        if cb then cb(nil, nil) end
    end

    local function tryLoad(path)
        local s = pcall(function() node:loadKN5(path) end)
        if s then
            local m = node:findMeshes('?')
            if m and #m > 0 then
                return true
            end
        end
        return false
    end

    -- Try all local paths first (fast, synchronous)
    local paths = { pathCarMod, pathTuningCar, pathTuning, pathOld }
    for _, path in ipairs(paths) do
        if tryLoad(path) then
            fin(); return
        end
    end
    -- Local paths failed -> download from server via web.loadRemoteModel (ZIP -> cached KN5)
    _modLoadStatus[mk] = { state = 'loading' }
    pushModLoadStatusToBrowser()
    local httpUrl = BASE_URL .. '/carpartswapper/mods/' .. mk:gsub(' ', '%%20')
    if fileVersion then httpUrl = httpUrl .. '?v=' .. tostring(fileVersion) end
    local ok = pcall(function()
        web.loadRemoteModel(httpUrl, function(err, cachedFile)
            if err or not cachedFile or cachedFile == '' then
                fail(); return
            end
            local s = pcall(function() node:loadKN5(cachedFile) end)
            if s then
                local m = node:findMeshes('?')
                if m and #m > 0 then fin(); return end
            end
            fail()
        end)
    end)
    if not ok then
        fail()
    end
end

----------------------------------------------------------------------
-- EQUIP / UNEQUIP
----------------------------------------------------------------------
-- Rim categories that share wheel nodes and must be mutually exclusive
local _rimCats = { ['rims'] = true, ['front rims'] = true, ['rear rims'] = true }
-- Multi-select categories (allow multiple mods equipped at once)
local _multiCats = { ['accessories'] = true }

local function unequipMod(mk, ci)
    ci = ci or myCarIndex; local eq = equippedPerCar[ci]; if not eq then return end
    local e = eq[mk]; if not e then return end; local cr = getCarRoot(ci)
    -- Cancel any in-flight deferred placements (async KN5 loads still pending)
    e._cancelled = true
    -- Detach plate texture if this mod had LICENSE_PLATE
    if definitions and definitions[mk] then
        local md2 = definitions[mk]
        if md2.placements then
            for _, pd2 in ipairs(md2.placements) do
                if pd2.LICENSE_PLATE then
                    if ci == myCarIndex then
                        plate:detach()
                    else
                        remotePlateMesh[ci] = nil
                    end
                    break
                end
            end
        end
    end
    for _, pl in ipairs(e.placements) do
        if pl.hiddenMeshes and cr and #cr > 0 then
            for _, mn in ipairs(pl.hiddenMeshes) do
                local m = cr:findMeshes(mn); if m and #m > 0 then m:setVisible(true) end
            end
        end
        if pl.node then pl.node:dispose() end
    end
    eq[mk] = nil
    if ci == myCarIndex then _modLoadStatus[mk] = nil; pushModLoadStatusToBrowser() end
    local ce = equippedByCatPerCar[ci]
    if ce then for c, k in pairs(ce) do if k == mk then ce[c] = nil; break end end end
end

local function equipMod(mk, ci, remoteDefs)
    ci = ci or myCarIndex
    local defsTable = (ci ~= myCarIndex and remoteDefs) or definitions
    local md = defsTable and defsTable[mk]
    if not md or not md.placements or #md.placements == 0 then return end
    local cr = getCarRoot(ci); if not cr or #cr == 0 then return end

    -- For remote cars: verify ALL attachNodes exist before loading parts
    -- If any node is missing, defer to avoid parts appearing at wrong position
    if ci ~= myCarIndex then
        local allReady = true
        for _, pd in ipairs(md.placements) do
            if pd.attachNode and pd.attachNode ~= '' then
                local nr = cr:findNodes(pd.attachNode)
                if not nr or #nr == 0 then allReady = false; break end
            end
        end
        if not allReady then
            local already = false
            for _, dq in ipairs(deferredEquipQueue) do
                if dq.mk == mk and dq.ci == ci then already = true; break end
            end
            if not already then
                table.insert(deferredEquipQueue, { mk = mk, ci = ci, retries = 0, nextRetry = os.clock() + 0.5 })
            end
            return
        end
    end

    if not equippedPerCar[ci] then equippedPerCar[ci] = {} end
    if not equippedByCatPerCar[ci] then equippedByCatPerCar[ci] = {} end
    local cat = md.category
    -- Unequip ALL related rim categories to prevent stacking (rims/front rims/rear rims share wheel nodes)
    if cat and _rimCats[cat] then
        for rc in pairs(_rimCats) do
            if equippedByCatPerCar[ci][rc] then unequipMod(equippedByCatPerCar[ci][rc], ci) end
        end
    elseif cat and not _multiCats[cat] and equippedByCatPerCar[ci][cat] then
        unequipMod(equippedByCatPerCar[ci][cat], ci)
    end
    if equippedPerCar[ci][mk] then return end
    local eq = { placements = {} }; equippedPerCar[ci][mk] = eq
    if cat and not _multiCats[cat] then equippedByCatPerCar[ci][cat] = mk end
    if ci == myCarIndex then
        _modLoadStatus[mk] = { state = 'loading' }
        pushModLoadStatusToBrowser()
    end
    local tid = ac.getCarID(ci) or carId
    local placementQueue = {}
    for pi, pd in ipairs(md.placements) do
        table.insert(placementQueue, { idx = pi, pd = pd })
    end

    local function processPlacement(qi)
        if qi > #placementQueue then return end
        local item = placementQueue[qi]
        local pd = item.pd
        local pn = cr; local an = pd.attachNode
        if an then local nr = cr:findNodes(an); if nr and #nr > 0 then pn = nr end end
        local hm = pd.hiddenMeshes or {}
        for _, mn in ipairs(hm) do local m = cr:findMeshes(mn); if m and #m > 0 then m:setVisible(false) end end
        loadKN5(mk, tid, pn, function(node, meshes)
            -- If mod was unequipped while KN5 was loading, dispose and stop chain
            if eq._cancelled then
                if node then node:dispose() end
                return
            end
            if not node then
            else
                table.insert(eq.placements, {
                    node = node, meshes = meshes,
                    offset = vec3(pd.offset and pd.offset[1] or 0, pd.offset and pd.offset[2] or 0, pd.offset and pd.offset[3] or 0),
                    rotation = vec3(pd.rotation and pd.rotation[1] or 0, pd.rotation and pd.rotation[2] or 0, pd.rotation and pd.rotation[3] or 0),
                    scale = vec3(pd.scale and pd.scale[1] or 1, pd.scale and pd.scale[2] or 1, pd.scale and pd.scale[3] or 1),
                    attachNodeName = an, hiddenMeshes = hm,
                    wheelIndex = getWheelIdx(an), wheelSpinAngle = 0, targetCarIndex = ci,
                })
                -- Apply license plate texture if this placement has LICENSE_PLATE metadata
                if pd.LICENSE_PLATE then
                    local lp = pd.LICENSE_PLATE
                    local plateMeshName = lp.mesh or 'Plate_LODA1'
                    local plateTexSlot = lp.texSlot or 'txDiffuse'
                    local pmRef = node:findMeshes(plateMeshName)
                    if pmRef and #pmRef > 0 then
                        if ci == myCarIndex then
                            plate:applyToMesh(pmRef, plateTexSlot)
                        else
                            pmRef:ensureUniqueMaterials()
                            remotePlateMesh[ci] = pmRef
                            local rpd = remotePlateData[ci]
                            if rpd then
                                applyRemotePlate(ci, rpd.text, rpd.bg, rpd.tx)
                            end
                        end
                    end
                end
            end
            -- Defer next placement to NEXT FRAME (CSP can't load same KN5 twice in one frame)
            if qi < #placementQueue and not eq._cancelled then
                table.insert(deferredPlacementOps, function() processPlacement(qi + 1) end)
            else
                -- All placements loaded (or cancelled)
            end
        end, md and md.v)
    end
    processPlacement(1)
    if ci == myCarIndex then notify('Equipped: ' .. (md.displayName or mk)) end
end

----------------------------------------------------------------------
-- PRESETS: buildData() and applyData()
----------------------------------------------------------------------
function Presets.buildData()
    local eq = equippedPerCar and equippedPerCar[myCarIndex]
    local mods = {}
    if eq then for mk in pairs(eq) do mods[#mods + 1] = mk end end
    table.sort(mods)
    local skin = skinPerCar and skinPerCar[myCarIndex] or nil
    local col = colorPerCar and colorPerCar[myCarIndex]
    local rcol = rimColorPerCar and rimColorPerCar[myCarIndex]
    local rfcol = rimColorFrontPerCar and rimColorFrontPerCar[myCarIndex]
    local rrcol = rimColorRearPerCar and rimColorRearPerCar[myCarIndex]
    local anims = {}
    local myAnims = animStates and animStates[myCarIndex]
    if myAnims then
        for idx, st in pairs(myAnims) do
            if st.open then anims[#anims + 1] = idx end
        end
    end
    return {
        mods = mods,
        skin = skin,
        color = col,
        rimColor = rcol,
        rimColorFront = rfcol,
        rimColorRear = rrcol,
        neon = { enabled = neon.enabled, r = neon.r, g = neon.g, b = neon.b, brightness = neon.brightness, mode = neon.mode },
        frontLights = { enabled = neon.front.enabled, r = neon.front.r, g = neon.front.g, b = neon.front.b, brightness = neon.front.brightness, mode = neon.front.mode },
        smokeColor = { enabled = smokeColor.enabled, r = smokeColor.r, g = smokeColor.g, b = smokeColor.b },
        animations = anims,
    }
end

function Presets.applyData(data)
    if not data or type(data) ~= 'table' then return false end
    if not defsLoaded or not definitions then return false end
    local eq = equippedPerCar and equippedPerCar[myCarIndex]
    if eq then for mk in pairs(eq) do unequipMod(mk, myCarIndex) end end
    resetSkinForCar(myCarIndex)
    if data.mods and type(data.mods) == 'table' then
        for _, mk in ipairs(data.mods) do
            if definitions[mk] then
                equipMod(mk, myCarIndex)
                if syncEvent then pcall(function() syncEvent({ action = 1, key = mk }) end) end
            end
        end
    end
    if data.skin and data.skin ~= '' then
        applySkinToCar(myCarIndex, data.skin)
        if syncEvent then pcall(function() syncEvent({ action = 4, key = data.skin }) end) end
    end
    if data.color and data.color.r then
        applyColorToCar(myCarIndex, data.color.r, data.color.g, data.color.b)
        if syncEvent then pcall(function() syncEvent({ action = 5, key = string.format('%.3f|%.3f|%.3f', data.color.r, data.color.g, data.color.b) }) end) end
    end
    if data.rimColor and data.rimColor.r then
        applyColorToRims(myCarIndex, data.rimColor.r, data.rimColor.g, data.rimColor.b)
        if syncEvent then pcall(function() syncEvent({ action = 21, key = string.format('%.3f|%.3f|%.3f', data.rimColor.r, data.rimColor.g, data.rimColor.b) }) end) end
    end
    if data.rimColorFront and data.rimColorFront.r then
        applyColorToFrontRims(myCarIndex, data.rimColorFront.r, data.rimColorFront.g, data.rimColorFront.b)
        if syncEvent then pcall(function() syncEvent({ action = 22, key = string.format('%.3f|%.3f|%.3f', data.rimColorFront.r, data.rimColorFront.g, data.rimColorFront.b) }) end) end
    end
    if data.rimColorRear and data.rimColorRear.r then
        applyColorToRearRims(myCarIndex, data.rimColorRear.r, data.rimColorRear.g, data.rimColorRear.b)
        if syncEvent then pcall(function() syncEvent({ action = 23, key = string.format('%.3f|%.3f|%.3f', data.rimColorRear.r, data.rimColorRear.g, data.rimColorRear.b) }) end) end
    end
    if data.neon and type(data.neon) == 'table' then
        local n = data.neon
        neon.r = n.r or neon.r; neon.g = n.g or neon.g; neon.b = n.b or neon.b
        neon._baseR = neon.r; neon._baseG = neon.g; neon._baseB = neon.b
        neon.brightness = n.brightness or neon.brightness
        neon.mode = n.mode or neon.mode; neon._modeTimer = 0
        if n.enabled and not neon.enabled then neon.enabled = true; neon:create(); neon:updateColors()
        elseif not n.enabled and neon.enabled then neon.enabled = false; neon:destroy() end
        if neon.enabled then neon:updateColors() end
        neon:save()
        if syncEvent then pcall(function() syncEvent({ action = 11, key = neon:encodeSyncKey() }) end) end
    end
    if data.frontLights and type(data.frontLights) == 'table' then
        local f = data.frontLights
        neon.front.r = f.r or neon.front.r; neon.front.g = f.g or neon.front.g; neon.front.b = f.b or neon.front.b
        neon.front._baseR = neon.front.r; neon.front._baseG = neon.front.g; neon.front._baseB = neon.front.b
        neon.front.brightness = f.brightness or neon.front.brightness
        neon.front.mode = f.mode or neon.front.mode; neon.front._modeTimer = 0
        if f.enabled and not neon.front.enabled then neon.front.enabled = true; neon:createFront(); neon:updateFrontColors()
        elseif not f.enabled and neon.front.enabled then neon.front.enabled = false; neon:destroyFront() end
        if neon.front.enabled then neon:updateFrontColors() end
        neon:saveFront()
        if syncEvent then pcall(function() syncEvent({ action = 12, key = neon:encodeFrontSyncKey() }) end) end
    end
    if data.smokeColor and type(data.smokeColor) == 'table' then
        local sc = data.smokeColor
        smokeColor.r = sc.r or smokeColor.r; smokeColor.g = sc.g or smokeColor.g; smokeColor.b = sc.b or smokeColor.b
        if sc.enabled and not smokeColor.enabled then
            smokeColor.enabled = true; smokeColor:createEmitter()
        elseif not sc.enabled and smokeColor.enabled then
            smokeColor.enabled = false; smokeColor:destroyEmitter()
        end
        smokeColor:updateEmitterColor()
        smokeColor:save()
        if syncEvent then pcall(function() syncEvent({ action = 31, key = smokeColor:encodeSyncKey() }) end) end
    end
    return true
end

function Presets.save(name)
    local sn = Presets.sanitizeName(name)
    if not sn then if notify then notify('Invalid preset name') end; return false end
    local data = Presets.buildData()
    if not data then if notify then notify('No data to save') end; return false end
    local carPresets = Presets._forCar()
    carPresets[sn] = data
    Presets._persist()
    local names = Presets.list()
    if notify then notify('Preset saved: ' .. sn .. ' (' .. #names .. ' total)') end
    pushPresetsToBrowser()
    return true
end

function Presets.load(name)
    local sn = Presets.sanitizeName(name)
    if not sn then if notify then notify('Invalid preset name') end; return false end
    local carPresets = Presets._forCar()
    local data = carPresets[sn]
    if data then
        Presets.applyData(data)
        if notify then notify('Preset loaded: ' .. sn) end
        return true
    end
    if notify then notify('Preset not found: ' .. sn) end
    return false
end

function Presets.delete(name)
    local sn = Presets.sanitizeName(name)
    if not sn then return false end
    local carPresets = Presets._forCar()
    carPresets[sn] = nil
    Presets._persist()
    if notify then notify('Preset deleted: ' .. sn) end
    pushPresetsToBrowser()
    return true
end

function Presets.autoSave()
    local data = Presets.buildData()
    if data and #(data.mods or {}) > 0 then
        local carPresets = Presets._forCar()
        carPresets._autosave = data
        Presets._persist()
    end
end

