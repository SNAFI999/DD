                    pcall(function()
                        if chat.browser and chat.browserReady then
                            local hexCol = string.format('#%02x%02x%02x',
                                math.floor(math.min(1, C.accent.r) * 255),
                                math.floor(math.min(1, C.accent.g) * 255),
                                math.floor(math.min(1, C.accent.b) * 255))
                            local dr = _discordRoles[myN]
                            local av = ''
