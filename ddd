    pcall(function()
        local fl = io.scanDir(sp, '*')
        if fl then for _, fn in ipairs(fl) do
            local lo = fn:lower()
            if lo ~= 'preview.png' and lo ~= 'preview.jpg' and lo ~= 'livery.png' and lo ~= 'livery.jpg' and lo ~= 'ui_skin.json' then
                local ext = fn:match('^.+(%..+)$')
                if ext and imageExts[ext:lower()] then map[fn] = sp .. '/' .. fn end
            end
        end end
    end)
    resetSkinPerInstance(ci)
    applySkinTextures(ci, map)
    pcall(function()
        if io.fileExists(sp .. '/ext_config.ini') then
            cn:applyShaderReplacements(ac.INIConfig.load(sp .. '/ext_config.ini'):serialize())
        end
    end)
    pcall(function() ac.refreshCarColor(ci) end)
    skinPerCar[ci] = sfn; colorPerCar[ci] = nil
    if ci == myCarIndex then notify('Skin: ' .. sfn) end
