-- Shared handler for chat browser data (used by both overlay and sidebar browsers)
chat._handleBrowserData = function(data)
    if not data or type(data) ~= 'string' then return end
    if data:sub(1,5) == 'send:' then
        local msg = data:sub(6)
        if msg ~= '' then
                -- Check if player is muted
                local myName = ac.getDriverName(myCarIndex) or ''
                local muteExp = _muteList[myName]
                if muteExp and os.clock() < muteExp then
                    local left = math.ceil(muteExp - os.clock())
                    pcall(function()
                        if chat.browser and chat.browserReady then
                            chat.browser:sendAsync('muteStatus', { muted = true, seconds = left }, NOOP)
                        end
                    end)
                    return
                elseif muteExp then
                    _muteList[myName] = nil
                end

                -- Check if message starts with / (command prefix)
                if msg:sub(1,1) == '/' then
                end

                -- /ann <message> - broadcast announcement
                local annMsg = msg:match('^/ann%s+(.+)$')
                if annMsg then
                    if not isAdmin() then notify('No permission: Admin role required'); return end
                    -- Send announcement via sync event (action=16)
                    pcall(function()
                        if syncEvent then syncEvent({ action = 16, key = annMsg }) end
                    end)
                    -- Also push to own browser immediately
                    pcall(function()
                        if browser and BR.ready then
                            browser:sendAsync('announcement', { text = annMsg, from = ac.getDriverName(myCarIndex, function() end) or 'Admin' })
                        end
                    end)
                    showAdminToast('\xF0\x9F\x93\xA2', annMsg, 8, 0.17, 0.84, 0.47)
                    -- Also broadcast via server HTTP (shows in AC native chat for non-IDDL users)
                    pcall(function()
                        local body = '{"message":' .. jsonStr('[ANNOUNCEMENT] ' .. annMsg) .. '}'
                        web.post(BASE_URL .. '/admin/broadcast', { ['Content-Type'] = 'application/json' }, body, NOOP)
                    end)
                    notify('Announcement sent')
                    return
                end

                -- /kick <player> [reason] - kick player
                local kickTarget, kickReason = msg:match('^/kick%s+([^%s]+)%s*(.*)')
                if kickTarget then
                    kickTarget = kickTarget:gsub('^@', '')
                    if not isAdmin() then notify('No permission: Admin role required'); return end
                    -- Find full name (may be partial match)
                    local fullName = nil
                    local sim = ac.getSim()
                    for i = 0, (sim.carsCount or 0) - 1 do
                        local car = ac.getCar(i)
                        if car and car.isConnected then
                            local dn = ac.getDriverName(i) or ''
                            if dn:lower():find(kickTarget:lower(), 1, true) then
                                fullName = dn; break
                            end
                        end
                    end
                    if not fullName then notify('Player not found: ' .. kickTarget); return end
                    local reason = (kickReason and kickReason ~= '') and kickReason or 'Kicked by admin'
                    local body = '{"targetName":' .. jsonStr(fullName) .. ',"reason":' .. jsonStr(reason) .. '}'
                    web.post(BASE_URL .. '/admin/kick', { ['Content-Type'] = 'application/json' }, body, function(err, resp)
                        if err then notify('Kick failed: ' .. tostring(err)); return end
                        if resp and resp.body then
                            local ok, data = pcall(JSON.parse, resp.body)
                            if ok and data and data.ok then
                                notify('Kicked: ' .. fullName)
                            elseif ok and data and data.error then
                                notify('Kick error: ' .. tostring(data.error))
                            end
                        end
                    end)
                    return
                end

                -- /mute <player> [minutes] - mute player (default 5 min)
                local muteTarget, muteDur = msg:match('^/mute%s+([^%s]+)%s*(%d*)')
                if muteTarget then
                    muteTarget = muteTarget:gsub('^@', '')
                    if not isAdmin() then notify('No permission: Admin role required'); return end
                    local minutes = tonumber(muteDur) or 5
                    -- Find full name
                    local fullName = nil
                    local sim = ac.getSim()
                    for i = 0, (sim.carsCount or 0) - 1 do
                        local car = ac.getCar(i)
                        if car and car.isConnected then
                            local dn = ac.getDriverName(i) or ''
                            if dn:lower():find(muteTarget:lower(), 1, true) then
                                fullName = dn; break
                            end
                        end
                    end
                    if not fullName then notify('Player not found: ' .. muteTarget); return end
                    _muteList[fullName] = os.clock() + minutes * 60
                    -- Persist mute on server
                    pcall(function()
                        local body = '{"targetName":' .. jsonStr(fullName) .. ',"seconds":' .. tostring(minutes * 60) .. '}'
                        web.post(BASE_URL .. '/admin/mute', { ['Content-Type'] = 'application/json' }, body, NOOP)
                    end)
                    -- Broadcast mute via sync event (action=17, key = "mute|name|seconds")
                    pcall(function()
                        if syncEvent then syncEvent({ action = 17, key = 'mute|' .. fullName .. '|' .. tostring(minutes * 60) }) end
                    end)
                    -- Also push locally if target is self
                    local myN = ac.getDriverName(myCarIndex) or ''
                    if fullName:lower() == myN:lower() then
                        showAdminToast('\xF0\x9F\x94\x87', 'Muted for ' .. minutes .. ' min', 6, 0.94, 0.27, 0.27)
                        pcall(function()
                            if chat.browser and chat.browserReady then
                                chat.browser:sendAsync('muteStatus', { muted = true, seconds = minutes * 60 }, NOOP)
                            end
                        end)
                    end
                    notify('Muted ' .. fullName .. ' for ' .. minutes .. ' min')
                    return
                end

                -- /unmute <player>
                local unmuteTarget = msg:match('^/unmute%s+(.+)$')
                if unmuteTarget then
                    unmuteTarget = unmuteTarget:gsub('^@', ''):gsub('%s+$', '')
                    if not isAdmin() then notify('No permission: Admin role required'); return end
                    local fullName = nil
                    local sim = ac.getSim()
                    for i = 0, (sim.carsCount or 0) - 1 do
                        local car = ac.getCar(i)
                        if car and car.isConnected then
                            local dn = ac.getDriverName(i) or ''
                            if dn:lower():find(unmuteTarget:lower(), 1, true) then
                                fullName = dn; break
                            end
                        end
                    end
                    if not fullName then fullName = unmuteTarget end
                    _muteList[fullName] = nil
                    -- Remove mute from server
                    pcall(function()
                        local body = '{"targetName":' .. jsonStr(fullName) .. '}'
                        web.post(BASE_URL .. '/admin/unmute', { ['Content-Type'] = 'application/json' }, body, NOOP)
                    end)
                    pcall(function()
                        if syncEvent then syncEvent({ action = 17, key = 'unmute|' .. fullName .. '|0' }) end
                    end)
                    notify('Unmuted ' .. fullName)
                    return
                end

                -- /warn <player> [reason] - warn player
                local warnTarget, warnReason = msg:match('^/warn%s+([^%s]+)%s*(.*)')
                if warnTarget then
                    warnTarget = warnTarget:gsub('^@', '')
                    if not isAdmin() then notify('No permission: Admin role required'); return end
                    local fullName = nil
                    local sim = ac.getSim()
                    for i = 0, (sim.carsCount or 0) - 1 do
                        local car = ac.getCar(i)
                        if car and car.isConnected then
                            local dn = ac.getDriverName(i) or ''
                            if dn:lower():find(warnTarget:lower(), 1, true) then
                                fullName = dn; break
                            end
                        end
                    end
                    if not fullName then notify('Player not found: ' .. warnTarget); return end
                    _warnCounts[fullName] = (_warnCounts[fullName] or 0) + 1
                    local reason = (warnReason and warnReason ~= '') and warnReason or 'No reason given'
                    -- Broadcast warn via sync event (action=17, key = "warn|name|reason|count")
                    pcall(function()
                        if syncEvent then syncEvent({ action = 17, key = 'warn|' .. fullName .. '|' .. reason .. '|' .. tostring(_warnCounts[fullName]) }) end
                    end)
                    -- Also push locally for the warned player (syncEvent skips sender)
                    local myN = ac.getDriverName(myCarIndex) or ''
                    if fullName:lower() == myN:lower() then
                        showAdminToast('\xe2\x9a\xa0\xef\xb8\x8f', 'WARNING: ' .. reason .. ' (' .. _warnCounts[fullName] .. ')', 10, 0.94, 0.27, 0.27)
                        pcall(function()
                            if browser and BR.ready then
                                browser:sendAsync('adminWarn', { reason = reason, count = _warnCounts[fullName] }, NOOP)
                            end
                        end)
                        pcall(function()
                            if chat.browser and chat.browserReady then
                                chat.browser:sendAsync('adminWarn', { reason = reason, count = _warnCounts[fullName] }, NOOP)
                            end
                        end)
                    end
                    notify('Warned ' .. fullName .. ' (' .. _warnCounts[fullName] .. ' warnings)')
                    return
                end

                -- /report <player> <reason> - report a player to admins via Discord webhook
                local reportTarget, reportReason = msg:match('^/report%s+([^%s]+)%s+(.+)')
                if reportTarget then
                    reportTarget = reportTarget:gsub('^@', '')
                    local fullName = nil
                    local sim = ac.getSim()
                    for i = 0, (sim.carsCount or 0) - 1 do
                        local car = ac.getCar(i)
                        if car and car.isConnected then
                            local dn = ac.getDriverName(i) or ''
