            for _, pl in ipairs(defs[mk].placements) do
                local an = (pl.attachNode or ''):upper()
                local isFront = an:find('_LF') or an:find('_RF')
                local isRear = an:find('_LR') or an:find('_RR')
                if not filter or (filter == 'front' and isFront) or (filter == 'rear' and isRear) then
                    if pl.RIM_COLOR and type(pl.RIM_COLOR) == 'table' then
                        for _, rc in ipairs(pl.RIM_COLOR) do
                            if rc.mesh then entries[#entries + 1] = rc end
                        end
                    end
                end
            end
        end
    end
    return entries
end

-- Helper: get original rim textures from __CAR__ meta (supports remote cars)
function getOriginalRimTextures(filter, ci)
    local meta = (ci ~= nil) and getCarMeta(ci) or carMeta
    local texs = {}
    if filter ~= 'rear' and meta.RIMS_ORIGINAL_FRONT and type(meta.RIMS_ORIGINAL_FRONT) == 'table' then
        for _, tx in ipairs(meta.RIMS_ORIGINAL_FRONT) do texs[#texs + 1] = tx end
    end
    if filter ~= 'front' and meta.RIMS_ORIGINAL_REAR and type(meta.RIMS_ORIGINAL_REAR) == 'table' then
        for _, tx in ipairs(meta.RIMS_ORIGINAL_REAR) do texs[#texs + 1] = tx end
    end
    return texs
end

-- Core rim color apply: filter = nil (all), 'front', or 'rear'
function applyRimColorCore(ci, r, g, b, filter)
    local cn = getCarRoot(ci)
    if not cn or #cn == 0 then return end
    local hex = string.format('color::#%02x%02x%02x',
        math.floor(clamp(r, 0, 1) * 255),
        math.floor(clamp(g, 0, 1) * 255),
        math.floor(clamp(b, 0, 1) * 255))
    local rimEntries = collectRimColorEntries(ci, filter)
    if #rimEntries > 0 then
        for _, rc in ipairs(rimEntries) do
            pcall(function()
                local meshRef = cn:findMeshes(rc.mesh)
                if meshRef and #meshRef > 0 then
                    meshRef:ensureUniqueMaterials()
                    if rc.txDiffuse and rc.txDiffuse ~= '' then
                        meshRef:applySkin({ [rc.txDiffuse] = hex })
                    else
                        meshRef:applySkin({ ['txDiffuse'] = hex })
                    end
                end
            end)
        end
    else
        -- Fallback: use original rim textures or broad approach
        local origTex = getOriginalRimTextures(filter, ci)
        local wheelNames
        if filter == 'front' then wheelNames = { 'WHEEL_LF', 'WHEEL_RF' }
        elseif filter == 'rear' then wheelNames = { 'WHEEL_LR', 'WHEEL_RR' }
        else wheelNames = { 'WHEEL_LF', 'WHEEL_RF', 'WHEEL_LR', 'WHEEL_RR' } end
        for _, wn in ipairs(wheelNames) do
            pcall(function()
                local wNode = cn:findNodes(wn)
                if wNode and #wNode > 0 then
                    wNode:findMeshes('?'):ensureUniqueMaterials()
                    if #origTex > 0 then
                        local skinMap = {}
                        for _, tx in ipairs(origTex) do skinMap[tx] = hex end
                        wNode:findMeshes('?'):applySkin(skinMap)
                    else
                        wNode:findMeshes('?'):applySkin({ ['txDiffuse'] = hex })
                    end
                end
            end)
        end
    end
    pcall(function() ac.refreshCarColor(ci) end)
end

function applyColorToRims(ci, r, g, b)
    applyRimColorCore(ci, r, g, b, nil)
    rimColorPerCar[ci] = { r = r, g = g, b = b }
    rimColorFrontPerCar[ci] = nil; rimColorRearPerCar[ci] = nil
    if ci == myCarIndex then notify(string.format('Rim Color #%s applied', string.format('%02x%02x%02x', math.floor(clamp(r,0,1)*255), math.floor(clamp(g,0,1)*255), math.floor(clamp(b,0,1)*255)))) end
end

function applyColorToFrontRims(ci, r, g, b)
    applyRimColorCore(ci, r, g, b, 'front')
    rimColorFrontPerCar[ci] = { r = r, g = g, b = b }
    if ci == myCarIndex then notify(string.format('Front Rim Color applied')) end
end

function applyColorToRearRims(ci, r, g, b)
    applyRimColorCore(ci, r, g, b, 'rear')
    rimColorRearPerCar[ci] = { r = r, g = g, b = b }
    if ci == myCarIndex then notify(string.format('Rear Rim Color applied')) end
end

-- Core rim reset: filter = nil (all), 'front', or 'rear'
function resetRimColorCore(ci, filter)
    local cn = getCarRoot(ci)
    if not cn or #cn == 0 then return end
    local rimEntries = collectRimColorEntries(ci, filter)
    if #rimEntries > 0 then
        for _, rc in ipairs(rimEntries) do
            pcall(function()
                local meshRef = cn:findMeshes(rc.mesh)
                if meshRef and #meshRef > 0 then meshRef:resetSkin() end
            end)
        end
    else
        local wheelNames
        if filter == 'front' then wheelNames = { 'WHEEL_LF', 'WHEEL_RF' }
        elseif filter == 'rear' then wheelNames = { 'WHEEL_LR', 'WHEEL_RR' }
        else wheelNames = { 'WHEEL_LF', 'WHEEL_RF', 'WHEEL_LR', 'WHEEL_RR' } end
        for _, wn in ipairs(wheelNames) do
            pcall(function()
                local wNode = cn:findNodes(wn)
                if wNode and #wNode > 0 then wNode:findMeshes('?'):resetSkin() end
            end)
        end
    end
    pcall(function() ac.refreshCarColor(ci) end)
end

function resetRimColor(ci)
    resetRimColorCore(ci, nil)
    rimColorPerCar[ci] = nil; rimColorFrontPerCar[ci] = nil; rimColorRearPerCar[ci] = nil
    if ci == myCarIndex then notify('Rim color reset') end
end

function resetFrontRimColor(ci)
    resetRimColorCore(ci, 'front')
    rimColorFrontPerCar[ci] = nil
    if ci == myCarIndex then notify('Front rim color reset') end
end

function resetRearRimColor(ci)
    resetRimColorCore(ci, 'rear')
    rimColorRearPerCar[ci] = nil
    if ci == myCarIndex then notify('Rear rim color reset') end
end

