local TRANS = {
    count = 20,
    langs = {
        [0]  = nil,           -- OFF
        [1]  = 'English',
        [2]  = 'Polish',
        [3]  = 'German',
        [4]  = 'French',
        [5]  = 'Spanish',
        [6]  = 'Czech',
        [7]  = 'Russian',
        [8]  = 'Italian',
        [9]  = 'Portuguese',
        [10] = 'Japanese',
        [11] = 'Korean',
        [12] = 'Chinese',
        [13] = 'Dutch',
        [14] = 'Swedish',
        [15] = 'Turkish',
        [16] = 'Ukrainian',
        [17] = 'Romanian',
        [18] = 'Hungarian',
        [19] = 'Finnish',
        [20] = 'Norwegian',
    },
    codes = {
        [1]  = 'en', [2]  = 'pl', [3]  = 'de', [4]  = 'fr', [5]  = 'es',
        [6]  = 'cs', [7]  = 'ru', [8]  = 'it', [9]  = 'pt', [10] = 'ja',
        [11] = 'ko', [12] = 'zh', [13] = 'nl', [14] = 'sv', [15] = 'tr',
        [16] = 'uk', [17] = 'ro', [18] = 'hu', [19] = 'fi', [20] = 'no',
    },
}
function TRANS.translate(text, targetLangIdx, callback)
    if not text or text == '' then callback(text); return end
    local code = TRANS.codes[targetLangIdx]
    if not code then callback(text); return end
    if #text < 2 or text:sub(1,1) == '/' or text:sub(1,1) == '!' then callback(text); return end

    -- URL-encode text
    local encoded = text:gsub('([^%w%-%.%_%~ ])', function(c)
        return string.format('%%%02X', string.byte(c))
    end):gsub(' ', '+')

    local url = 'https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=' .. code .. '&dt=t&q=' .. encoded

    web.get(url, function(err, resp)
        if err or not resp or not resp.body then callback(text); return end
        local ok, data = pcall(JSON.parse, resp.body)
        if ok and type(data) == 'table' and type(data[1]) == 'table' then
            local parts = {}
            for _, seg in ipairs(data[1]) do
                if type(seg) == 'table' and seg[1] then
                    parts[#parts + 1] = tostring(seg[1])
                end
            end
            local result = table.concat(parts, '')
            if result ~= '' then
                callback(result)
            else
                callback(text)
            end
        else
            callback(text)
        end
    end)
end

