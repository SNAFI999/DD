-- Helper: check if any of the player's roles match any of the allowed roles
local function hasAnyRole(dr, perms)
    for _, r in ipairs(perms) do
        if r == '*' then return true end
    end
    if not dr then return false end
    local myRoles = dr.allRoles
    if myRoles and type(myRoles) == 'table' then
        for _, myR in ipairs(myRoles) do
            for _, r in ipairs(perms) do
                if myR:find(r, 1, true) then return true end
            end
        end
    else
        -- Fallback: single role string
        local myRole = dr.role or ''
        if myRole ~= '' then
            for _, r in ipairs(perms) do
                if myRole:find(r, 1, true) then return true end
            end
        end
    end
    return false
end

-- Compute which tabs the current player can see based on their discord role
function computeAllowedTabs()
    local pName = ac.getDriverName(myCarIndex) or ''
    local dr = _discordRoles[pName]
    local allTabs = { 'car', 'cars', 'maps', 'session', 'board', 'lobby', 'music', 'tod', 'config', 'discord', 'admin' }
    local allowed = {}
    for _, tab in ipairs(allTabs) do
        local perms = BR._tpTabs[tab]
        if not perms then
            allowed[#allowed + 1] = tab
        elseif hasAnyRole(dr, perms) then
            allowed[#allowed + 1] = tab
        end
    end
    return allowed
end

