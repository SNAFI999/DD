local function applySkinToCar(ci, sfn)
    local cn = getCarRoot(ci); if not cn or #cn == 0 then return end
    local tid = ac.getCarID(ci) or carId
    local sp = ac.getFolder(ac.FolderID.ContentCars) .. '/' .. tid .. '/skins/' .. sfn
