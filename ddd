local tgAdminEvent = ac.OnlineEvent({
    ac.StructItem.key('TG_ServerGhost_Admin'),
    action = ac.StructItem.byte(),
    ghostIndex = ac.StructItem.byte(),
}, function(sender, message)
    -- Also handle incoming admin events to keep local state in sync
    if message.action == 0 then
        ghostUI.enabled = not ghostUI.enabled
    elseif message.action == 1 then
        ghostUI.enabled = true
    elseif message.action == 2 then
        ghostUI.enabled = false
    elseif message.action == 3 then
        local idx = message.ghostIndex
        ghostUI.activeGhostIdx = idx
        ghostUI.activeGhostName = ghostUI.availableGhosts[idx + 1] or ''
        ghostUI.loaded = true
        ghostUI.loading = false
    elseif message.action == 4 then
        ghostUI.paused = not ghostUI.paused
    elseif message.action == 5 then
        ghostUI.paused = false
        ghostUI.loopCount = 0
    end
end)

