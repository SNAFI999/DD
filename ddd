local function tuningCamFocus(catName)
    if walk.active then return end

    -- Find attachNode + displayName for the category (for focal point / camera)
    local attachNode = nil
    local modDisplayName = nil
    for _, cat in ipairs(categories) do
        if cat.name == catName and #cat.mods > 0 then
            -- First, try to find a mod whose displayName has a camera preset
            for _, m in ipairs(cat.mods) do
                local md = definitions and definitions[m.key]
                if md and md.displayName then
                    local dn = md.displayName:lower():gsub('_', ' ')
                    if tuningCamPresets[dn] and md.placements and #md.placements > 0 then
                        attachNode = md.placements[1].attachNode
                        modDisplayName = md.displayName
                        break
                    end
                end
            end
            -- Fallback: use the first mod
            if not attachNode then
                local md = definitions and definitions[cat.mods[1].key]
                if md and md.placements and #md.placements > 0 then
                    attachNode = md.placements[1].attachNode
                    modDisplayName = md.displayName
                end
            end
            break
        end
    end
    if not attachNode and not modDisplayName then return end

    -- Look up camera preset for this part (by displayName first, then category)
    local catLower = catName:lower():gsub('_', ' ')
    local dnLower = modDisplayName and modDisplayName:lower():gsub('_', ' ') or ''
    local preset = tuningCamPresets[dnLower] or tuningCamPresets[catLower] or tuningCamDefaultPreset

    local localPos
    if preset.fp then
        -- Preset has hardcoded focal point — no need for node lookup
        localPos = vec3(preset.fp.x, preset.fp.y, preset.fp.z)
    else
        -- Find node in car scene graph → get part position in car-local space
        if not attachNode then return end
        local cr = getCarRoot(myCarIndex)
        if not cr or #cr == 0 then return end
        local nodeRef = cr:findNodes(attachNode)
        if not nodeRef or #nodeRef == 0 then return end
        local mt = nil
        pcall(function() mt = nodeRef:getTransformationRaw() end)
        if not mt then return end
        localPos = vec3(mt.row4.x, mt.row4.y, mt.row4.z)
    end

    local camLocalPos = vec3(preset.camOff.x, preset.camOff.y, preset.camOff.z)
    local targetFov = preset.fov

    -- Mirror camera to left side if part is on left side of car (X < -0.1)
    -- Skip mirroring when using custom FP (already tuned by user)
    if not preset.fp and localPos.x < -0.1 then
        camLocalPos.x = -camLocalPos.x
    end

    -- Grab camera if not already active
    if not tuningCam.active then
        -- Release menu-lock camera so tuning cam can take over
        if _menuLock.cam then
            pcall(function() _menuLock.cam:dispose() end)
            _menuLock.cam = nil
        end
        local cam = nil
        pcall(function() cam = ac.grabCamera('IDDL Tuning Camera') end)
        if not cam then return end
        tuningCam.cam = cam
        tuningCam.startPos = vec3(ac.getCameraPosition())
        tuningCam.startLook = vec3(ac.getCameraForward())
        tuningCam.fovStart = ac.getCameraFov and ac.getCameraFov() or 56
        tuningCam.origPos = vec3(ac.getCameraPosition())
        tuningCam.origLook = vec3(ac.getCameraForward())
        tuningCam.origFov = tuningCam.fovStart
    else
        -- Re-targeting: save current camera state as start for smooth transition
        tuningCam.startPos = vec3(tuningCam.cam.transform.position.x, tuningCam.cam.transform.position.y, tuningCam.cam.transform.position.z)
        tuningCam.startLook = vec3(tuningCam.cam.transform.look.x, tuningCam.cam.transform.look.y, tuningCam.cam.transform.look.z)
        tuningCam.fovStart = tuningCam.fov
    end

    tuningCam.localPos = localPos
    tuningCam.camLocalPos = camLocalPos
    tuningCam.fov = targetFov
    tuningCam.lerpT = 0
    tuningCam.returning = false
    tuningCam.active = true
end

local function tuningCamStop()
    if not tuningCam.active then return end
    if tuningCam.returning then
        -- Already returning — force immediate stop
        tuningCam.active = false
        tuningCam.returning = false
        if tuningCam.cam then
            pcall(function() tuningCam.cam:dispose() end)
            tuningCam.cam = nil
        end
        if _menuLock.active and not _menuLock.cam and not walk.active then
            pcall(function() _menuLock.cam = ac.grabCamera('IDDL Menu Lock') end)
        end
        return
    end
    -- Start smooth return to original camera position
    tuningCam.returning = true
    if tuningCam.cam then
        tuningCam.startPos = vec3(tuningCam.cam.transform.position.x, tuningCam.cam.transform.position.y, tuningCam.cam.transform.position.z)
        tuningCam.startLook = vec3(tuningCam.cam.transform.look.x, tuningCam.cam.transform.look.y, tuningCam.cam.transform.look.z)
        tuningCam.fovStart = tuningCam.cam.fov
    end
    tuningCam.lerpT = 0
end

local function updateTuningCam(dt)
    if not tuningCam.active or not tuningCam.cam then
        if tuningCam.active then tuningCamStop() end
        return
    end
    -- Check camera still valid
    local camOk = false
    pcall(function() camOk = tuningCam.cam:active() end)
    if not camOk then tuningCamStop(); return end

    local car = ac.getCar(myCarIndex)
    if not car or not car.position then tuningCamStop(); return end

    local camWorldPos, lookDir
    if tuningCam.returning then
        -- Return target: original game camera position
        camWorldPos = tuningCam.origPos
        lookDir = tuningCam.origLook
    else
        -- Convert focal point (part) to world space
        local lp = tuningCam.localPos
        local wp = vec3(
            car.position.x + car.side.x * lp.x + car.up.x * lp.y + car.look.x * lp.z,
            car.position.y + car.side.y * lp.x + car.up.y * lp.y + car.look.y * lp.z,
            car.position.z + car.side.z * lp.x + car.up.z * lp.y + car.look.z * lp.z
        )

        -- Convert camera position to world space
        local cl = tuningCam.camLocalPos
        camWorldPos = vec3(
            car.position.x + car.side.x * cl.x + car.up.x * cl.y + car.look.x * cl.z,
            car.position.y + car.side.y * cl.x + car.up.y * cl.y + car.look.y * cl.z,
            car.position.z + car.side.z * cl.x + car.up.z * cl.y + car.look.z * cl.z
        )

        -- Look direction: camera -> focal point
        local dx = wp.x - camWorldPos.x
        local dy = wp.y - camWorldPos.y
        local dz = wp.z - camWorldPos.z
        local dLen = math.sqrt(dx * dx + dy * dy + dz * dz)
        if dLen < 0.001 then dLen = 1 end
        lookDir = vec3(dx / dLen, dy / dLen, dz / dLen)
    end

    -- Smooth lerp transition
    local dur = tuningCam.returning and 1.6 or tuningCam.lerpDuration
    tuningCam.lerpT = math.min(1, tuningCam.lerpT + dt / dur)
    local t = tuningCam.lerpT
    if tuningCam.returning then
        -- ease-in-out cubic: gentle start and end for smooth return
        t = t < 0.5 and 4 * t * t * t or 1 - (-2 * t + 2) ^ 3 / 2
    else
        t = 1 - (1 - t) * (1 - t) * (1 - t)  -- ease-out cubic
    end

    local finalPos, finalLook
    if tuningCam.startPos and t < 0.999 then
        finalPos = vec3(
            tuningCam.startPos.x + (camWorldPos.x - tuningCam.startPos.x) * t,
            tuningCam.startPos.y + (camWorldPos.y - tuningCam.startPos.y) * t,
            tuningCam.startPos.z + (camWorldPos.z - tuningCam.startPos.z) * t
        )
        local slx = tuningCam.startLook.x + (lookDir.x - tuningCam.startLook.x) * t
        local sly = tuningCam.startLook.y + (lookDir.y - tuningCam.startLook.y) * t
        local slz = tuningCam.startLook.z + (lookDir.z - tuningCam.startLook.z) * t
        local sLen = math.sqrt(slx * slx + sly * sly + slz * slz)
        if sLen < 0.001 then sLen = 1 end
        finalLook = vec3(slx / sLen, sly / sLen, slz / sLen)
    else
        finalPos = camWorldPos
        finalLook = lookDir
    end

    -- Compute camera up and side from look direction
    local lx, ly, lz = finalLook.x, finalLook.y, finalLook.z
    local yaw = math.atan2(lx, lz)
    local rX = math.cos(yaw)
    local rY = 0
    local rZ = -math.sin(yaw)
    local upX = -(rY * lz - rZ * ly)
    local upY = -(rZ * lx - rX * lz)
    local upZ = -(rX * ly - rY * lx)

    -- Apply to camera
    local camT = tuningCam.cam.transform
    camT.position = finalPos
    camT.look = finalLook
    camT.side = vec3(rX, rY, rZ)
    camT.up = vec3(upX, upY, upZ)
    -- Smooth FOV transition
    local targetFov = tuningCam.returning and tuningCam.origFov or tuningCam.fov
    local currentFov = targetFov
    if tuningCam.fovStart and t < 0.999 then
        currentFov = tuningCam.fovStart + (targetFov - tuningCam.fovStart) * t
    end
    tuningCam.cam.fov = currentFov
    tuningCam.cam.ownShare = tuningCam.returning and (1 - t) or 1

    -- If return lerp complete, dispose camera and hand back to game
    if tuningCam.returning and tuningCam.lerpT >= 0.999 then
        tuningCam.active = false
        tuningCam.returning = false
        if tuningCam.cam then
            pcall(function() tuningCam.cam:dispose() end)
            tuningCam.cam = nil
        end
        if _menuLock.active and not _menuLock.cam and not walk.active then
            pcall(function() _menuLock.cam = ac.grabCamera('IDDL Menu Lock') end)
        end
    end
end
