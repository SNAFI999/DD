                V.v1.x = tagX + 1*s; V.v1.y = tagY + 1*s
                V.v2.x = tagX + cardW + 1*s; V.v2.y = tagY + cardH + 1*s
                V.cShadow.r = 0; V.cShadow.g = 0; V.cShadow.b = 0; V.cShadow.mult = 0.35 * a
                ui.drawRectFilled(V.v1, V.v2, V.cShadow, cornerR)
                -- Main card background
                V.v3.x = tagX; V.v3.y = tagY
                V.v4.x = tagX + cardW; V.v4.y = tagY + cardH
                V.cBg.r = 0.08; V.cBg.g = 0.08; V.cBg.b = 0.12; V.cBg.mult = 0.88 * a
                ui.drawRectFilled(V.v3, V.v4, V.cBg, cornerR)
                -- Subtle outline
                V.cOutline.r = 1; V.cOutline.g = 1; V.cOutline.b = 1; V.cOutline.mult = 0.07 * a
                ui.drawRect(V.v3, V.v4, V.cOutline, cornerR, nil, 1)
                -- Pointer triangle
                local pCx = tagX + cardW / 2
                V.v5.x = pCx - 4*s; V.v5.y = tagY + cardH
                V.v6.x = pCx + 4*s; V.v6.y = tagY + cardH
                V.v7.x = pCx; V.v7.y = tagY + cardH + ptrH
                V.cPtr.r = 0.08; V.cPtr.g = 0.08; V.cPtr.b = 0.12; V.cPtr.mult = 0.80 * a
                ui.drawTriangleFilled(V.v5, V.v6, V.v7, V.cPtr)

                local cx = tagX + pad
                local rowCY = tagY + cardH / 2

                -- Avatar
                if hasAvatar then
                    local avCx = tagX + cornerR
                    local avCy = rowCY
                    V.v8.x = avCx; V.v8.y = avCy
                    V.cRing.r = accent.r; V.cRing.g = accent.g; V.cRing.b = accent.b; V.cRing.mult = 0.50 * a
                    ui.drawCircleFilled(V.v8, avR + ringW, V.cRing, 24)
                    V.v9.x = avCx - avR; V.v9.y = avCy - avR
                    V.v10.x = avCx + avR; V.v10.y = avCy + avR
                    V.cWhite.r = 1; V.cWhite.g = 1; V.cWhite.b = 1; V.cWhite.mult = a
                    ui.drawImageRounded(avatarUrl, V.v9, V.v10, V.cWhite, V.uvA, V.uvB, avR)
                    cx = tagX + cornerR + avR + ringW + gap
                end

                -- Crew tag (before name)
                if crewTag and crewTagMeas and crewTagColor then
                    V.v11.x = cx; V.v11.y = rowCY - crewTagMeas.y / 2
                    V.cCrewTag.r = crewTagColor.r; V.cCrewTag.g = crewTagColor.g; V.cCrewTag.b = crewTagColor.b; V.cCrewTag.mult = a
                    ui.pushDWriteFont(F.bold)
                    ui.dwriteDrawText(crewTag, fontSize, V.v11, V.cCrewTag)
                    ui.popDWriteFont()
                    cx = cx + crewTagW
                end

                -- Name
                V.v11.x = cx; V.v11.y = rowCY - nameMeas.y / 2
                V.cName.r = 0.95; V.cName.g = 0.97; V.cName.b = 1.0; V.cName.mult = a
                ui.pushDWriteFont(F.semiBd)
                ui.dwriteDrawText(name, fontSize, V.v11, V.cName)
                ui.popDWriteFont()
                cx = cx + nameMeas.x + gap

                -- Role badge
                if roleName and roleW > 0 and roleMeas then
                    local rc = accent
                    local rH = 14 * s
                    local rY = rowCY - rH / 2
                    V.v12.x = cx; V.v12.y = rY
                    V.v13.x = cx + roleW; V.v13.y = rY + rH
                    V.cBadgeBg.r = rc.r * 0.15; V.cBadgeBg.g = rc.g * 0.15; V.cBadgeBg.b = rc.b * 0.15; V.cBadgeBg.mult = 0.80 * a
                    ui.drawRectFilled(V.v12, V.v13, V.cBadgeBg, rH / 2)
                    V.cBadgeBorder.r = rc.r; V.cBadgeBorder.g = rc.g; V.cBadgeBorder.b = rc.b; V.cBadgeBorder.mult = 0.35 * a
                    ui.drawRect(V.v12, V.v13, V.cBadgeBorder, rH / 2, nil, 1)
                    V.v14.x = cx + (roleW - roleMeas.x) / 2; V.v14.y = rY + (rH - roleMeas.y) / 2
                    V.cBadgeText.r = rc.r; V.cBadgeText.g = rc.g; V.cBadgeText.b = rc.b; V.cBadgeText.mult = 0.95 * a
                    ui.pushDWriteFont(F.bold)
                    ui.dwriteDrawText(roleName, tinyFont, V.v14, V.cBadgeText)
                    ui.popDWriteFont()
                end
        end -- for ci in _nametagLastData
        end)
    end)
    end -- showNametags

    --------------------------------------------------------------------------
    -- TUTORIAL TIMERS
    --------------------------------------------------------------------------
    -- Delayed tutorial start (10s after joining)
    if tut.delayTimer then
        tut.delayTimer = tut.delayTimer - dt
        if tut.delayTimer <= 0 then
