    end)
end

----------------------------------------------------------------------
-- TIRE SMOKE COLOR (custom colored rear-tyre smoke via ac.Particles.Smoke)
-- NOTE: not 'local' — main chunk is at the 200-local Lua limit
-- Full physics-based emission using CSP smoke system knowledge:
--   - slipAngle + slipRatio + speedDifference for trigger
--   - tyreCoreTemperature for intensity scaling + hot gas rise
--   - isHot flag for overheating bonus emission
--   - surfaceType filtering (no smoke on grass/dirt)
--   - surfaceHeat in overrideTyreSmoke when tire is hot
--   - FadeIn flag for smooth particle appearance
--   - velocity follows car direction + upward component
----------------------------------------------------------------------
smokeColor = {
    enabled = false,
    r = 0, g = 0, b = 0,
    smoke = nil,      -- ac.Particles.Smoke instance for local car
    remotes = {},     -- [ci] = { r, g, b, smoke }
    mode = 'none',     -- 'none', 'rainbow', 'police', 'drift', 'breathing', 'strobe'
    _modeTimer = 0,
    _slipThreshold = 6,    -- min slip angle (deg) to emit
    _speedThreshold = 10,  -- min speed (km/h) to emit
    -- Tunable particle params (live sliders)
    _thickness = 0.50,
    _life = 3.75,
    _size = 0.24,
    _spreadK = 1.25,
    _growK = 1.40,
    _targetYVelocity = 0,
    _colorConsistency = 0.50,
    _alpha = 0.50,
    -- Tunable emission params
    _qtyMul = 1,
    _emitVelY = 0.50,
    _arcSpread = 0.90,
    _sideSpread = 0.40,
    _arcPts = 7,
    _sidePts = 3,
    -- Physics-based params
    _tempBoost = 0.60,
    _slipRatioFactor = 0.90,
    _heatRise = 0.35,
    -- Fade-out state (per wheel, smooth blend to zero)
    _fadeIntensity = { [2] = 0, [3] = 0 },
    _fadeDecay = 3.0,  -- how fast fade decays (units per second)
    _remoteFade = {},  -- per-car fade for remotes: [ci] = { [2]=0, [3]=0 }
}

-- Build emitter params table (shared between local + remote)
function smokeColor:_buildEmitterParams(r, g, b)
    return {
        color = rgbm(r, g, b, self._alpha),
        colorConsistency = self._colorConsistency,
        thickness = self._thickness,
        life = self._life,
        size = self._size,
        spreadK = self._spreadK,
        growK = self._growK,
        targetYVelocity = self._targetYVelocity,
        flags = 1,  -- ac.Particles.SmokeFlags.FadeIn — smooth fade-in
    }
end

function smokeColor:createEmitter()
    if self.smoke then return end
    pcall(function()
        self.smoke = ac.Particles.Smoke(self:_buildEmitterParams(self.r, self.g, self.b))
    end)
end

function smokeColor:destroyEmitter()
    self.smoke = nil
    -- Restore default tire smoke (pass NaN to restore original)
    pcall(function() ac.overrideTyreSmoke(2, 0/0, 0, 0) end)
    pcall(function() ac.overrideTyreSmoke(3, 0/0, 0, 0) end)
end

function smokeColor:updateEmitterColor()
    if self.smoke then
        pcall(function() self.smoke.color = rgbm(self.r, self.g, self.b, self._alpha) end)
    end
end

-- HSV to RGB (h: 0-360, s,v: 0-1) → r,g,b: 0-1
function smokeColor:hsv2rgb(h, s, v)
    local c = v * s
    local hp = (h % 360) / 60
    local x = c * (1 - math.abs(hp % 2 - 1))
    local r1, g1, b1 = 0, 0, 0
    if hp < 1 then r1, g1, b1 = c, x, 0
    elseif hp < 2 then r1, g1, b1 = x, c, 0
    elseif hp < 3 then r1, g1, b1 = 0, c, x
    elseif hp < 4 then r1, g1, b1 = 0, x, c
    elseif hp < 5 then r1, g1, b1 = x, 0, c
    else r1, g1, b1 = c, 0, x end
    local m = v - c
    return r1 + m, g1 + m, b1 + m
end

-- Apply smoke mode animation — updates emitter color each frame
function smokeColor:applyMode(dt)
    self._modeTimer = self._modeTimer + dt
    local mode = self.mode
    if mode == 'none' then return end
    local t = self._modeTimer
    local r, g, b = self.r, self.g, self.b
    if mode == 'rainbow' then
        local hue = (t * 90) % 360
        r, g, b = self:hsv2rgb(hue, 1, 1)
    elseif mode == 'police' then
        local cycle = math.floor(t * 3) % 2
        if cycle == 0 then r, g, b = 1, 0, 0
        else r, g, b = 0, 0, 1 end
    elseif mode == 'drift' then
        local wheels = myCar and myCar.wheels
        local maxSlip = 0
        if wheels then
            maxSlip = math.max(math.abs(wheels[2] and wheels[2].slipAngle or 0), math.abs(wheels[3] and wheels[3].slipAngle or 0))
        end
        local hue = math.max(0, 120 - maxSlip * 3)
        r, g, b = self:hsv2rgb(hue, 1, 1)
    elseif mode == 'breathing' then
        local pulse = (math.sin(t * 2) + 1) * 0.5
        r = self.r * (0.3 + 0.7 * pulse)
        g = self.g * (0.3 + 0.7 * pulse)
        b = self.b * (0.3 + 0.7 * pulse)
    elseif mode == 'strobe' then
        local on = math.floor(t * 8) % 2 == 0
        if not on then r, g, b = 0, 0, 0 end
    end
    if self.smoke then
        pcall(function() self.smoke.color = rgbm(r, g, b, self._alpha) end)
    end
end

function smokeColor:recreateEmitter()
    if not self.enabled then return end
    self.smoke = nil
    self:createEmitter()
end

function smokeColor:applyParam(name, val)
    if name == 'thickness' then self._thickness = val
    elseif name == 'life' then self._life = val
    elseif name == 'size' then self._size = val
    elseif name == 'spreadK' then self._spreadK = val
    elseif name == 'growK' then self._growK = val
    elseif name == 'targetYVelocity' then self._targetYVelocity = val
    elseif name == 'colorConsistency' then self._colorConsistency = val
    elseif name == 'alpha' then self._alpha = val
    elseif name == 'qtyMul' then self._qtyMul = val
    elseif name == 'emitVelY' then self._emitVelY = val
    elseif name == 'arcSpread' then self._arcSpread = val
    elseif name == 'sideSpread' then self._sideSpread = val
    elseif name == 'arcPts' then self._arcPts = math.floor(val)
    elseif name == 'sidePts' then self._sidePts = math.floor(val)
    elseif name == 'slipThreshold' then self._slipThreshold = val
    elseif name == 'speedThreshold' then self._speedThreshold = val
    elseif name == 'tempBoost' then self._tempBoost = val
    elseif name == 'slipRatioFactor' then self._slipRatioFactor = val
    elseif name == 'heatRise' then self._heatRise = val
    end
    -- Particle appearance params require emitter recreation
    local particleParams = { thickness=1, life=1, size=1, spreadK=1, growK=1, targetYVelocity=1, colorConsistency=1, alpha=1 }
    if particleParams[name] then
        self:recreateEmitter()
    end
end

function smokeColor:save()
    pcall(function()
        if iddlStore then
            iddlStore.smokeEnabled = self.enabled and 1 or 0
            iddlStore.smokeR = self.r
            iddlStore.smokeG = self.g
            iddlStore.smokeB = self.b
            iddlStore.smokeMode = self.mode or 'none'
        end
    end)
end

function smokeColor:encodeSyncKey()
    if self.enabled then
        return string.format('1|%.3f|%.3f|%.3f|%s', self.r, self.g, self.b, self.mode or 'none')
    else
        return '0'
    end
end

function smokeColor:decodeSyncKey(key, ci)
    if key == '0' then
        if self.remotes[ci] then
            self.remotes[ci] = nil
        end
        self._remoteFade[ci] = nil
    else
        local en, rv, gv, bv, md = key:match('(%d)|([%d%.]+)|([%d%.]+)|([%d%.]+)|?(%a*)')
        if en == '1' then
            local rr = tonumber(rv) or 0
            local gg = tonumber(gv) or 0
            local bb = tonumber(bv) or 0
            local rmode = (md and md ~= '') and md or 'none'
            local rem = self.remotes[ci]
            if not rem then
                rem = { r = rr, g = gg, b = bb, smoke = nil, mode = rmode }
                pcall(function()
                    rem.smoke = ac.Particles.Smoke(self:_buildEmitterParams(rr, gg, bb))
                end)
                self.remotes[ci] = rem
            else
                rem.r = rr; rem.g = gg; rem.b = bb; rem.mode = rmode
                if rem.smoke then
                    pcall(function() rem.smoke.color = rgbm(rr, gg, bb, self._alpha) end)
                end
            end
        end
    end
end

-- Compute per-wheel smoke intensity from full physics state
function smokeColor:_wheelIntensity(w, speed)
    -- Lateral slip (drifting)
    local slipAng = math.abs(w.slipAngle or 0)
    if slipAng < self._slipThreshold and math.abs(w.slipRatio or 0) < 0.1 then return 0 end
    local lateralSlip = math.max(0, (slipAng - self._slipThreshold) / 35)
    -- Longitudinal slip (burnout / lockup) via slipRatio & speedDifference
    local longSlip = math.min(1, math.abs(w.slipRatio or 0)) * self._slipRatioFactor
    local spdDiff = math.min(1, (math.abs(w.speedDifference or 0) / 40)) * self._slipRatioFactor
    -- Combined slip intensity (0..1+)
    local combined = math.min(2, lateralSlip + math.max(longSlip, spdDiff))
    -- Temperature boost: hotter tire = more smoke
    local coreTemp = w.tyreCoreTemperature or 80
    local optTemp = w.tyreOptimumTemperature or 85
    local tempRatio = math.max(0, (coreTemp - optTemp) / optTemp) -- >0 when above optimal
    local tempMul = 1 + tempRatio * self._tempBoost * 2
    -- isHot bonus: tire overheating → big boost
    if w.isHot then tempMul = tempMul + 0.5 end
    return math.min(2, combined * tempMul)
end

-- Check if surface is appropriate for smoke (no smoke on grass/dirt/sand)
function smokeColor:_isSmokeySurface(w)
    local st = w.surfaceType
    if st == nil then return true end
    -- ac.SurfaceType: 0=default/asphalt, values >0 may be dirt/grass/sand
    -- Only emit on paved surfaces (type 0 or very low grip reduction)
    local grip = w.surfaceGrip or 1
    local gran = w.surfaceGranularity or 0
    -- Granular surfaces (dirt, gravel) → no tire smoke, would be dust
    if gran > 0.3 then return false end
    -- Very low grip (ice, wet grass) → minimal smoke
    if grip < 0.7 then return false end
    return true
end

function smokeColor:emitForCar(car, ci, dt)
    local sm = (ci == myCarIndex) and self.smoke or (self.remotes[ci] and self.remotes[ci].smoke)
    if not sm then return end
    local wheels = car.wheels
    if not wheels then return end
    local speed = math.abs(car.speedKmh or 0)
    local carVel = car.velocity or vec3(0, 0, 0)
    local isRemote = (ci ~= myCarIndex)
    -- Per-car fade table
    local fadeTab
    if isRemote then
        if not self._remoteFade[ci] then self._remoteFade[ci] = { [2] = 0, [3] = 0 } end
        fadeTab = self._remoteFade[ci]
    else
        fadeTab = self._fadeIntensity
    end
    -- For remote cars: estimate drift from velocity vs heading (per-wheel physics unavailable)
    local remoteDriftIntensity = 0
    if isRemote and speed >= self._speedThreshold then
        local vx, vz = carVel.x, carVel.z
        local hSpd = math.sqrt(vx * vx + vz * vz)
        if hSpd > 1 then
            local bt = car.bodyTransform
            if bt then
                local fwd = bt.look or vec3(0, 0, 1)
                local dot = (vx * fwd.x + vz * fwd.z) / hSpd
                dot = math.max(-1, math.min(1, dot))
                local driftAngle = math.acos(dot) * 57.2958  -- rad to deg
                if driftAngle > 3 then
                    remoteDriftIntensity = math.min(2, (driftAngle - 3) / 25)
                end
            end
        end
    end
    -- Build arc angles
    local nArc = self._arcPts
    local arcMax = self._arcSpread
    local angles = {}
    if nArc <= 1 then
        angles[1] = 0
    else
        for ai = 0, nArc - 1 do
            angles[ai + 1] = -arcMax + (2 * arcMax * ai / (nArc - 1))
        end
    end
    -- Build side offsets
    local nSide = self._sidePts
    local sMax = self._sideSpread
    local sideOffsets = {}
    if nSide <= 1 then
        sideOffsets[1] = 0
    else
        for si = 0, nSide - 1 do
            sideOffsets[si + 1] = -sMax + (2 * sMax * si / (nSide - 1))
        end
    end
    local frameDt = dt or 0.016
    for wi = 2, 3 do
        local w = wheels[wi]
        if w then
            -- Physics-based intensity (local) or velocity-based estimate (remote)
            local targetIntensity = 0
            if isRemote then
                targetIntensity = remoteDriftIntensity
            else
                if not self:_isSmokeySurface(w) then
                    fadeTab[wi] = math.max(0, (fadeTab[wi] or 0) - self._fadeDecay * frameDt)
                    goto continueWheel
                end
                if speed >= self._speedThreshold then
                    targetIntensity = self:_wheelIntensity(w, speed)
                end
            end
            -- Smooth fade
            local prev = fadeTab[wi] or 0
            if targetIntensity >= prev then
                fadeTab[wi] = targetIntensity
            else
                fadeTab[wi] = math.max(0, prev - self._fadeDecay * frameDt)
            end
            local intensity = fadeTab[wi]
            if intensity <= 0.01 then goto continueWheel end
            local qty = math.max(1, math.floor(math.min(intensity, 2) * self._qtyMul))
            -- Velocity
            local upVel = self._emitVelY
            if not isRemote then
                local coreTemp = w.tyreCoreTemperature or 80
                local optTemp = w.tyreOptimumTemperature or 85
                upVel = upVel + math.max(0, (coreTemp - optTemp) / optTemp) * self._heatRise
            end
            local driftK = 0.15
            local vel = vec3(carVel.x * driftK, upVel, carVel.z * driftK)
            -- Geometry
            local cp = w.contactPoint or w.position
            local radius = w.tyreLoadedRadius or w.tyreRadius or 0.3
            local hw = (w.tyreWidth or 0.2) * 0.5
            local side = w.transform and w.transform.side or vec3(1, 0, 0)
            local upDir = vec3(0, 1, 0)
            local look = w.transform and w.transform.look or vec3(0, 0, 1)
            local fadeFrac = math.min(1, intensity / 0.3)
            for _, ang in ipairs(angles) do
                local arcUp = radius * (1 - math.cos(ang))
                local arcFwd = radius * math.sin(ang)
                local basePos = cp + upDir * arcUp + look * arcFwd
                for _, sOff in ipairs(sideOffsets) do
                    local pos = basePos + side * (hw * sOff)
                    local emitQty = math.max(1, math.floor(qty * fadeFrac))
                    pcall(function() sm:emit(pos, vel, emitQty) end)
                end
            end
            ::continueWheel::
        end
    end
end

