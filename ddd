-- Check mute status from server (persists across reconnects)
local _muteCheckDone = false
local function checkMuteStatus()
    local myName = ac.getDriverName(myCarIndex) or ''
    if myName == '' then return end
    pcall(function()
        web.get(BASE_URL .. '/admin/mute-check?name=' .. myName, function(err, resp)
            if err or not resp or not resp.body then return end
            local ok, data = pcall(JSON.parse, resp.body)
            if ok and type(data) == 'table' and data.muted then
                local secs = tonumber(data.remainingSeconds) or 0
                if secs > 0 then
                    _muteList[myName] = os.clock() + secs
                    local mins = math.ceil(secs / 60)
                    showAdminToast('\xF0\x9F\x94\x87', 'You are muted (' .. mins .. ' min left)', 6, 0.94, 0.27, 0.27)
                    pcall(function()
                        if chat.browser and chat.browserReady then
                            chat.browser:sendAsync('muteStatus', { muted = true, seconds = secs }, NOOP)
                        end
                    end)
                end
            end
            _muteCheckDone = true
        end)
    end)
end

function pushPlayersToBrowser()
    if not browser or not BR.ready then return end
    fetchServerPlayersInfo()
    fetchDiscordRoles()
    fetchCrewTags()
    if not _muteCheckDone then checkMuteStatus() end
    local sim = ac.getSim()
    local total = sim.carsCount or 0
    local players = {}
    local localNames = {}
    for i = 0, total - 1 do
        local car = ac.getCar(i)
        if car and car.isConnected then
            local driverName = ac.getDriverName(i) or ('Car ' .. i)
            localNames[driverName] = true
            local srv = _serverPlayersCache[driverName]
            local dr = _discordRoles[driverName]
            players[#players + 1] = {
                name = driverName,
                car = ac.getCarID(i) or '',
                speed = math.abs(car.speedKmh or 0),
                isMe = (i == myCarIndex),
                index = i,
                connected = true,
                inputMethod = srv and srv.inputMethod or 'unknown',
                ping = srv and srv.ping or 0,
                avatar = srv and srv.avatar or '',
                discordRole = dr and dr.role or nil,
                discordRoleColor = dr and dr.color or nil
            }
        end
    end
    -- Add cross-bucket players from server cache (other maps)
    if _serverPlayersCache then
        for pName, srv in pairs(_serverPlayersCache) do
            if not localNames[pName] then
                local dr = _discordRoles[pName]
                players[#players + 1] = {
                    name = pName,
                    car = '',
                    speed = 0,
                    isMe = false,
                    index = -1,
                    connected = true,
                    otherMap = true,
                    inputMethod = srv.inputMethod or 'unknown',
                    ping = srv.ping or 0,
                    avatar = srv.avatar or '',
                    discordRole = dr and dr.role or nil,
                    discordRoleColor = dr and dr.color or nil
                }
            end
        end
    end
    table.sort(players, function(a, b)
        if a.isMe ~= b.isMe then return a.isMe end
        if (a.index >= 0) ~= (b.index >= 0) then return a.index >= 0 end
        return (a.name or '') < (b.name or '')
    end)
    browser:sendAsync('players', players, NOOP)
end

