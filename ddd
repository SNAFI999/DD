ac.onChatMessage(function(message, senderCarIndex, senderSessionID)
    -- Skip own messages (already shown instantly by _relayChatMsg)
    if senderCarIndex == myCarIndex then return true end
    local senderName = 'Server'
    local nameCol = C.cyan
    if senderCarIndex >= 0 then
        senderName = ac.getDriverName(senderCarIndex) or 'Driver'
        -- Record in dedup table so polling skips this message
        if not chat._recentNative then chat._recentNative = {} end
        chat._recentNative[senderName .. '\t' .. message] = os.clock()
        if senderCarIndex == myCarIndex then
            nameCol = C.accent
        else
            nameCol = C.text
        end
    end

    -- Parse reply prefix: ↩@Name » actual text
    local replyToName = nil
    local msgBody = message
    local rName, rBody = message:match('^↩@(.+) » (.+)$')
    if rName and rBody then
        replyToName = rName
        msgBody = rBody
    end

    -- Check if message mentions our name (check clean body)
    local myName = ac.getDriverName(myCarIndex) or ''
    local isMention = myName ~= '' and msgBody:lower():find('@' .. myName:lower(), 1, true)

    -- Helper to add message to chat and push to browser
    local function pushChatMsg(displayText)
        table.insert(chat.msgs, 1, {
            name = senderName,
            text = displayText,
            time = os.clock(),
            color = nameCol,
            fade = 1,
            mention = isMention or false,
            replyTo = replyToName,
        })

        -- Push to HTML chat browser
        pcall(function()
            if chat.browser and chat.browserReady then
                local hexCol = string.format('#%02x%02x%02x',
                    math.floor(math.min(1, nameCol.r) * 255),
                    math.floor(math.min(1, nameCol.g) * 255),
                    math.floor(math.min(1, nameCol.b) * 255))
                local dr = _discordRoles[senderName]
                local av = ''
                if _serverPlayersCache and _serverPlayersCache[senderName] then
                    av = _serverPlayersCache[senderName].avatar or ''
                end
                local isMeMsg = (senderCarIndex == myCarIndex)
                chat.browser:sendAsync('msg', {
                    name = senderName,
                    text = displayText,
                    color = hexCol,
                    isMe = isMeMsg,
                    isMention = isMention or false,
                    replyTo = replyToName,
                    avatar = av,
                    discordRole = dr and dr.role or nil,
                    discordRoleColor = dr and dr.color or nil,
                }, NOOP)
            end
        end)

        -- Trim
        while #chat.msgs > chat.maxMsgs do
            table.remove(chat.msgs)
        end

        -- If mentioned, reset fade so it stays visible longer
        if isMention then
            chat.msgs[1].fadeTime = 20
        end
    end

    -- Incoming translation: translate to user's preferred language
    local inLang = iddlStore and iddlStore.chatLangIn or 0
    if inLang > 0 and TRANS.langs[inLang] then
        -- Show original immediately, then replace with translation
        pushChatMsg(msgBody)
        TRANS.translate(msgBody, inLang, function(translated)
            if translated ~= msgBody then
                local showOrig = iddlStore and iddlStore.transShowOrig == 1
                local displayText = showOrig and (translated .. '  [' .. msgBody .. ']') or translated
                -- Update the most recent message from this sender with translation
                for _, m in ipairs(chat.msgs) do
                    if m.name == senderName and m.text == msgBody then
                        m.text = displayText
                        -- Update browser too
                        pcall(function()
                            if chat.browser and chat.browserReady then
                                chat.browser:sendAsync('translate', {
                                    name = senderName,
                                    original = msgBody,
                                    translated = displayText
                                }, NOOP)
                            end
                        end)
                        break
                    end
                end
            end
        end)
    else
        pushChatMsg(msgBody)
    end

    return true -- suppress vanilla chat
end)

