                            if driftStore then driftStore.driftBestDrift = entry.bestDrift end
                        end
                        if entry.driftCount and entry.driftCount > drift.driftCount then
                            drift.driftCount = entry.driftCount
                            drift._lastSubmitDriftCount = entry.driftCount
                            if driftStore then driftStore.driftDriftCount = entry.driftCount end
