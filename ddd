local function scanSkins()
    skinList = {}
    local cd = ac.getFolder(ac.FolderID.ContentCars)
    if not cd or cd == '' then skinScanned = true; return end
    local sd = cd .. '/' .. carId .. '/skins'
    pcall(function()
        local entries = io.scanDir(sd, '*')
        if entries then
            for _, fn in ipairs(entries) do
                local isDir = fn:sub(-1) == '/'
                if isDir then fn = fn:sub(1, -2) end
                local sp = sd .. '/' .. fn
                if isDir or io.dirExists(sp) then
                    local dn = fn:gsub('_', ' '); dn = dn:sub(1, 1):upper() .. dn:sub(2)
                    pcall(function()
                        local f = io.open(sp .. '/ui_skin.json', 'r')
                        if f then local j = JSON.parse(f:read('*all')); f:close()
                            if j and j.skinname and j.skinname ~= '' then dn = j.skinname end
                        end
                    end)
                    local pv, lv = '', ''
                    if io.fileExists(sp .. '/preview.jpg') then pv = sp .. '/preview.jpg'
                    elseif io.fileExists(sp .. '/preview.png') then pv = sp .. '/preview.png' end
                    if io.fileExists(sp .. '/livery.png') then lv = sp .. '/livery.png'
                    elseif io.fileExists(sp .. '/livery.jpg') then lv = sp .. '/livery.jpg' end
                    table.insert(skinList, { name = dn, folder = fn, path = sp, preview = pv, livery = lv })
                end
            end
        end
    end)
    table.sort(skinList, function(a, b) return a.folder < b.folder end)
    skinScanned = true
end

