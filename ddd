-- Start walking mode: grab camera, save car position, init at car location
local function walkStart()
    if walk.active then return end
    tuningCamStop() -- release tuning camera if active
    local cam = nil
    pcall(function() cam = ac.grabCamera('IDDL Walking Camera') end)
    if not cam then
        notify('Camera busy â€” cannot start walking')
        return
    end
    walk.cam = cam
    walk.active = true

    -- Save car return position
    local car = ac.getCar(myCarIndex)
    if car and car.position then
        walk.returnPos = car.position:clone()
        walk.returnDir = car.look:clone()
    end

    -- Initialize walk position at the driver's door (left side of car)
    if car and car.position then
        local carLook = car.look or vec3(0, 0, 1)
        local cfX, cfZ = carLook.x, carLook.z
        local cfLen = math.sqrt(cfX * cfX + cfZ * cfZ)
        if cfLen > 0.001 then cfX = cfX / cfLen; cfZ = cfZ / cfLen end
        -- Left side of car (driver door in LHD) = (cfZ, -cfX)
        local doorOffX = cfZ * 1.5
        local doorOffZ = -cfX * 1.5
        walk.pos = vec3(car.position.x + doorOffX, car.position.y + walk.eyeHeight, car.position.z + doorOffZ)
    else
        walk.pos = vec3(ac.getCameraPosition())
    end

    -- Initialize yaw/pitch from current camera direction
    local fwd = ac.getCameraForward()
    walk.yaw = math.atan2(fwd.x, fwd.z)
    walk.pitch = math.asin(math.max(-0.99, math.min(0.99, fwd.y)))

    -- Reset physics
    walk.velY = 0
    walk.onGround = false
    walk.bobTimer = 0
    walk.bobActive = 0
    walk.tiltSmooth = 0
    walk.breathTimer = 0
    walk.flashlight = false

    -- Raycast down to detect initial ground
    pcall(function()
        local dist = physics.raycastTrack(walk.pos, vec3(0, -1, 0), 50, walkGroundPoint, walkGroundNormal)
        if dist >= 0 then
            walk.groundY = walkGroundPoint.y
            walk.onGround = true
            walk.pos.y = walk.groundY + walk.eyeHeight
        end
    end)

    -- Hide player car driver
    pcall(function() ac.setDriverVisible(myCarIndex, false) end)

    notify('Walking mode ON  [' .. (keyCfg.walk.name or 'F8') .. ' to exit]')
end

-- Stop walking mode: release camera, optionally teleport car back
local function walkStop()
    if not walk.active then return end
    walk.active = false

    -- Release camera
    if walk.cam then
        pcall(function() walk.cam:dispose() end)
        walk.cam = nil
    end

    -- Restore driver visibility
    pcall(function() ac.setDriverVisible(myCarIndex, true) end)

    -- Destroy flashlight if active
    if walk.flashlightObj then
        pcall(function() walk.flashlightObj:dispose() end)
        walk.flashlightObj = nil
        walk.flashlight = false
    end

    notify('Walking mode OFF')
end

-- Toggle walking mode
local function walkToggle()
    if walk.active then walkStop() else walkStart() end
end

-- Update walking camera (called every frame from script.update)
local function updateWalkingCamera(dt)
    if not walk.active or not walk.cam or not walk.cam:active() then
        if walk.active then walkStop() end
        return
    end

    -- ===== MOUSE LOOK (disabled when IDDL menu open, window unfocused, or AC UI wants cursor) =====
    local md = vec2(0, 0)
    local windowFocused = true
    local uiWantsMouse = false
    pcall(function() windowFocused = ac.getSim().isWindowForeground end)
    pcall(function() uiWantsMouse = ac.getUI().wantCaptureMouse end)
    if not showPanel and windowFocused and not uiWantsMouse then
        pcall(function()
            md = ac.accessMouseDelta('camera', true, true) or vec2(0, 0)
        end)
        walk.yaw = walk.yaw - md.x * walk.mouseSens
        walk.pitch = math.max(-1.4, math.min(1.4, walk.pitch - md.y * walk.mouseSens))
    end

    -- ===== MOVEMENT INPUT =====
    local moveX, moveZ = 0, 0   -- local-space input (X = strafe, Z = forward)
    local sprinting = false
    local crouching = false

    -- WASD (key codes: W=0x57, A=0x41, S=0x53, D=0x44)
    pcall(function()
        if ac.isKeyDown(ac.KeyIndex.W) then moveZ = moveZ + 1 end
        if ac.isKeyDown(ac.KeyIndex.S) then moveZ = moveZ - 1 end
        if ac.isKeyDown(ac.KeyIndex.A) then moveX = moveX - 1 end
        if ac.isKeyDown(ac.KeyIndex.D) then moveX = moveX + 1 end
        sprinting = ac.isKeyDown(ac.KeyIndex.Shift)
        crouching = ac.isKeyDown(ac.KeyIndex.Control)
    end)

    -- Normalize diagonal movement
    local inputLen = math.sqrt(moveX * moveX + moveZ * moveZ)
    if inputLen > 1 then
        moveX = moveX / inputLen
        moveZ = moveZ / inputLen
        inputLen = 1
    end

    -- Choose speed
    local speed = walk.walkSpeed
    if sprinting and inputLen > 0 then speed = walk.sprintSpeed end
    if crouching then speed = walk.crouchSpeed end

    -- Eye height adjustments for crouching
    local targetEyeH = crouching and 1.10 or 1.70
    walk.eyeHeight = walk.eyeHeight + (targetEyeH - walk.eyeHeight) * math.min(1, dt * 10)

    -- Forward/right vectors (horizontal only, based on yaw)
    local fwdX = math.sin(walk.yaw)
    local fwdZ = math.cos(walk.yaw)
    local rightX = -fwdZ
    local rightZ = fwdX

    -- World-space horizontal movement
    local worldMoveX = (fwdX * moveZ + rightX * moveX) * speed * dt
    local worldMoveZ = (fwdZ * moveZ + rightZ * moveX) * speed * dt

    -- Save position before movement (for car collision blocking)
    local prevX, prevZ = walk.pos.x, walk.pos.z

    -- Apply horizontal movement
    walk.pos.x = walk.pos.x + worldMoveX
    walk.pos.z = walk.pos.z + worldMoveZ

    -- ===== CAR COLLISION (block movement â€” just stop, restore previous position) =====
    pcall(function()
        local sim = ac.getSim()
        local total = sim.carsCount or 0
        for ci = 0, total - 1 do
            local car = ac.getCar(ci)
            if car and car.position and car.isConnected then
                local carPos = car.position
                local clk = car.look or vec3(0, 0, 1)
                local cfX, cfZ = clk.x, clk.z
                local cfL = math.sqrt(cfX * cfX + cfZ * cfZ)
                if cfL > 0.001 then cfX = cfX / cfL; cfZ = cfZ / cfL end
                local crX, crZ = -cfZ, cfX
                local dx = walk.pos.x - carPos.x
                local dz = walk.pos.z - carPos.z
                local projFwd = dx * cfX + dz * cfZ
                local projRight = dx * crX + dz * crZ
                local halfLen = 2.3
                local halfWid = 1.0
                if math.abs(projFwd) < halfLen and math.abs(projRight) < halfWid then
                    walk.pos.x = prevX
                    walk.pos.z = prevZ
                    break
                end
            end
        end
    end)

    -- ===== GRAVITY & JUMP =====
    -- Jump (Space)
    pcall(function()
        if ac.isKeyDown(ac.KeyIndex.Space) and walk.onGround then
            walk.velY = walk.jumpVel
            walk.onGround = false
        end
    end)

    -- Apply gravity
    walk.velY = walk.velY - walk.gravity * dt
    walk.pos.y = walk.pos.y + walk.velY * dt

    -- Ground collision via raycast
    pcall(function()
        local rayStart = vec3(walk.pos.x, walk.pos.y + 2, walk.pos.z)
        local dist = physics.raycastTrack(rayStart, vec3(0, -1, 0), 100, walkGroundPoint, walkGroundNormal)
        if dist >= 0 then
            walk.groundY = walkGroundPoint.y
            local feetY = walk.pos.y - walk.eyeHeight
            if feetY <= walk.groundY + 0.05 then
                walk.pos.y = walk.groundY + walk.eyeHeight
                if walk.velY < 0 then walk.velY = 0 end
                walk.onGround = true
            else
                walk.onGround = false
            end
        else
            -- No ground found (void), apply gravity anyway
            walk.onGround = false
        end
    end)

    -- ===== HEAD BOB (only when moving forward/backward, not strafing) =====
    local forwardInput = math.abs(moveZ)
    local targetBobActive = (forwardInput > 0.3 and walk.onGround) and 1 or 0
    walk.bobActive = walk.bobActive + (targetBobActive - walk.bobActive) * math.min(1, dt * 6)

    if walk.bobActive > 0.01 then
        local bobSpeedMult = sprinting and 1.4 or (crouching and 0.6 or 1.0)
        walk.bobTimer = walk.bobTimer + dt * walk.bobFreq * bobSpeedMult
        local bobScale = walk.bobActive * (sprinting and 1.5 or 1.0)
        local bobY = math.sin(walk.bobTimer * 2) * walk.bobIntensity * bobScale
        local bobX = math.cos(walk.bobTimer) * walk.bobLateral * bobScale
        walk.pos.y = walk.pos.y + bobY
        -- Apply lateral bob to position
        walk.pos.x = walk.pos.x + rightX * bobX
        walk.pos.z = walk.pos.z + rightZ * bobX
    end

    -- ===== IDLE BREATHING (reduced 70%) =====
    if walk.bobActive < 0.1 then
        walk.breathTimer = walk.breathTimer + dt
        local breathY = math.sin(walk.breathTimer * 1.2) * 0.0012
        local breathP = math.sin(walk.breathTimer * 0.8) * 0.00024
        walk.pos.y = walk.pos.y + breathY
        walk.pitch = walk.pitch + breathP
    end

    -- ===== STRAFE TILT (disabled â€” was causing jitter) =====
    walk.tiltSmooth = 0

    -- ===== BUILD CAMERA MATRIX =====
    local cy, sy = math.cos(walk.yaw), math.sin(walk.yaw)
    local cp, sp = math.cos(walk.pitch), math.sin(walk.pitch)
    local ct, st = math.cos(walk.tiltSmooth), math.sin(walk.tiltSmooth)

    -- Forward direction
    local lookX = sy * cp
    local lookY = sp
    local lookZ = cy * cp

    -- Right direction (before tilt)
    local rX = cy
    local rY = 0
    local rZ = -sy

    -- Up direction = cross(right, forward) for correct orientation
    local upX = -(rY * lookZ - rZ * lookY)
    local upY = -(rZ * lookX - rX * lookZ)
    local upZ = -(rX * lookY - rY * lookX)

    -- Apply roll tilt
    local finalUpX = upX * ct + rX * st
    local finalUpY = upY * ct + rY * st
    local finalUpZ = upZ * ct + rZ * st
    local finalRX = rX * ct - upX * st
    local finalRY = rY * ct - upY * st
    local finalRZ = rZ * ct - upZ * st

    -- Set camera transform
    local t = walk.cam.transform
    t.side = vec3(finalRX, finalRY, finalRZ)
    t.up = vec3(finalUpX, finalUpY, finalUpZ)
    t.look = vec3(lookX, lookY, lookZ)
    t.position = vec3(walk.pos.x, walk.pos.y, walk.pos.z)

    walk.cam.fov = walk.fov
    walk.cam.ownShare = 1

    -- ===== FLASHLIGHT =====
    if walk.flashlight and not walk.flashlightObj then
        pcall(function()
            walk.flashlightObj = ac.LightSource(ac.LightType.Regular)
            walk.flashlightObj.color = rgb(1.0, 0.95, 0.85)
            walk.flashlightObj.range = 50
            walk.flashlightObj.rangeGradientOffset = 0.5
            walk.flashlightObj.spot = 22
            walk.flashlightObj.spotSharpness = 0.7
            walk.flashlightObj.specularMultiplier = 1
            walk.flashlightObj.singleFrequency = 0
            walk.flashlightObj.shadows = true
        end)
    end
    if walk.flashlightObj then
        walk.flashlightObj.position = walk.pos
        walk.flashlightObj.direction = vec3(lookX, lookY, lookZ)
        if not walk.flashlight then
            pcall(function() walk.flashlightObj:dispose() end)
            walk.flashlightObj = nil
        end
    end
end

