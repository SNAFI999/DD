    loopCount   = ac.StructItem.byte(),
    flags       = ac.StructItem.byte(),
}, function(sender, msg)
    -- Update ghostUI with real state from tandemghost
    ghostUI.loaded    = (msg.flags % 2) >= 1           -- bit0
    ghostUI.paused    = (math.floor(msg.flags / 2) % 2) >= 1  -- bit1
    ghostUI.enabled   = (math.floor(msg.flags / 4) % 2) >= 1  -- bit2
    ghostUI.loading   = (math.floor(msg.flags / 8) % 2) >= 1  -- bit3
    ghostUI.ghostCarId = msg.carId or ''
    ghostUI.totalTimeMs = msg.totalTimeMs or 0
