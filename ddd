----------------------------------------------------------------------
-- PRIVATE LOBBY COMMAND HANDLER (separate non-local function to avoid 200-local limit)
----------------------------------------------------------------------
function handlePvtLobbyCommand(cmd)
    local function decodeURI(s)
        if not s then return '' end
        return (s:gsub('%%(%x%x)', function(h) return string.char(tonumber(h, 16)) end))
    end
    local function refresh()
        local sid = 0
        pcall(function() sid = ac.getCar(myCarIndex).sessionID or 0 end)
        web.get(BASE_URL .. '/lobby/status?sessionId=' .. tostring(sid), function(err, resp)
            if err or not resp or not resp.body then return end
            -- Sync _inPrivateLobby from server (handles kick/dissolve by others)
            local ok2, data = pcall(JSON.parse, resp.body)
            if ok2 and data then
                if data.inLobby then
                    _inPrivateLobby = true
                else
                    _inPrivateLobby = false
                    _mapBucketAssigned = false
                end
            end
            if browser then
                browser:sendAsync('pvtlobby', resp.body, NOOP)
            end
        end)
        web.get(BASE_URL .. '/lobby/list', function(err, resp)
            if err or not resp or not resp.body then return end
            if browser then
                browser:sendAsync('pvtlobbyList', resp.body, NOOP)
            end
        end)
    end

    if cmd:sub(1, 16) == 'pvtlobby-create/' then
        local rest = cmd:sub(17)
        local parts = {}
        for p in rest:gmatch('[^/]+') do parts[#parts + 1] = p end
        local name = decodeURI(parts[1] or '')
        local pass = (parts[2] and parts[2] ~= '_NONE_') and decodeURI(parts[2]) or nil
        local max  = tonumber(parts[3]) or 4
        if name == '' then notify('Lobby name required'); return end
        local sid = 0
        pcall(function() sid = ac.getCar(myCarIndex).sessionID or 0 end)
        local body = '{"sessionId":' .. tostring(sid) .. ',"name":' .. jsonStr(name) .. ',"password":' .. (pass and jsonStr(pass) or 'null') .. ',"maxPlayers":' .. tostring(max) .. '}'
        web.post(BASE_URL .. '/lobby/create', { ['Content-Type'] = 'application/json' }, body, function(err, resp)
            if err then notify('Failed to create lobby'); return end
            if resp and resp.body then
                local ok, data = pcall(JSON.parse, resp.body)
                if ok and data and data.error then
                    notify('Error: ' .. tostring(data.error))
                elseif ok and data and data.inviteCode then
                    _inPrivateLobby = true
                    notify('Lobby created! Code: ' .. tostring(data.inviteCode))
                    refresh()
                end
            end
        end)

    elseif cmd:sub(1, 14) == 'pvtlobby-join/' then
        local rest = cmd:sub(15)
        local parts = {}
        for p in rest:gmatch('[^/]+') do parts[#parts + 1] = p end
        local code = decodeURI(parts[1] or '')
        local pass = (parts[2] and parts[2] ~= '_NONE_') and decodeURI(parts[2]) or nil
        if code == '' then notify('Invite code required'); return end
        local sid = 0
        pcall(function() sid = ac.getCar(myCarIndex).sessionID or 0 end)
        local body = '{"sessionId":' .. tostring(sid) .. ',"inviteCode":' .. jsonStr(code) .. ',"password":' .. (pass and jsonStr(pass) or 'null') .. '}'
        web.post(BASE_URL .. '/lobby/join', { ['Content-Type'] = 'application/json' }, body, function(err, resp)
            if err then notify('Failed to join lobby'); return end
            if resp and resp.body then
                local ok, data = pcall(JSON.parse, resp.body)
                if ok and data and data.error then
                    notify('Error: ' .. tostring(data.error))
                elseif ok and data and data.success then
                    _inPrivateLobby = true
                    notify('Joined lobby!')
                    refresh()
                end
            end
        end)

    elseif cmd == 'pvtlobby-leave' then
        local sid = 0
        pcall(function() sid = ac.getCar(myCarIndex).sessionID or 0 end)
        local body = '{"sessionId":' .. tostring(sid) .. '}'
        web.post(BASE_URL .. '/lobby/leave', { ['Content-Type'] = 'application/json' }, body, function(err, resp)
            if err then notify('Failed to leave lobby'); return end
            _inPrivateLobby = false
            _mapBucketAssigned = false  -- force re-assign map bucket on next detectCurrentMap
            notify('Left lobby')
            refresh()
        end)

    elseif cmd:sub(1, 18) == 'pvtlobby-dissolve/' then
        local bucketId = tonumber(cmd:sub(19)) or 0
        local sid = 0
        pcall(function() sid = ac.getCar(myCarIndex).sessionID or 0 end)
        local body = '{"sessionId":' .. tostring(sid) .. ',"bucketId":' .. tostring(bucketId) .. '}'
        web.post(BASE_URL .. '/lobby/dissolve', { ['Content-Type'] = 'application/json' }, body, function(err, resp)
            if err then notify('Failed to dissolve lobby'); return end
            _inPrivateLobby = false
            _mapBucketAssigned = false  -- force re-assign map bucket on next detectCurrentMap
            notify('Lobby dissolved')
            refresh()
        end)

    elseif cmd:sub(1, 14) == 'pvtlobby-kick/' then
        local targetSid = tonumber(cmd:sub(15)) or 0
        local sid = 0
        pcall(function() sid = ac.getCar(myCarIndex).sessionID or 0 end)
        local body = '{"sessionId":' .. tostring(sid) .. ',"targetSessionId":' .. tostring(targetSid) .. '}'
        web.post(BASE_URL .. '/lobby/kick', { ['Content-Type'] = 'application/json' }, body, function(err, resp)
            if err then notify('Failed to kick player'); return end
            if resp and resp.body then
                local ok, data = pcall(JSON.parse, resp.body)
                if ok and data and data.error then
                    notify('Error: ' .. tostring(data.error))
                else
                    notify('Player kicked')
                    refresh()
                end
            end
        end)

    elseif cmd:sub(1, 16) == 'pvtlobby-invite/' then
        local targetSid = tonumber(cmd:sub(17)) or 0
        local sid = 0
        pcall(function() sid = ac.getCar(myCarIndex).sessionID or 0 end)
        local body = '{"sessionId":' .. tostring(sid) .. ',"targetSessionId":' .. tostring(targetSid) .. '}'
        web.post(BASE_URL .. '/lobby/invite', { ['Content-Type'] = 'application/json' }, body, function(err, resp)
            if err then notify('Failed to invite player'); return end
            if resp and resp.body then
                local ok, data = pcall(JSON.parse, resp.body)
                if ok and data and data.error then
                    notify('Error: ' .. tostring(data.error))
                elseif ok and data and data.success then
                    notify('Invite sent!')
                end
            end
        end)

    elseif cmd == 'pvtlobby-refresh' then
        refresh()

    elseif cmd == 'pvtlobby-accept' then
        local sid = 0
        pcall(function() sid = ac.getCar(myCarIndex).sessionID or 0 end)
        INV.show = false
        INV.pendingInvite = nil
        local body = '{"sessionId":' .. tostring(sid) .. '}'
        web.post(BASE_URL .. '/lobby/accept-invite', { ['Content-Type'] = 'application/json' }, body, function(err, resp)
            if err then notify('Failed to accept invite'); return end
            if resp and resp.body then
                local ok, data = pcall(JSON.parse, resp.body)
                if ok and data and data.error then
                    notify('Error: ' .. tostring(data.error))
                else
                    notify('Joined lobby!')
                    refresh()
                end
            end
        end)

    elseif cmd == 'pvtlobby-decline' then
        local sid = 0
        pcall(function() sid = ac.getCar(myCarIndex).sessionID or 0 end)
        INV.show = false
        INV.pendingInvite = nil
        local body = '{"sessionId":' .. tostring(sid) .. '}'
        web.post(BASE_URL .. '/lobby/decline-invite', { ['Content-Type'] = 'application/json' }, body, function(err, resp)
            notify('Invite declined')
        end)

    elseif cmd == 'pvtlobby-checkinvite' then
        -- handled by Lua polling now, ignore from JS
    end
end

----------------------------------------------------------------------
-- BROWSER COMMAND HANDLER
----------------------------------------------------------------------
function handleBrowserCommand(cmd)
    if cmd == 'close' then
        showPanel = false
        tuningCamStop()
    elseif cmd:sub(1, 10) == 'clipboard/' then
        local text = cmd:sub(11)
        pcall(function() ac.setClipboardText(text) end)
    elseif cmd == 'kb-focus' then
        BR.wantsKbd = true
    elseif cmd == 'kb-blur' then
        BR.wantsKbd = false
    elseif cmd == 'ack-init' then
        -- Browser confirmed it received init data; stop retrying
        BR.acked = true
        BR.initSent = true
    elseif cmd == 'save-pos' then
        savePosition()
    elseif cmd == 'discord-link' then
        -- Open Discord OAuth directly in the in-game browser
        local pName = ac.getDriverName(myCarIndex) or 'Unknown'
        local enc = pName:gsub(' ', '%%20')
        local linkUrl = BASE_URL .. '/link?player=' .. enc
        if browser then
            browser:navigate(linkUrl)
            notify('Authorize with Discord...')
        else
            -- Fallback: open in system browser
            pcall(function() os.openURL(linkUrl, false) end)
            pcall(function() ac.setClipboardText(linkUrl) end)
            notify('Open URL from clipboard in your browser')
        end
    elseif cmd == 'teleport' then
        teleport()
    elseif cmd == 'default' then
        if equippedPerCar[myCarIndex] then
            for mk in pairs(equippedPerCar[myCarIndex]) do unequipMod(mk, myCarIndex) end
        end
        resetSkinForCar(myCarIndex)
        local myAnims = animStates[myCarIndex]
        if myAnims then
            for idx2, st2 in pairs(myAnims) do
                if st2.open then st2.open = false
                    if syncEvent then pcall(function() syncEvent({ action = 10, key = tostring(idx2) .. '|0' }) end) end
                end
            end
        end
        if syncEvent then pcall(function() syncEvent({ action = 6, key = '' }) end) end
        notify('Reset to default')
        pushEquippedToBrowser()
    elseif cmd == 'skin-reset' then
        resetSkinForCar(myCarIndex)
        if syncEvent then pcall(function() syncEvent({ action = 7, key = '' }) end) end
        pushEquippedToBrowser()
    elseif cmd:sub(1, 5) == 'skin/' then
        local folder = cmd:sub(6)
        applySkinToCar(myCarIndex, folder)
        if syncEvent then pcall(function() syncEvent({ action = 4, key = folder }) end) end
        pushEquippedToBrowser()
    elseif cmd:sub(1, 6) == 'color/' then
        local parts = {}
        for p in cmd:sub(7):gmatch('[^/]+') do parts[#parts + 1] = tonumber(p) end
        if #parts >= 3 then
            applyColorToCar(myCarIndex, parts[1], parts[2], parts[3])
            if syncEvent then pcall(function() syncEvent({ action = 5, key = string.format('%.3f|%.3f|%.3f', parts[1], parts[2], parts[3]) }) end) end
        end
    elseif cmd == 'color-reset' then
        colorPerCar[myCarIndex] = nil
        resetSkinPerInstance(myCarIndex)
        if syncEvent then pcall(function() syncEvent({ action = 5, key = '' }) end) end
        notify('Color reset')
    elseif cmd:sub(1, 9) == 'rimcolor/' then
        local parts = {}
        for p in cmd:sub(10):gmatch('[^/]+') do parts[#parts + 1] = tonumber(p) end
        if #parts >= 3 then
            applyColorToRims(myCarIndex, parts[1], parts[2], parts[3])
            if syncEvent then pcall(function() syncEvent({ action = 21, key = string.format('%.3f|%.3f|%.3f', parts[1], parts[2], parts[3]) }) end) end
        end
    elseif cmd == 'rimcolor-reset' then
        resetRimColor(myCarIndex)
        if syncEvent then pcall(function() syncEvent({ action = 21, key = '' }) end) end
    elseif cmd:sub(1, 15) == 'rimcolor-front/' then
        local parts = {}
        for p in cmd:sub(16):gmatch('[^/]+') do parts[#parts + 1] = tonumber(p) end
        if #parts >= 3 then
            applyColorToFrontRims(myCarIndex, parts[1], parts[2], parts[3])
            if syncEvent then pcall(function() syncEvent({ action = 22, key = string.format('%.3f|%.3f|%.3f', parts[1], parts[2], parts[3]) }) end) end
        end
    elseif cmd == 'rimcolor-front-reset' then
        resetFrontRimColor(myCarIndex)
        if syncEvent then pcall(function() syncEvent({ action = 22, key = '' }) end) end
    elseif cmd:sub(1, 14) == 'rimcolor-rear/' then
        local parts = {}
        for p in cmd:sub(15):gmatch('[^/]+') do parts[#parts + 1] = tonumber(p) end
        if #parts >= 3 then
            applyColorToRearRims(myCarIndex, parts[1], parts[2], parts[3])
            if syncEvent then pcall(function() syncEvent({ action = 23, key = string.format('%.3f|%.3f|%.3f', parts[1], parts[2], parts[3]) }) end) end
        end
    elseif cmd == 'rimcolor-rear-reset' then
        resetRearRimColor(myCarIndex)
        if syncEvent then pcall(function() syncEvent({ action = 23, key = '' }) end) end
    -- === NEON UNDERGLOW COMMANDS ===
    elseif cmd == 'neon-toggle' then
        neon.enabled = not neon.enabled
        if neon.enabled then
            neon:create()
            neon:updateColors()
            local dbg = #neon.lights .. 'L api=' .. tostring(neon.apiOk)
            pcall(function()
                local c = ac.getCar(myCarIndex)
                if c and c.position then
                    dbg = dbg .. ' pos=' .. string.format('%.1f,%.1f,%.1f', c.position.x, c.position.y, c.position.z)
                    dbg = dbg .. ' down=' .. tostring(neon.down) .. ' LEDs=' .. tostring(neon._count)
                end
            end)
            notify('Neon ON')
        else
            neon:destroy()
            notify('Neon OFF')
        end
        neon:save()
        if syncEvent then pcall(function() syncEvent({ action = 11, key = neon:encodeSyncKey() }) end) end
    elseif cmd:sub(1, 11) == 'neon-color/' then
        local parts = {}
        for p in cmd:sub(12):gmatch('[^/]+') do parts[#parts + 1] = tonumber(p) end
        if #parts >= 3 then
            neon.r = parts[1]
            neon.g = parts[2]
            neon.b = parts[3]
            neon._baseR = parts[1]; neon._baseG = parts[2]; neon._baseB = parts[3]
            if neon.enabled and neon.mode == 'none' then neon:updateColors() end
            neon:save()
            if syncEvent then pcall(function() syncEvent({ action = 11, key = neon:encodeSyncKey() }) end) end
        end
    elseif cmd:sub(1, 16) == 'neon-brightness/' then
        local val = tonumber(cmd:sub(17))
        if val then
            neon.brightness = math.max(0.5, math.min(10, val))
            if neon.enabled and neon.mode == 'none' then neon:updateColors() end
            neon:save()
            if syncEvent then pcall(function() syncEvent({ action = 11, key = neon:encodeSyncKey() }) end) end
        end
    elseif cmd:sub(1, 10) == 'neon-mode/' then
        local newMode = cmd:sub(11)
        if newMode == 'none' or newMode == 'pulse' or newMode == 'rgbcycle' or newMode == 'chase' or newMode == 'rgbchase' or newMode == 'rainbow' or newMode == 'police' or newMode == 'brake' or newMode == 'breathing' or newMode == 'strobe' or newMode == 'wave' or newMode == 'drift' or newMode == 'rpm' or newMode == 'music' or newMode == 'music_rainbow' or newMode == 'music_complement' or newMode == 'music_sparkle' or newMode == 'music_split' then
            -- If switching away from animated mode, restore base color
            if neon.mode ~= 'none' and newMode == 'none' then
                neon.r = neon._baseR; neon.g = neon._baseG; neon.b = neon._baseB
                if neon.enabled then neon:updateColors() end
            end
            neon.mode = newMode
            neon._modeTimer = 0
            neon:save()
            notify('Neon mode: ' .. newMode)
            if syncEvent then pcall(function() syncEvent({ action = 11, key = neon:encodeSyncKey() }) end) end
        end
    -- === NOS PURGE COMMANDS ===
    elseif cmd == 'purge-toggle' then
        purge.enabled = not purge.enabled
        pcall(function() if iddlStore then iddlStore.purgeEnabled = purge.enabled and 1 or 0 end end)
        notify('NOS Purge ' .. (purge.enabled and 'ON' or 'OFF') .. '  (hold U)')
    -- === FRONT LIGHTS COMMANDS ===
    elseif cmd == 'fl-toggle' then
        local fl = neon.front
        fl.enabled = not fl.enabled
        if fl.enabled then
            neon:createFront()
            neon:updateFrontColors()
            notify('Front Lights ON')
        else
            neon:destroyFront()
            notify('Front Lights OFF')
        end
        neon:saveFront()
        if syncEvent then pcall(function() syncEvent({ action = 14, key = neon:encodeFrontSyncKey() }) end) end
    elseif cmd:sub(1, 9) == 'fl-color/' then
        local parts = {}
        for p in cmd:sub(10):gmatch('[^/]+') do parts[#parts + 1] = tonumber(p) end
        if #parts >= 3 then
            local fl = neon.front
            fl.r = parts[1]; fl.g = parts[2]; fl.b = parts[3]
            fl._baseR = parts[1]; fl._baseG = parts[2]; fl._baseB = parts[3]
            if fl.enabled and fl.mode == 'none' then neon:updateFrontColors() end
            neon:saveFront()
            if syncEvent then pcall(function() syncEvent({ action = 14, key = neon:encodeFrontSyncKey() }) end) end
        end
    elseif cmd:sub(1, 14) == 'fl-brightness/' then
        local val = tonumber(cmd:sub(15))
        if val then
            neon.front.brightness = math.max(0.5, math.min(15, val))
            if neon.front.enabled and neon.front.mode == 'none' then neon:updateFrontColors() end
            neon:saveFront()
            if syncEvent then pcall(function() syncEvent({ action = 14, key = neon:encodeFrontSyncKey() }) end) end
        end
    elseif cmd:sub(1, 8) == 'fl-mode/' then
        local newMode = cmd:sub(9)
        if newMode == 'none' or newMode == 'rainbow' or newMode == 'police' or newMode == 'brake' or newMode == 'strobe' or newMode == 'wave' or newMode == 'music' then
            local fl = neon.front
            if fl.mode ~= 'none' and newMode == 'none' then
                fl.r = fl._baseR; fl.g = fl._baseG; fl.b = fl._baseB
                if fl.enabled then neon:updateFrontColors() end
            end
            fl.mode = newMode
            fl._modeTimer = 0
            neon:saveFront()
            notify('Front Lights mode: ' .. newMode)
            if syncEvent then pcall(function() syncEvent({ action = 14, key = neon:encodeFrontSyncKey() }) end) end
        end
    -- === SMOKE COLOR COMMANDS ===
    elseif cmd == 'smoke-toggle' then
        smokeColor.enabled = not smokeColor.enabled
        if smokeColor.enabled then
            smokeColor:createEmitter()
            notify('Smoke Color ON')
        else
            smokeColor:destroyEmitter()
            notify('Smoke Color OFF')
        end
        smokeColor:save()
        if syncEvent then pcall(function() syncEvent({ action = 31, key = smokeColor:encodeSyncKey() }) end) end
    elseif cmd:sub(1, 12) == 'smoke-color/' then
        local parts = {}
        for p in cmd:sub(13):gmatch('[^/]+') do parts[#parts + 1] = tonumber(p) end
        if #parts >= 3 then
            smokeColor.r = parts[1]; smokeColor.g = parts[2]; smokeColor.b = parts[3]
            smokeColor:updateEmitterColor()
            smokeColor:save()
            if syncEvent then pcall(function() syncEvent({ action = 31, key = smokeColor:encodeSyncKey() }) end) end
        end
    elseif cmd == 'smoke-reset' then
        smokeColor.enabled = false
        smokeColor.r = 0; smokeColor.g = 0; smokeColor.b = 0
        smokeColor.mode = 'none'; smokeColor._modeTimer = 0
        smokeColor._thickness = 0.50; smokeColor._life = 3.75; smokeColor._size = 0.24
        smokeColor._spreadK = 1.25; smokeColor._growK = 1.40; smokeColor._targetYVelocity = 0
        smokeColor._colorConsistency = 0.50; smokeColor._alpha = 0.50
        smokeColor._qtyMul = 1; smokeColor._emitVelY = 0.50
        smokeColor._arcSpread = 0.90; smokeColor._sideSpread = 0.40
        smokeColor._arcPts = 7; smokeColor._sidePts = 3
        smokeColor._slipThreshold = 6; smokeColor._speedThreshold = 10
        smokeColor._tempBoost = 0.60; smokeColor._slipRatioFactor = 0.90; smokeColor._heatRise = 0.35
        smokeColor._fadeIntensity = { [2] = 0, [3] = 0 }
        smokeColor:destroyEmitter()
        smokeColor:save()
        if syncEvent then pcall(function() syncEvent({ action = 31, key = '0' }) end) end
        notify('Smoke Color reset')
    elseif cmd:sub(1, 11) == 'smoke-mode/' then
        local newMode = cmd:sub(12)
        local validModes = { none=1, rainbow=1, police=1, drift=1, breathing=1, strobe=1 }
        if validModes[newMode] then
            smokeColor.mode = newMode
            smokeColor._modeTimer = 0
            smokeColor:save()
            notify('Smoke mode: ' .. newMode)
            if syncEvent then pcall(function() syncEvent({ action = 31, key = smokeColor:encodeSyncKey() }) end) end
        end
    elseif cmd:sub(1, 12) == 'smoke-param/' then
        local rest = cmd:sub(13)
        local pName, pVal = rest:match('([^/]+)/([%-%d%.]+)')
        if pName and pVal then
            local v = tonumber(pVal)
            if v then
                smokeColor:applyParam(pName, v)
            end
        end
    -- === LICENSE PLATE COMMANDS ===
    elseif cmd:sub(1, 11) == 'plate-text/' then
        local raw = cmd:sub(12)
        raw = raw:gsub('%%(%x%x)', function(h) return string.char(tonumber(h, 16)) end)
        raw = raw:gsub('[^A-Za-z0-9 %-]', ''):upper():sub(1, 9)
        if raw == '' then raw = 'IDDL' end
        plate.text = raw
        plate._dirty = true
        if plate._meshRef then plate:renderTexture() end
        plate:save()
        if syncEvent then pcall(function() syncEvent({ action = 30, key = plate.text .. '|' .. plate.bg .. '|' .. plate.tx }) end) end
    elseif cmd:sub(1, 9) == 'plate-bg/' then
        local raw = cmd:sub(10)
        raw = raw:gsub('%%(%x%x)', function(h) return string.char(tonumber(h, 16)) end)
        if raw:match('^#%x%x%x%x%x%x$') then
            plate.bg = raw
            plate._dirty = true
            if plate._meshRef then plate:renderTexture() end
            plate:save()
            if syncEvent then pcall(function() syncEvent({ action = 30, key = plate.text .. '|' .. plate.bg .. '|' .. plate.tx }) end) end
        end
    elseif cmd:sub(1, 9) == 'plate-tx/' then
        local raw = cmd:sub(10)
        raw = raw:gsub('%%(%x%x)', function(h) return string.char(tonumber(h, 16)) end)
        if raw:match('^#%x%x%x%x%x%x$') then
            plate.tx = raw
            plate._dirty = true
            if plate._meshRef then plate:renderTexture() end
            plate:save()
            if syncEvent then pcall(function() syncEvent({ action = 30, key = plate.text .. '|' .. plate.bg .. '|' .. plate.tx }) end) end
        end
    elseif cmd == 'plate-reset' then
        plate.text = 'IDDL'
        plate.bg = '#FFFFFF'
        plate.tx = '#000000'
        plate._dirty = true
        if plate._meshRef then plate:renderTexture() end
        plate:save()
        if syncEvent then pcall(function() syncEvent({ action = 30, key = plate.text .. '|' .. plate.bg .. '|' .. plate.tx }) end) end
    elseif cmd:sub(1, 6) == 'equip/' then
        local key = cmd:sub(7)
        key = key:gsub('%%(%x%x)', function(hex) return string.char(tonumber(hex, 16)) end)
        equipMod(key, myCarIndex)
        if syncEvent then pcall(function() syncEvent({ action = 1, key = key }) end) end
        pushEquippedToBrowser()
    elseif cmd:sub(1, 8) == 'unequip/' then
        local key = cmd:sub(9)
        key = key:gsub('%%(%x%x)', function(hex) return string.char(tonumber(hex, 16)) end)
        unequipMod(key, myCarIndex)
        if syncEvent then pcall(function() syncEvent({ action = 2, key = key }) end) end
        pushEquippedToBrowser()
    -- === TUNING CAMERA COMMANDS ===
    elseif cmd:sub(1, 13) == 'focus-preset/' then
        local presetName = cmd:sub(14):lower():gsub('_', ' ')
        local preset = tuningCamPresets[presetName]
        if preset and preset.fp then
            pcall(function()
                if walk.active then return end
                local localPos = vec3(preset.fp.x, preset.fp.y, preset.fp.z)
                local camLocalPos = vec3(preset.camOff.x, preset.camOff.y, preset.camOff.z)
                if not tuningCam.active then
                    if _menuLock.cam then
                        pcall(function() _menuLock.cam:dispose() end)
                        _menuLock.cam = nil
                    end
                    local cam = ac.grabCamera('IDDL Tuning Camera')
                    if not cam then return end
                    tuningCam.cam = cam
                    tuningCam.startPos = vec3(ac.getCameraPosition())
                    tuningCam.startLook = vec3(ac.getCameraForward())
                    tuningCam.fovStart = ac.getCameraFov and ac.getCameraFov() or 56
                    tuningCam.origPos = vec3(ac.getCameraPosition())
                    tuningCam.origLook = vec3(ac.getCameraForward())
                    tuningCam.origFov = tuningCam.fovStart
                else
                    tuningCam.startPos = vec3(tuningCam.cam.transform.position.x, tuningCam.cam.transform.position.y, tuningCam.cam.transform.position.z)
                    tuningCam.startLook = vec3(tuningCam.cam.transform.look.x, tuningCam.cam.transform.look.y, tuningCam.cam.transform.look.z)
                    tuningCam.fovStart = tuningCam.fov
                end
                tuningCam.localPos = localPos
                tuningCam.camLocalPos = camLocalPos
                tuningCam.fov = preset.fov
                tuningCam.lerpT = 0
                tuningCam.returning = false
                tuningCam.active = true
            end)
        end
    elseif cmd:sub(1, 10) == 'focus-mod/' then
        local modKey = cmd:sub(11)
        modKey = modKey:gsub('%%(%x%x)', function(hex) return string.char(tonumber(hex, 16)) end)
        pcall(function()
            if walk.active or not definitions then return end
            local md = definitions[modKey]
            if not md or not md.displayName then return end
            local dn = md.displayName:lower():gsub('_', ' ')
            local preset = tuningCamPresets[dn]
            if not preset then return end
            -- Use preset fp or fall back to node lookup
            local localPos
            if preset.fp then
                localPos = vec3(preset.fp.x, preset.fp.y, preset.fp.z)
            else
                if not md.placements or #md.placements == 0 then return end
                local an = md.placements[1].attachNode
                if not an then return end
                local cr = getCarRoot(myCarIndex)
                if not cr or #cr == 0 then return end
                local nr = cr:findNodes(an)
                if not nr or #nr == 0 then return end
                local mt2 = nil
                pcall(function() mt2 = nr:getTransformationRaw() end)
                if not mt2 then return end
                localPos = vec3(mt2.row4.x, mt2.row4.y, mt2.row4.z)
            end
            local camLocalPos = vec3(preset.camOff.x, preset.camOff.y, preset.camOff.z)
            if not preset.fp and localPos.x < -0.1 then camLocalPos.x = -camLocalPos.x end
            if not tuningCam.active then
                if _menuLock.cam then pcall(function() _menuLock.cam:dispose() end); _menuLock.cam = nil end
                local cam = ac.grabCamera('IDDL Tuning Camera')
                if not cam then return end
                tuningCam.cam = cam
                tuningCam.startPos = vec3(ac.getCameraPosition())
                tuningCam.startLook = vec3(ac.getCameraForward())
                tuningCam.fovStart = ac.getCameraFov and ac.getCameraFov() or 56
                tuningCam.origPos = vec3(ac.getCameraPosition())
