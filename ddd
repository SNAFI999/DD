-- Wall segments per map: wallData[mapIdx] = { {x1,z1,x2,z2}, ... }
wallData = {}
-- Spatial grid for fast lookup: wallGrid[mapIdx][cellKey] = { segIdx, ... }
wallGrid = {}
wallGridCell = 15  -- meters per grid cell (smaller = fewer segs per cell = faster)
wallDataLoaded = false
_wallCheckedBuf = {}  -- reusable buffer to avoid table alloc per call

-- Load wall JSON files from server data folder
function loadWallData()
    wallDataLoaded = true
    local mapNames = {
        'tamworth', 'brooklyn', 'sequoia', 'driftplayground',
        'fsdriftpark', 'sakana', 'watergrasshill', 'okish_flow', 'okishcircuit'
    }
    for mi = 1, #mapNames do
        local fname = mapNames[mi]
        local segs = {}
        -- Try to load from web (served by plugin)
        pcall(function()
            local url = BASE_URL .. '/iddl/walls_' .. fname .. '.json'
            web.get(url, function(err, resp)
                if err then return end
                if not resp or not resp.body or #resp.body < 10 then return end
                local ok, data = pcall(JSON.parse, resp.body)
                if not ok or type(data) ~= 'table' or not data.segments then return end
                local raw = data.segments
                local parsed = {}
                for i = 1, #raw do
                    local s = raw[i]
                    parsed[i] = { s.x1, s.z1, s.x2, s.z2 }
                end
                wallData[mi] = parsed
                -- Build spatial grid
                local grid = {}
                local cs = wallGridCell
                for si = 1, #parsed do
                    local seg = parsed[si]
                    local minX = math.min(seg[1], seg[3])
                    local maxX = math.max(seg[1], seg[3])
                    local minZ = math.min(seg[2], seg[4])
                    local maxZ = math.max(seg[2], seg[4])
                    local gx0 = math.floor(minX / cs)
                    local gx1 = math.floor(maxX / cs)
                    local gz0 = math.floor(minZ / cs)
                    local gz1 = math.floor(maxZ / cs)
                    for gx = gx0, gx1 do
                        for gz = gz0, gz1 do
                            local key = gx * 100000 + gz
                            if not grid[key] then grid[key] = {} end
                            grid[key][#grid[key] + 1] = si
                        end
                    end
                end
                wallGrid[mi] = grid
            end)
        end)
    end
end

-- Point-to-segment squared distance (2D: XZ plane) — returns SQUARED distance for speed
-- Only take sqrt at the end when comparing final result
function wallSegDistSq(px, pz, x1, z1, x2, z2)
    local dx = x2 - x1
    local dz = z2 - z1
    local lenSq = dx * dx + dz * dz
    local ex, ez
    if lenSq < 0.001 then
        ex = px - x1; ez = pz - z1
    else
        local t = ((px - x1) * dx + (pz - z1) * dz) / lenSq
        if t < 0 then t = 0 elseif t > 1 then t = 1 end
        ex = px - (x1 + t * dx)
        ez = pz - (z1 + t * dz)
    end
    return ex * ex + ez * ez
end

-- Find minimum distance to any wall segment near (px, pz) for map mapIdx
-- Uses spatial grid: only checks segments in nearby cells
function wallMinDist(px, pz, mapIdx, maxDist)
    local segs = wallData[mapIdx]
    if not segs then return maxDist end
    local grid = wallGrid[mapIdx]
    if not grid then return maxDist end
    local cs = wallGridCell
    local gx = math.floor(px / cs)
    local gz = math.floor(pz / cs)
    local bestSq = maxDist * maxDist
    for ox = -1, 1 do
        for oz = -1, 1 do
            local cell = grid[(gx + ox) * 100000 + (gz + oz)]
            if cell then
                for ci = 1, #cell do
                    local s = segs[cell[ci]]
                    local dsq = wallSegDistSq(px, pz, s[1], s[2], s[3], s[4])
                    if dsq < bestSq then bestSq = dsq end
                end
            end
        end
    end
    return math.sqrt(bestSq)
end

-- Same as wallMinDist but also returns the closest point on the wall segment
function wallMinDistWithPoint(px, pz, mapIdx, maxDist)
    local segs = wallData[mapIdx]
    if not segs then return maxDist, px, pz end
    local grid = wallGrid[mapIdx]
    if not grid then return maxDist, px, pz end
    local cs = wallGridCell
    local gx = math.floor(px / cs)
    local gz = math.floor(pz / cs)
    local bestSq = maxDist * maxDist
    local bestWx, bestWz = px, pz
    for ox = -1, 1 do
        for oz = -1, 1 do
            local cell = grid[(gx + ox) * 100000 + (gz + oz)]
            if cell then
                for ci = 1, #cell do
                    local s = segs[cell[ci]]
                    local x1, z1, x2, z2 = s[1], s[2], s[3], s[4]
                    local dx = x2 - x1
                    local dz = z2 - z1
                    local lenSq = dx * dx + dz * dz
                    local wx, wz
                    if lenSq < 0.001 then
                        wx, wz = x1, z1
                    else
                        local t = ((px - x1) * dx + (pz - z1) * dz) / lenSq
                        if t < 0 then t = 0 elseif t > 1 then t = 1 end
                        wx = x1 + t * dx
                        wz = z1 + t * dz
                    end
                    local ex, ez = px - wx, pz - wz
                    local dsq = ex * ex + ez * ez
                    if dsq < bestSq then
                        bestSq = dsq
                        bestWx, bestWz = wx, wz
                    end
                end
            end
        end
    end
    return math.sqrt(bestSq), bestWx, bestWz
end

-- Directional wall distance: find closest wall in a specific direction from point
-- Only counts segments whose center is in the given direction (dot > 0)
-- Optimized: reuses buffer, works with squared distances, early exit
function wallDirDist(px, pz, dirX, dirZ, mapIdx, maxDist)
    local segs = wallData[mapIdx]
    if not segs then return maxDist end
    local grid = wallGrid[mapIdx]
    if not grid then return maxDist end
    local cs = wallGridCell
    local bestSq = maxDist * maxDist
    -- Reuse checked buffer (clear by incrementing generation counter)
    local checked = _wallCheckedBuf
    local gx0 = math.floor(px / cs)
    local gz0 = math.floor(pz / cs)
    -- Only check 3x3 around car — with 15m cells this covers 45m which is plenty for maxDist=5
    for ox = -1, 1 do
        for oz = -1, 1 do
            local cell = grid[(gx0 + ox) * 100000 + (gz0 + oz)]
            if cell then
                for ci = 1, #cell do
                    local s = segs[cell[ci]]
                    -- Direction check first (cheap): is segment center behind the car rear?
                    local tox = (s[1] + s[3]) * 0.5 - px
                    local toz = (s[2] + s[4]) * 0.5 - pz
                    if tox * dirX + toz * dirZ > 0 then
                        local dsq = wallSegDistSq(px, pz, s[1], s[2], s[3], s[4])
                        if dsq < bestSq then bestSq = dsq end
                    end
                end
            end
        end
    end
    return math.sqrt(bestSq)
end


