                        local b = '{"name":' .. _esc(myN) .. ',"message":' .. _esc(txt) .. '}'
                        web.post(BASE_URL .. '/players/chat-relay', { ['Content-Type'] = 'application/json' }, b, NOOP)
                    end)
                end
                if outLang > 0 and TRANS.langs[outLang] then
                    TRANS.translate(msg, outLang, function(translated)
                        _relayChatMsg(translated)
                    end)
                else
                    _relayChatMsg(msg)
                end
            end
            return
        end
