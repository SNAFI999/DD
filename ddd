local function le32(n) n = math.floor(n); return string.char(n % 256, math.floor(n / 256) % 256, math.floor(n / 65536) % 256, math.floor(n / 16777216) % 256) end
local function le16(n) n = math.floor(n); return string.char(n % 256, math.floor(n / 256) % 256) end

local colorTempDir = nil
local function getColorDir()
    if colorTempDir then return colorTempDir end
    local r = ac.getFolder(ac.FolderID.Root) or ''
    if r == '' then r = IDDL_CFG.acRoot end
    local base = r .. '/cache/iddl_colors'
    -- try to create dir with every known method
    local ok = false
    pcall(function() io.createDir(base); ok = true end)
    if not ok then pcall(function() os.execute('mkdir "' .. base:gsub('/','\\') .. '"'); ok = true end) end
    -- test if it actually works by writing a probe file
    local probe = base .. '/_probe.tmp'
    local pf = io.open(probe, 'wb')
    if pf then pf:close(); pcall(function() os.remove(probe) end); colorTempDir = base
    else
        colorTempDir = r .. '/cache'
    end
    return colorTempDir
end

local function createBMP(path, r, g, b)
    local w, h = 4, 4; local ds = w * 3 * h; local fs = 54 + ds
    local br = math.floor(clamp(b, 0, 1) * 255)
    local bg = math.floor(clamp(g, 0, 1) * 255)
    local bk = math.floor(clamp(r, 0, 1) * 255)
    local hdr = 'BM' .. le32(fs) .. le32(0) .. le32(54) .. le32(40) .. le32(w) .. le32(h) .. le16(1) .. le16(24) .. le32(0) .. le32(ds) .. le32(2835) .. le32(2835) .. le32(0) .. le32(0)
    local px = string.char(br, bg, bk); local row = px:rep(w)
    local f = io.open(path, 'wb'); if not f then return false end
    f:write(hdr); for _ = 1, h do f:write(row) end; f:close(); return true
end

