-- Gamepad button state cache (refreshed every 3 frames to save CPU — ac.isGamepadButtonPressed is slow)
local _gpCache = {}      -- [btn] = true/false
local _gpCacheFrame = 0  -- frame counter for throttling
local _gpActiveIdx = nil -- detected active gamepad index (0-7), nil = scan all

local function _refreshGpCache()
    local pressed = {}
    -- If we know the active gamepad, only scan that one
    if _gpActiveIdx then
        for _, btn in ipairs(allGpButtons) do
            if ac.isGamepadButtonPressed(_gpActiveIdx, btn) then
                pressed[btn] = true
            end
        end
    else
        -- First detection: scan all 8 pads, remember which one responds
        for gi = 0, 7 do
            for _, btn in ipairs(allGpButtons) do
                if ac.isGamepadButtonPressed(gi, btn) then
                    pressed[btn] = true
                    _gpActiveIdx = gi
                end
            end
        end
    end
    _gpCache = pressed
end

local function isGpPressed(btn)
    if not btn or btn == 0 then return false end
    return _gpCache[btn] or false
