-- LICENSE PLATE (dynamic text via ExtraCanvas)
-- NOTE: not 'local' — main chunk is at the 200-local Lua limit
----------------------------------------------------------------------
plate = {
    text = 'IDDL',
    bg = '#FFFFFF',
    tx = '#000000',
    _canvas = nil,   -- ui.ExtraCanvas for dynamic diffuse texture
    _meshRef = nil,   -- current plate mesh reference
    _texSlot = 'txDiffuse',
    _dirty = true,    -- needs re-render
}

function plate:hexToRgb(hex)
    hex = hex:gsub('#', '')
    local r = tonumber(hex:sub(1, 2), 16) / 255
    local g = tonumber(hex:sub(3, 4), 16) / 255
    local b = tonumber(hex:sub(5, 6), 16) / 255
    return r, g, b
end

function plate:save()
    pcall(function()
        if iddlStore then
            iddlStore.plateText = self.text
            iddlStore.plateBg = self.bg
            iddlStore.plateTx = self.tx
        end
    end)
end

function plate:renderTexture()
    if not self._meshRef or not self._canvas then return end
    local bgR, bgG, bgB = self:hexToRgb(self.bg)
    local txR, txG, txB = self:hexToRgb(self.tx)
    local text = self.text or 'IDDL'
    local sz = 320
    local font = ui.DWriteFont('Segoe UI')
    local W, H = 2048, 512
    local spacing = 36  -- extra pixels between characters
    -- Measure each character and total width with spacing
    local charWidths = {}
    local totalW = 0
    self._canvas:update(function(dt)
        ui.pushDWriteFont(font)
        for i = 1, #text do
            local ch = text:sub(i, i)
            local ms = ui.measureDWriteText(ch, sz)
            charWidths[i] = ms.x
            totalW = totalW + ms.x
        end
        ui.popDWriteFont()
    end)
    totalW = totalW + spacing * (#text - 1)
    local textH = 0
    self._canvas:update(function(dt)
        ui.pushDWriteFont(font)
        textH = ui.measureDWriteText('M', sz).y
        ui.popDWriteFont()
    end)
    local startX = (W - totalW) / 2
    local cy = (H - textH) / 2

    -- Helper: draw all chars at offset
    local function drawChars(canvas, offX, offY, col)
        canvas:update(function(dt)
            ui.pushDWriteFont(font)
            local x = startX + offX
            for i = 1, #text do
                local ch = text:sub(i, i)
                ui.dwriteDrawText(ch, sz, vec2(x, cy + offY), col)
                x = x + charWidths[i] + spacing
            end
            ui.popDWriteFont()
        end)
    end

    -- Diffuse: bold text (multi-pass for thickness)
    self._canvas:clear(rgbm(bgR, bgG, bgB, 1))
    local col = rgbm(txR, txG, txB, 1)
    for ox = -5, 5 do
        for oy = -5, 5 do
            drawChars(self._canvas, ox, oy, col)
        end
    end
    self._meshRef:setMaterialTexture(self._texSlot, self._canvas)

    -- Normal map: raised/embossed text bevel (8-direction symmetric)
    if not self._normalCanvas then
        self._normalCanvas = ui.ExtraCanvas(vec2(W, H), 4)
    end
    local flatN = rgbm(0.5, 0.5, 1.0, 1)
    local bev = 16
    local d = 0.7071 * bev
    self._normalCanvas:clear(flatN)
    drawChars(self._normalCanvas, -bev, 0, rgbm(0.15, 0.5, 1.0, 1))
    drawChars(self._normalCanvas, bev, 0, rgbm(0.85, 0.5, 1.0, 1))
    drawChars(self._normalCanvas, 0, -bev, rgbm(0.5, 0.85, 1.0, 1))
    drawChars(self._normalCanvas, 0, bev, rgbm(0.5, 0.15, 1.0, 1))
    drawChars(self._normalCanvas, -d, -d, rgbm(0.15, 0.85, 1.0, 1))
    drawChars(self._normalCanvas, d, -d, rgbm(0.85, 0.85, 1.0, 1))
    drawChars(self._normalCanvas, -d, d, rgbm(0.15, 0.15, 1.0, 1))
    drawChars(self._normalCanvas, d, d, rgbm(0.85, 0.15, 1.0, 1))
    drawChars(self._normalCanvas, 0, 0, flatN)
    self._meshRef:setMaterialTexture('txNormal', self._normalCanvas)
    self._dirty = false
end

function plate:applyToMesh(meshRef, texSlot)
    self._meshRef = meshRef
    self._texSlot = texSlot or 'txDiffuse'
    if not self._canvas then
        self._canvas = ui.ExtraCanvas(vec2(2048, 512), 4)
    end
    if meshRef and #meshRef > 0 then
        meshRef:ensureUniqueMaterials()
        self._dirty = true
        self:renderTexture()
    end
    pcall(function() if browser and BR.ready then browser:sendAsync('plateAvail', { available = true }, NOOP) end end)
end

function plate:detach()
    self._meshRef = nil
    pcall(function() if browser and BR.ready then browser:sendAsync('plateAvail', { available = false }, NOOP) end end)
end

