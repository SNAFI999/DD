-- Wall proximity: math-based using loaded wall JSON segments (zero raycast)
-- Measures from 4 corners of car body (bumper edges) instead of center
-- Stores line endpoint data for 3D indicator rendering
_wallLineFrom = nil  -- vec3: nearest corner world pos
_wallLineTo = nil    -- vec3: nearest wall point world pos
-- Pre-allocated corner buffers (avoid 4-table + 8-field alloc every frame)
_wpCorners = {
    { x = 0, z = 0 }, { x = 0, z = 0 },
    { x = 0, z = 0 }, { x = 0, z = 0 },
}
-- Pre-allocated vec3 for line endpoints (avoid vec3() alloc every frame)
_wpLineFrom = vec3()
_wpLineTo = vec3()
local function updateWallProximity(car)
    if not wallDataLoaded then loadWallData() end
    local pos = car.position
    if not pos then return end
    local look = car.look
    local side = car.side
    if not look or not side then return end
    local maxDist = 5

    -- Car half-dimensions (approximate for drift cars)
    local halfLen = 2.2  -- front/rear from center
    local halfWid = 0.9  -- left/right from center

    -- 4 corner points (XZ only): FL, FR, RL, RR — reuse pre-allocated tables
    local lx, lz = look.x, look.z
    local sx, sz = side.x, side.z
    local px, pz = pos.x, pos.z
    _wpCorners[1].x = px + lx * halfLen - sx * halfWid; _wpCorners[1].z = pz + lz * halfLen - sz * halfWid
    _wpCorners[2].x = px + lx * halfLen + sx * halfWid; _wpCorners[2].z = pz + lz * halfLen + sz * halfWid
    _wpCorners[3].x = px - lx * halfLen - sx * halfWid; _wpCorners[3].z = pz - lz * halfLen - sz * halfWid
    _wpCorners[4].x = px - lx * halfLen + sx * halfWid; _wpCorners[4].z = pz - lz * halfLen + sz * halfWid

    -- Find closest corner→wall pair
    local bestDist = maxDist
    local bestCorner, bestWx, bestWz = nil, nil, nil
    for i = 1, 4 do
        local c = _wpCorners[i]
        local d, wx, wz = wallMinDistWithPoint(c.x, c.z, currentMapIdx, maxDist)
        if d < bestDist then
            bestDist = d
            bestCorner = c
            bestWx, bestWz = wx, wz
        end
    end

    drift.wallDistLeft = bestDist
    drift.wallDistRight = bestDist

    -- Store 3D line endpoints for rendering (Y = car height)
    local y = pos.y + 0.3
    if bestCorner and bestDist < 3.0 then
        _wpLineFrom.x = bestCorner.x; _wpLineFrom.y = y; _wpLineFrom.z = bestCorner.z
        _wpLineTo.x = bestWx; _wpLineTo.y = y; _wpLineTo.z = bestWz
        _wallLineFrom = _wpLineFrom
        _wallLineTo = _wpLineTo
    else
        _wallLineFrom = nil
        _wallLineTo = nil
    end
end

-- Calculate wall proximity multiplier
-- Progressive: 1.0m→0.3m = x1→x6 (linear)
local function calcWallProximityMult()
    local minDist = math.min(drift.wallDistLeft, drift.wallDistRight)
    drift.isClipping = false
    -- Too far = no bonus
    if minDist >= 1.0 then return 1.0 end
    -- Below 0.3m = capped at x6
    if minDist <= 0.3 then
        drift.isClipping = true
        return 6.0
    end
    -- 1.0m→0.3m = x1→x6 (linear)
    drift.isClipping = true
    local t = (1.0 - minDist) / (1.0 - 0.3)
    local mult = 1 + t * 5
    return math.ceil(mult * 10) / 10
end

-- Improved tandem: detect nearby drifters, lead vs chase, angle match
-- Uses velocity vs look to calc drift angle (wheel data unavailable for remote cars)
local function getTandemInfo(car)
    local myPos = car.position
    local myLook = car.look or vec3(0, 0, 1)
    local mySide = car.side or vec3(1, 0, 0)
    local myAngle = drift.angle
    local sim = ac.getSim()
    local total = sim.carsCount or 0
    local bestDist = 9999
    local bestIdx = -1
    local bestOtherAngle = 0
    local bestOtherLook = nil
    local bestOtherPos = nil

    -- Door points for distance measurement (sides of car, not center)
    local halfWid = 0.9
    local myDoorL = vec3(myPos.x - mySide.x * halfWid, myPos.y, myPos.z - mySide.z * halfWid)
    local myDoorR = vec3(myPos.x + mySide.x * halfWid, myPos.y, myPos.z + mySide.z * halfWid)

    for i = 0, total - 1 do
        pcall(function()
            if i ~= myCarIndex then
                local other = ac.getCar(i)
                if other and other.isConnected and not other.isInPit and not other.isInPitlane then
                    local otherPos = other.position
                    local otherSide = other.side or vec3(1, 0, 0)
                    -- Other car door points
                    local oDoorL = vec3(otherPos.x - otherSide.x * halfWid, otherPos.y, otherPos.z - otherSide.z * halfWid)
                    local oDoorR = vec3(otherPos.x + otherSide.x * halfWid, otherPos.y, otherPos.z + otherSide.z * halfWid)
                    -- Min distance between any pair of door points
                    local d1 = myDoorL:distance(oDoorL)
                    local d2 = myDoorL:distance(oDoorR)
                    local d3 = myDoorR:distance(oDoorL)
                    local d4 = myDoorR:distance(oDoorR)
                    local dist = math.min(d1, d2, d3, d4)
                    if dist < bestDist then
                        bestDist = dist
                        bestIdx = i
                        -- Calculate drift angle from velocity vs look (works for remote cars)
                        local oa = 0
                        local vel = other.velocity
                        local olook = other.look
                        if vel and olook then
                            local spd = math.sqrt(vel.x * vel.x + vel.z * vel.z)
                            if spd > 2 then
                                local vx, vz = vel.x / spd, vel.z / spd
                                local dot = vx * olook.x + vz * olook.z
                                dot = math.max(-1, math.min(1, dot))
                                oa = math.deg(math.acos(dot))
                            end
                        end
                        bestOtherAngle = oa
                        bestOtherLook = other.look
                        bestOtherPos = other.position
                    end
                end
            end
        end)
    end

    drift.tandemDist = bestDist
    drift.tandemNearIdx = bestIdx
    drift.nearestCarDist = bestDist

    if bestDist > 12 or bestIdx < 0 then
        drift.tandemRole = ''
        drift.tandemAngleMatch = 0
        return
    end

    local otherDrifting = bestOtherAngle > 8 and bestDist < 12
    if not otherDrifting or myAngle < 8 then
        drift.tandemRole = ''
        drift.tandemAngleMatch = 0
        return
    end

    -- Determine lead vs chase
    if bestOtherPos then
        local toOther = vec3(bestOtherPos.x - myPos.x, 0, bestOtherPos.z - myPos.z)
        local dot = myLook.x * toOther.x + myLook.z * toOther.z
        drift.tandemRole = dot > 0 and 'chase' or 'lead'
    end

    local maxA = math.max(myAngle, bestOtherAngle, 1)
    local minA = math.min(myAngle, bestOtherAngle)
    drift.tandemAngleMatch = math.min(1, minA / maxA)
end

-- Calculate tandem multiplier (inversely proportional to distance)
local function calcTandemMult()
    local dist = drift.tandemDist
    if dist > 12 or drift.tandemRole == '' then return 1.0 end
    -- Inversely proportional: closer = massive bonus (max 8x)
    local baseMult = 1.0
    if dist < 1 then
        baseMult = 8.0       -- bumper-to-bumper: max
    else
        baseMult = 1.0 + 7.0 / math.max(dist, 0.5)
    end
    baseMult = math.min(8.0, baseMult)
    -- Angle match bonus
    baseMult = baseMult + drift.tandemAngleMatch * 0.4
    -- Chase bonus (chase is harder than lead)
    if drift.tandemRole == 'chase' then baseMult = baseMult * 1.35 end
    return baseMult
end

-- Collision detection via speed delta (deceleration spike)
-- Checks brake input to avoid false positives from hard braking
-- Checks vertical velocity to avoid false positives from bumps/jumps/landings
local function detectCollision(car, dt)
    local speedMs = math.abs(car.speedKmh or 0) / 3.6
    local prevMs = drift.prevSpeedMs
    drift.prevSpeedMs = speedMs
    if prevMs < 2 then return false end
    if dt <= 0 then return false end

    -- Filter out airborne: check vertical velocity
    local vel = car.velocity
    if vel then
        local vy = math.abs(vel.y or 0)
        if vy > 2.5 then return false end -- car is airborne/landing (>2.5 m/s vertical)
    end

    local decel = (prevMs - speedMs) / dt
    -- Filter out braking: heavy brake = never collision, light brake = very high threshold
    local brk = car.brake or 0
    local hbrk = car.handbrake or 0
    if brk > 0.5 or hbrk > 0.5 then return false end
    local isBraking = brk > 0.1 or hbrk > 0.1
    local threshold = isBraking and 120 or 15
    if decel > threshold and prevMs > 3 then
        local now = os.clock()
        if now - drift.lastCollisionTime > 1.0 then
            drift.lastCollisionTime = now
            drift.collisionCount = drift.collisionCount + 1
            drift.lastCollisionForce = math.min(1, (decel - threshold) / 15)
            return true
        end
    end
    return false
end

-- Spin detection: detect ACTUAL spinout (loss of control)
-- NOT triggered by: reverse entries, 360 transitions, intentional rotation
-- ONLY triggered by: high angle + speed dropping + low throttle = car spinning out
local function detectSpin(car, dt)
    if dt <= 0 then return false end
    local look = car.look
    if not look then return false end
    local yaw = math.atan2(look.x, look.z) * (180 / math.pi)
    local yawDelta = yaw - drift.prevYaw
    drift.prevYaw = yaw
    if yawDelta > 180 then yawDelta = yawDelta - 360
    elseif yawDelta < -180 then yawDelta = yawDelta + 360 end
    local yawRate = math.abs(yawDelta) / dt
    -- Ring buffer: overwrite oldest sample instead of table.insert + table.remove(1)
    if not drift._yawRingIdx then drift._yawRingIdx = 0 end
    drift._yawRingIdx = drift._yawRingIdx % 10 + 1
    drift._yawSamples[drift._yawRingIdx] = yawRate
    local avgYawRate = 0
    local sampleCount = math.min(10, #drift._yawSamples)
    for si = 1, sampleCount do avgYawRate = avgYawRate + drift._yawSamples[si] end
    avgYawRate = avgYawRate / math.max(1, sampleCount)
    drift.yawRate = avgYawRate
    if drift.inDrift then
        drift.yawAccum = drift.yawAccum + math.abs(yawDelta)
    end
    local speed = drift.speed
    local throttle = car.gas or 0
    local speedMs = speed / 3.6
    local prevSpdMs = drift.prevSpeedMs or speedMs
    local speedDrop = prevSpdMs - speedMs
    if speed > 5 then
        -- Spinout: angle > 90 + speed dropping below 15 km/h
        local isHighAngle = drift.angle > 90
        local isSpinning = avgYawRate > 150
        local isLosingSpeed = speed < 15
        local isLowThrottle = throttle < 0.25
        if isHighAngle and isSpinning and (isLosingSpeed or isLowThrottle) then
            return true
        end
        -- Stall: high angle + nearly stopped while drifting
        if drift.angle > 90 and speed < 15 and drift.inDrift then
            return true
        end
    end
    return false
end


local function updateDrift(dt, car)
    if not car then return end
    drift.sessionTime = drift.sessionTime + dt

    -- Accumulate total play time and save periodically
    drift.totalPlayTime = (drift.totalPlayTime or 0) + dt
    drift._playTimeSaveTimer = (drift._playTimeSaveTimer or 0) + dt
    if drift._playTimeSaveTimer > 30 and driftStore then
        driftStore.driftTotalPlayTime = math.floor(drift.totalPlayTime)
        driftStore.driftCumulativeScore = math.floor(drift.cumulativeScore)
        driftStore.driftTotalScore = math.floor(drift.totalScore)
        driftStore.driftDriftCount = drift.driftCount
        driftStore.driftCollisionCount = drift.collisionCount
        driftStore.driftSpinCount = drift.spinCount
        drift._playTimeSaveTimer = 0
    end
    drift.updatesTimer = drift.updatesTimer + 1

    local speed = math.abs(car.speedKmh or 0)
    drift.speed = speed
    if speed > drift.topSpeed then drift.topSpeed = speed end

    -- Angle from rear wheel slip angles (Damgam method)
    local angle = 0
    local wheels = car.wheels
    if wheels then
        local s2 = wheels[2] and wheels[2].slipAngle or 0
        local s3 = wheels[3] and wheels[3].slipAngle or 0
        angle = math.max(0, math.max(math.abs(s2), math.abs(s3)))
        -- Direction: sign of average rear slip → which side car is drifting
        local avgSlip = (s2 + s3) * 0.5
        drift.driftDir = avgSlip >= 0 and 1 or -1
    end
    -- If driving backwards, flip angle
    local lv = car.localVelocity
    if lv and lv.z <= 0 and speed > 1 then
        angle = 180 - angle
    end
    drift.angle = angle
    if angle > drift.bestAngle then drift.bestAngle = angle end

    -- Dirt / off-track detection
    local dirt = 0
    if wheels then
        local d0 = wheels[0] and math.abs(wheels[0].surfaceDirt or 0) or 0
        local d1 = wheels[1] and math.abs(wheels[1].surfaceDirt or 0) or 0
        local d2 = wheels[2] and math.abs(wheels[2].surfaceDirt or 0) or 0
        local d3 = wheels[3] and math.abs(wheels[3].surfaceDirt or 0) or 0
        dirt = math.min(d0, d1, d2, d3)
    end
    local wheelsOut = car.wheelsOutside or 0

    -- Spline position (for lap scoring / backwards detection)
    local splinePos = car.splinePosition or 0
    local lapTimeMs = car.lapTimeMs or 0

    -- Brake / handbrake
    local brakeInput = car.brake or 0
    local handbrakeInput = car.handbrake or 0

    -- === WALL PROXIMITY (math-based, every frame for smooth display) ===
    drift._lastWheelsOut = wheelsOut
    pcall(function() updateWallProximity(car) end)
    drift.wallProximityMult = calcWallProximityMult()

    -- === COLLISION DETECTION ===
    drift.isCollision = false
    drift.isRammed = false
    drift.collisionFlash = math.max(0, drift.collisionFlash - dt)
    drift.rammedShield = math.max(0, (drift.rammedShield or 0) - dt)
    drift.collisionCooldown = math.max(0, (drift.collisionCooldown or 0) - dt)
    if detectCollision(car, dt) then
        -- Check: was another car very close AND approaching us?
        -- Must distinguish: tandem partner drifting alongside vs griefer ramming into us
        local nearDist = drift.nearestCarDist or 9999
        local wasRammed = false
        if nearDist < 6 and drift.tandemNearIdx >= 0 then
            pcall(function()
                local other = ac.getCar(drift.tandemNearIdx)
                if other and other.isConnected then
                    local myPos = car.position
                    local otherPos = other.position
                    local otherLook = other.look
                    if myPos and otherPos and otherLook then
                        -- Vector from other car to us
                        local toMe = vec3(myPos.x - otherPos.x, 0, myPos.z - otherPos.z)
                        local dist2d = math.sqrt(toMe.x * toMe.x + toMe.z * toMe.z)
                        if dist2d > 0.01 then
                            toMe.x = toMe.x / dist2d
                            toMe.z = toMe.z / dist2d
                        end
                        -- Dot product: other's look vs direction to us
                        -- >0.5 = they're pointing at us (approaching)
                        local dot = otherLook.x * toMe.x + otherLook.z * toMe.z
                        -- Closing speed: their velocity towards us
                        local otherVel = other.velocity
                        local closingSpeed = 0
                        if otherVel then
                            closingSpeed = otherVel.x * toMe.x + otherVel.z * toMe.z
                        end
                        -- Rammed = other is facing us AND closing fast (>5 m/s)
                        -- OR other is very close (<3m) AND closing (>2 m/s)
                        if (dot > 0.4 and closingSpeed > 5) or (nearDist < 3 and closingSpeed > 2) then
                            wasRammed = true
                        end
                    end
                end
            end)
        end
        if wasRammed then
            -- Another car rammed us → protect victim's score
            drift.isRammed = true
            drift.collisionFlash = 0.8
            drift.rammedShield = 3.0  -- 3s immunity after being rammed
        elseif drift.rammedShield > 0 then
            -- Still in immunity window from recent ram → skip
        else
            -- Genuine wall/object collision
            if drift.collisionCooldown > 0 then
                -- Still in 3s cooldown from last collision → no penalty, just flash
                drift.collisionFlash = 0.5
            else
                -- First hit (or cooldown expired) → apply penalty + start 3s cooldown
                local force = drift.lastCollisionForce  -- 0..1
                local penaltyPct = 0.05 + force * 0.10  -- 5% (light touch) to 15% (head-on)
                local preDisplay = drift.currentScore * drift.combo  -- what user saw before collision
                local penalty = math.max(100, drift.currentScore * penaltyPct)
                drift.collisionFlash = 1.5
                drift.isCollision = true
                drift.collisionCooldown = 3  -- 3s immunity after penalty
                drift.currentScore = math.max(0, drift.currentScore - penalty)
                drift.bonusScore = math.max(0, drift.bonusScore - drift.bonusScore * penaltyPct)
                -- Reduce combo proportionally to force — keep above 1.01 so drift stays alive
                drift.combo = math.max(1.01, drift.combo * (1 - force * 0.3))
                drift.comboReached = math.max(drift.comboReached, drift.combo)
                -- NOW compute display with reduced combo so the drop is visible
                drift.displayScore = drift.currentScore * drift.combo
                drift.displayBonus = drift.bonusScore * drift.combo
                drift._peakDisplay = drift.displayScore
                drift._peakBonus = drift.displayBonus
                -- Show actual display penalty in COLLISION text
                drift.collisionPenalty = math.floor(preDisplay - drift.displayScore)
            end
        end
        ::skipCollision::
    end

    -- === SPIN DETECTION ===
    drift.isSpin = false
    drift.spinFlash = math.max(0, drift.spinFlash - dt)
    if detectSpin(car, dt) and not drift.spinDetected then
        drift.spinDetected = true
        drift.spinFlash = 2.0
        drift.isSpin = true
        drift.spinCount = drift.spinCount + 1
        -- Spin = lose ALL current score, end drift immediately
        drift.currentScore = 0
        drift.displayScore = 0
        drift.displayBonus = 0
        drift.bonusScore = 0
        drift._peakDisplay = 0
        drift._peakBonus = 0
        drift.combo = 1
        drift.comboReached = 0
        drift.timeout = 0
        drift.longDriftTimer = 0
        drift._steerLockTimer = 0
        drift.inDrift = false
        drift.yawAccum = 0
    end
    if drift.spinDetected and drift.yawRate < 80 and drift.angle < 30 then
        drift.spinDetected = false
    end
    -- Timeout: force-clear spin after 3s to prevent permanent scoring lock
    if drift.spinDetected then
        drift._spinTimer = (drift._spinTimer or 0) + dt
        if drift._spinTimer > 3 then drift.spinDetected = false; drift._spinTimer = 0 end
    else
        drift._spinTimer = 0
    end

    -- === TANDEM (improved, every 15 frames) ===
    if drift.updatesTimer % 15 == 7 then
        pcall(function() getTandemInfo(car) end)
    end

    -- === CORE DRIFT LOGIC ===
    local canScore = angle > 10 and speed > 20 and dirt == 0 and wheelsOut < 4
    -- Transition grace: genuine direction switch (angle briefly dips but car is mid-drift)
    -- More forgiving: angle > 3° (not fully straight), speed > 10, up to 2s window
    local inTransitionGrace = (not canScore) and angle > 3 and speed > 10
        and drift.inDrift and drift.noDriftTimer < 2.0
        and drift.currentScore > 20 and dirt == 0 and wheelsOut < 4
    if trackHasSpline and canScore then
        if splinePos < drift.splineReached - 0.0001 then
            canScore = false
            inTransitionGrace = false
        end
    end
    if drift.spinDetected then canScore = false; inTransitionGrace = false end

    if canScore or inTransitionGrace then
        drift.timeout = math.min(1, drift.timeout + dt)
        -- SCORE ACCUMULATION: angle × speed (piecewise linear curves)
        -- angleFactor: 10°=5x, 30°=15x, 45°=30x, 60°+=50x
        local af
        if angle <= 10 then af = 5
        elseif angle <= 30 then af = 5 + (angle - 10) / 20 * 10
        elseif angle <= 45 then af = 15 + (angle - 30) / 15 * 15
        elseif angle <= 60 then af = 30 + (angle - 45) / 15 * 20
        else af = 50 end
        -- speedFactor: 20=5x, 30=10x, 50=20x, 65+=30x
        local sf
        if speed <= 20 then sf = 5
        elseif speed <= 30 then sf = 5 + (speed - 20) / 10 * 5
        elseif speed <= 50 then sf = 10 + (speed - 30) / 20 * 10
        else sf = 20 + (speed - 50) / 15 * 10 end
        if sf > 30 then sf = 30 end
        local baseScore = af * sf
        -- During transition grace, score at 50% rate (reduced but not zero)
        local transitionScale = inTransitionGrace and 0.5 or 1
        local rawInc = baseScore * dt * drift.initialMult * 0.06 * transitionScale
        local scoreInc = rawInc
        drift.currentScore = drift.currentScore + scoreInc
        -- Bonus from extra multipliers (tracked separately)
        local bonusInc = rawInc * math.max(0, drift.extraMult - 1)
        drift.bonusScore = drift.bonusScore + bonusInc
        -- Combo buildup: +1x per minute of uninterrupted drift, UNLIMITED
        drift.combo = drift.combo + (1 / 60) * dt
        drift.longDriftTimer = drift.longDriftTimer + dt
        -- Drift direction tracking (transitions do NOT reset long drift timer)
        local rawSlipSign = 0
        if wheels then
            local s2 = wheels[2] and wheels[2].slipAngle or 0
            local s3 = wheels[3] and wheels[3].slipAngle or 0
            rawSlipSign = (s2 + s3) > 0 and 1 or -1
        end
        drift.driftSign = rawSlipSign
        drift.noDriftTimer = 0
        drift.initialMult = 1
        if drift.comboReached < drift.combo then drift.comboReached = drift.combo end
        drift.inDrift = true
        _bankHoldTimer = 0 -- cancel bank hold so new drift shows immediately

        -- === DONUT DETECTION (steering locked in one direction) ===
        local steerVal = car.steer or 0
        local steerSign = steerVal > 0.15 and 1 or (steerVal < -0.15 and -1 or 0)
        if steerSign ~= 0 and steerSign == drift._steerSign then
            drift._steerLockTimer = drift._steerLockTimer + dt
        else
            drift._steerLockTimer = 0
            if steerSign ~= 0 then drift._steerSign = steerSign end
        end
        -- After 30s steering locked → DONUT DETECTED, slowly reverse points
        if drift._steerLockTimer > 30 then
            local overTime = drift._steerLockTimer - 30
            drift.currentScore = drift.currentScore - scoreInc
            drift.bonusScore = drift.bonusScore - bonusInc
            local decayRate = 0.02 + overTime * 0.001
            drift.currentScore = drift.currentScore * math.max(0.5, 1 - decayRate * dt)
            drift.bonusScore = drift.bonusScore * math.max(0.5, 1 - decayRate * dt)
            drift.combo = math.max(1, drift.combo - 0.05 * dt)
            drift.isDonut = true
        else
            drift.isDonut = false
        end
        if drift.yawAccum > 200 and drift.yawRate < 150 then
            drift.yawAccum = drift.yawAccum * 0.9
        end
    elseif drift.combo > 1 then
        -- Combo decay (faster so score submits quickly when not drifting)
        drift.timeout = math.min(1, drift.timeout + dt)
        drift.combo = math.max(1, drift.combo - 0.5 * (drift.noDriftTimer ^ 2) * dt)
        drift.noDriftTimer = drift.noDriftTimer + dt
        -- Only reset long drift timer if genuinely stopped drifting (not just a quick transition)
        if drift.noDriftTimer > 5 then
            drift.longDriftTimer = 0
        end
        drift._steerLockTimer = 0
        drift.driftSign = 0
    elseif drift.combo == 1 and drift.timeout > 0 then
        -- Timeout countdown (fast: 2x speed)
        drift.timeout = drift.timeout - dt * 2
        drift.noDriftTimer = drift.noDriftTimer + dt
        if drift.noDriftTimer > 5 then
            drift.longDriftTimer = 0
        end
    elseif drift.timeout <= 0 then
        -- Drift ended -- submit score
        drift.timeout = 0
        drift.longDriftTimer = 0
        drift._steerLockTimer = 0
        drift.driftSign = 0
        drift.noDriftTimer = drift.noDriftTimer + dt
        drift.yawAccum = 0
        drift.isDonut = false
        if drift.noWarning then
            if drift.currentScore > 0 then
                local baseScore = math.floor(drift.currentScore)
                -- Submit: base score + bonus (from extra multipliers)
                local mainScore = math.max(baseScore, math.floor(drift.displayScore))
                local bonusTotal = math.max(0, math.floor(drift.displayBonus))
                local submitted = mainScore + bonusTotal
                drift.cumulativeScore = drift.cumulativeScore + submitted
                drift.lastScore = submitted
                -- Count all runs toward leaderboard stats
                drift.totalScore = drift.totalScore + submitted
                drift.driftCount = drift.driftCount + 1
                if submitted > drift.bestDrift then drift.bestDrift = submitted end
                if #drift.history >= 10 then table.remove(drift.history, 1) end
                table.insert(drift.history, { score = submitted, combo = drift.comboReached, angle = drift.bestAngle })
                if trackHasSpline then
                    drift.submittedLapScore = drift.submittedLapScore + math.max(0, submitted)
                end
                -- Send bank animation to HUD (always, so score doesn't vanish)
                if _driftHudBrowser and _driftHudReady then
                    _bankHoldTimer = 5.0
                    pcall(function()
                        _driftHudBrowser:sendAsync('bank', {
                            base = mainScore,
                            bonus = bonusTotal,
                            total = submitted,
                            combo = drift.comboReached,
                        }, NOOP)
                    end)
                end
                -- Play banked sound
                pcall(playBankedSfx)
                -- Save all persistent stats
                pcall(function()
                    if driftStore then
                        driftStore.driftCumulativeScore = math.floor(drift.cumulativeScore)
                        driftStore.driftTotalScore = math.floor(drift.totalScore)
                        driftStore.driftDriftCount = drift.driftCount
                        driftStore.driftCollisionCount = drift.collisionCount
                        driftStore.driftSpinCount = drift.spinCount
                    end
                end)
            end
        end
        drift.currentScore = 0
        drift.displayScore = 0
        drift.displayBonus = 0
        drift.bonusScore = 0
        drift._peakDisplay = 0
        drift._peakBonus = 0
        drift.combo = 1
        drift.comboReached = 0
        drift.inDrift = false
        drift.spinDetected = false  -- clear spin lock on drift end
        drift._spinTimer = 0
    end

    -- Lap score tracking
    if trackHasSpline then
        local potScore = math.floor(drift.displayScore)
        drift.currentLapScore = drift.lapScoreCutValue + drift.submittedLapScore + potScore
        if not drift.lapScoreCut and drift.currentLapScore < 0 then
            while drift.currentLapScore < 0 do
                if drift.currentLapScore > drift.lapScoreCutValue * 0.99 then
                    drift.lapScoreCutValue = drift.lapScoreCutValue * 0.99
                else
                    drift.lapScoreCutValue = drift.lapScoreCutValue + 1
                end
                drift.currentLapScore = drift.lapScoreCutValue + drift.submittedLapScore + potScore
            end
        end
        -- New lap detection
        if lapTimeMs < 1000 and not drift.lapScoreCut then
            drift.lapScoreCut = true
            if drift.currentLapScore > drift.bestLapScore then
                drift.bestLapScore = drift.currentLapScore
            end
            drift.currentLapScore = 0
            drift.submittedLapScore = 0
            drift.lapScoreCutValue = -math.floor(drift.currentScore * drift.combo)
        elseif lapTimeMs >= 1000 then
            drift.lapScoreCut = false
            if math.floor(drift.currentScore * drift.combo) == 0 and drift.currentLapScore < -1 then
                drift.lapScoreCutValue = 0
                drift.currentLapScore = 0
            end
        end
        -- Spline tracking
        if lapTimeMs < 3000 or splinePos < 0.001 then
            drift.splineReached = 0
        elseif splinePos > drift.splineReached then
            drift.splineReached = splinePos
        end
    end

    -- === WARNING DETECTION ===
    drift.noWarning = true
    drift.isTooSlow = false
    drift.isOffTrack = false
    drift.isBackwards = false
    if speed <= 20 and drift.currentScore > 0 then drift.isTooSlow = true end
    if dirt > 0 or wheelsOut == 4 then drift.noWarning = false; drift.isOffTrack = true end
    if trackHasSpline and splinePos < drift.splineReached - 0.0001 then
        drift.noWarning = false; drift.isBackwards = true
    end

    -- Warning penalty: rapid score decay (off-track / backwards only)
    if not drift.noWarning and drift.combo > 1 then
        drift.comboReached = 0
        local decayMult = drift.isOffTrack and 3 or 1
        local comboLoss = drift.isOffTrack and 2 or 1
        drift.currentScore = drift.currentScore - (drift.currentScore * dt * decayMult)
        if drift.currentScore > 0 then
            drift.combo = math.max(1, drift.combo - dt * comboLoss)
        else
            drift.combo = 1
        end
    elseif not drift.noWarning and drift.combo == 1 then
        drift.comboReached = 0
        local decayMult = drift.isOffTrack and 5 or 2
        drift.currentScore = drift.currentScore - (drift.currentScore * decayMult * dt)
    end

    -- === EXTRA MULTIPLIERS (with wall proximity + improved tandem) ===
    drift.extraMult = 1
    drift.isTandem = false
    drift.isLongDrift = false
    drift.isReverse = false
    drift.isTooMuchAngle = false
    drift.isWallRide = false
    drift.longDriftBonus = 1
    local tandemMult = 1

    if drift.noWarning then
        -- Too much angle (>120) = x0
        if angle > 120 then
            drift.extraMult = drift.extraMult * 0
            drift.isTooMuchAngle = true
            drift.longDriftTimer = 0
        end
        -- TANDEM bonus (improved: distance tiers + angle match + lead/chase)
        tandemMult = calcTandemMult()
        if tandemMult > 1.0 then
            drift.extraMult = drift.extraMult * tandemMult
            drift.isTandem = true
        end
        -- Reverse drift (90-120 = x4)
        if angle > 90 and angle <= 120 then
            drift.extraMult = drift.extraMult * 4
            drift.isReverse = true
        end
        -- WALL PROXIMITY bonus (raycasted, requires >= 30° angle)
        if drift.wallProximityMult > 1.0 and drift.inDrift and angle >= 30 then
            drift.extraMult = drift.extraMult * drift.wallProximityMult
            drift.isWallRide = true
        end
        -- Long drift bonus: after 4 min (240s) of continuous drift → x6 (works with transitions)
        if drift.longDriftTimer > 240 then
            drift.longDriftBonus = 6
            drift.extraMult = drift.extraMult * drift.longDriftBonus
            drift.isLongDrift = true
        end
        -- Round multiplier to nearest 0.05
        drift.extraMult = math.ceil(drift.extraMult * 20) / 20
    end

    -- === PILL MULTIPLIER VALUES (sent to HUD for display) ===
    drift.pillBonusLong = 0
    drift.pillBonusWall = 0
    drift.pillBonusTandem = 0
    drift.pillBonusReverse = 0
    if canScore and drift.noWarning and drift.inDrift then
        if drift.isLongDrift then drift.pillBonusLong = math.ceil(drift.longDriftBonus * 10) / 10 end
        if drift.isWallRide then drift.pillBonusWall = math.ceil(drift.wallProximityMult * 10) / 10 end
        if drift.isTandem then drift.pillBonusTandem = math.ceil(tandemMult * 10) / 10 end
        if drift.isReverse then drift.pillBonusReverse = 4 end
    end

    -- === DISPLAY SCORE ===
    -- When actively scoring: follow live score*combo
    -- When not actively scoring (combo decaying/timeout): freeze at peak so score doesn't visually drop
    if drift.inDrift or drift.currentScore > 0 then
        local liveScore = drift.currentScore * drift.combo
        local liveBonus = drift.bonusScore * drift.combo
        if canScore and drift.noWarning then
            -- Actively drifting: show live value, track peak
            drift.displayScore = liveScore
            drift.displayBonus = liveBonus
            drift._peakDisplay = liveScore
            drift._peakBonus = liveBonus
        else
            -- Not actively drifting (braking/timeout): hold peak, never drop
            if not drift._peakDisplay then drift._peakDisplay = 0 end
            if not drift._peakBonus then drift._peakBonus = 0 end
            if liveScore > drift._peakDisplay then drift._peakDisplay = liveScore end
            if liveBonus > drift._peakBonus then drift._peakBonus = liveBonus end
            drift.displayScore = drift._peakDisplay
            drift.displayBonus = drift._peakBonus
        end
    else
        drift.displayScore = 0
        drift.displayBonus = 0
        drift._peakDisplay = 0
        drift._peakBonus = 0
    end

    -- === PRAISE ===
    drift.praise = ''
    local potentialScore = drift.currentScore * drift.combo
    if drift.noWarning and (potentialScore > 0 or drift.comboReached >= 2) then
        if drift.isClipping and drift.isTandem then drift.praise = 'LEGENDARY!'
        elseif potentialScore > 64000 then drift.praise = 'Impossible Drift!'
        elseif drift.comboReached >= 8 or potentialScore > 32000 then drift.praise = 'Incredible Drift!'
        elseif drift.comboReached >= 6 or potentialScore > 16000 then drift.praise = 'Insane Drift!'
        elseif drift.comboReached >= 5 or potentialScore > 8000 then drift.praise = 'Amazing Drift!'
        elseif drift.comboReached >= 4 or potentialScore > 4000 then drift.praise = 'Great Drift!'
        elseif drift.comboReached >= 3 or potentialScore > 2000 then drift.praise = 'Good Drift!'
        elseif drift.comboReached >= 2 or potentialScore > 1000 then drift.praise = 'Nice Drift!'
        elseif potentialScore > 0 then drift.praise = 'Drift!'
        end
        -- Append Wall Ride if clipping (not already LEGENDARY which includes wall+tandem)
        if drift.isClipping and drift.praise ~= 'LEGENDARY!' then
            drift.praise = 'Wall Ride!'
        end
    end
    -- Override praise for collision/spin
    if drift.collisionFlash > 0.5 then drift.praise = 'COLLISION! -' .. tostring(math.floor(drift.collisionPenalty)) end
    if drift.spinFlash > 1.0 then drift.praise = 'SPIN! Score Reset!' end
    -- Play sound on praise upgrade (only specific tiers)
    if drift.praise ~= (drift._lastPraise or '') then
        drift._lastPraise = drift.praise
        if drift.collisionFlash <= 0.5 and drift.spinFlash <= 1.0 then
            if drift.praise == 'Nice Drift!' or drift.praise == 'Amazing Drift!'
                or drift.praise == 'Insane Drift!' or drift.praise == 'Incredible Drift!'
                or drift.praise == 'Impossible Drift!' or drift.praise == 'LEGENDARY!' then
                pcall(playPraiseSfx)
            end
        end
    end

    -- === RECORD PERSISTENCE ===
    if drift.bestDrift > drift.recordDrift then
        drift.recordDrift = drift.bestDrift
        pcall(function()
            if driftStore then driftStore.driftRecordDrift = drift.bestDrift end
        end)
    end
    if trackHasSpline and drift.bestLapScore > drift.recordLap then
        drift.recordLap = drift.bestLapScore
        pcall(function()
            if driftStore then driftStore.driftRecordLap = drift.bestLapScore end
        end)
    end

    -- === LEADERBOARD SUBMIT (every time bestDrift improves, on drift end) ===
    if drift.timeout <= 0 and drift.totalScore > (drift._lastSubmitTotalScore or 0) then
        submitDriftScore()
    end
    -- Periodic submit for play time tracking (every 60 seconds)
    drift._submitTimer = (drift._submitTimer or 0) + dt
    if drift._submitTimer > 60 then
        drift._submitTimer = 0
        submitDriftScore()
    end
    -- Auto-fetch leaderboard periodically
    if os.clock() - driftLB.lastFetch > driftLB.fetchInterval then
        fetchLeaderboard()
    end
end


