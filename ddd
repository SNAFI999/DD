function pushTickToBrowser(fullTick)
    if not browser or not BR.ready then return end
    local car = ac.getCar(myCarIndex)
    local speed = car and math.abs(car.speedKmh or 0) or 0
    local gearNum = car and car.gear or 0
    local gearStr = gearNum < 0 and 'R' or (gearNum == 0 and 'N' or tostring(gearNum))
    local rpm = 0
    local rpmMax = 8000
    pcall(function()
        if car then
            rpm = car.rpm or 0
            rpmMax = car.rpmLimiter or 8000
        end
    end)

    -- Fast tick: only send real-time data (speed, gear, rpm, drift essentials)
    if not fullTick then
        -- Reuse tables to reduce GC pressure (created once, updated in-place)
        if not BR._fastDrift then BR._fastDrift = {} end
        if not BR._fastData then BR._fastData = { _fast = true, drift = BR._fastDrift } end
        local fd = BR._fastDrift
        fd.angle = drift.angle
        fd.speed = drift.speed
        fd.currentScore = math.floor(drift.currentScore)
        fd.combo = math.ceil(drift.combo * 10) / 10
        fd.timeout = drift.timeout
        fd.inDrift = drift.inDrift or drift.timeout > 0
        fd.extraMult = drift.extraMult
        fd.praise = drift.praise
        fd.isTandem = drift.isTandem
        fd.isWallRide = drift.isWallRide
        fd.isClipping = drift.isClipping
        fd.wallProximityMult = math.ceil((drift.wallProximityMult or 1) * 10) / 10
        fd.collisionFlash = drift.collisionFlash
        fd.spinFlash = drift.spinFlash
        fd.tandemRole = drift.tandemRole or ''
        fd.tandemDist = math.floor((drift.tandemDist or 999) * 100) / 100
        fd.pillBonusTandem = drift.pillBonusTandem or 0
        local fastData = BR._fastData
        fastData.speed = speed
        fastData.gear = gearStr
        fastData.rpm = rpm
        fastData.rpmMax = rpmMax
        browser:sendAsync('tick', fastData, function() BR._lastTickOk = CC.clock end)
        return
    end

    local sim = ac.getSim()
    local totalCount = sim.carsCount or 0
    -- Cache online count from server data (cross-bucket accurate, recount every 2s)
    local now = CC.clock or os.clock()
    if not BR._onlineCountCache or now - (BR._onlineCountLast or 0) > 2 then
        -- Use mapPlayerCounts (fetched via /maps/player-counts) for cross-bucket total
        local cnt = 0
        if mapPlayerCounts then
            for _, v in pairs(mapPlayerCounts) do cnt = cnt + (tonumber(v) or 0) end
        end
        -- Fallback to local count if server data not yet available
        if cnt == 0 then
            for i = 0, totalCount - 1 do
                local c = ac.getCar(i)
                if c and c.isConnected then cnt = cnt + 1 end
            end
        end
        BR._onlineCountCache = cnt
        BR._onlineCountLast = now
    end
    local onlineCount = BR._onlineCountCache or 0

    -- Only rebuild history array when it actually changes (new drift added)
    local hist
    if #drift.history ~= BR._lastHistLen then
        BR._lastHistLen = #drift.history
        hist = {}
        for i, h in ipairs(drift.history) do
            hist[i] = { score = h.score, combo = h.combo, angle = h.angle }
        end
    end

    -- Detect menu just opened -> reset to home
    local navHome = false
    if showPanel and not _panelWasOpen then navHome = true end
    _panelWasOpen = showPanel

    -- Reuse tickData / tickDrift tables to reduce GC pressure (created once, updated in-place)
    if not BR._tickDrift then BR._tickDrift = {} end
    if not BR._tickData then BR._tickData = { drift = BR._tickDrift } end
    local tickDrift = BR._tickDrift
    local tickData = BR._tickData

    -- Update top-level fields
    tickData.speed = speed
    tickData.gear = gearStr
    tickData.rpm = rpm
    tickData.rpmMax = rpmMax
    tickData.savedPos = (savedPos ~= nil)
    tickData.spectateTarget = spectateTarget
    tickData.syncReady = syncReady
    tickData.onlineCount = onlineCount
    tickData.totalCount = totalCount
    tickData.currentMap = currentMapIdx
    tickData.mapPlayerCounts = mapPlayerCounts
    tickData.driverName = ac.getDriverName(myCarIndex) or 'Unknown'
    tickData.drift = tickDrift

    -- Update drift sub-table in-place
    tickDrift.angle = drift.angle
    tickDrift.speed = drift.speed
    tickDrift.currentScore = math.floor(drift.currentScore)
    tickDrift.combo = math.ceil(drift.combo * 10) / 10
    tickDrift.timeout = drift.timeout
    tickDrift.inDrift = drift.inDrift or drift.timeout > 0
    tickDrift.extraMult = drift.extraMult
    tickDrift.longDriftBonus = drift.longDriftBonus
    tickDrift.comboReached = math.ceil(drift.comboReached * 10) / 10
    tickDrift.praise = drift.praise
    tickDrift.isTandem = drift.isTandem
    tickDrift.isLongDrift = drift.isLongDrift
    tickDrift.isReverse = drift.isReverse
    tickDrift.isBraking = drift.isBraking
    tickDrift.isTooMuchAngle = drift.isTooMuchAngle
    tickDrift.isTooSlow = drift.isTooSlow
    tickDrift.isOffTrack = drift.isOffTrack
    tickDrift.isBackwards = drift.isBackwards
    tickDrift.isCollision = drift.isCollision
    tickDrift.isSpin = drift.isSpin
    tickDrift.isWallRide = drift.isWallRide
    tickDrift.isClipping = drift.isClipping
    tickDrift.wallProximityMult = math.ceil((drift.wallProximityMult or 1) * 10) / 10
    tickDrift.collisionFlash = drift.collisionFlash
    tickDrift.collisionPenalty = math.floor(drift.collisionPenalty or 0)
    tickDrift.collisionCount = drift.collisionCount or 0
    tickDrift.spinFlash = drift.spinFlash
    tickDrift.spinCount = drift.spinCount or 0
    tickDrift.tandemRole = drift.tandemRole or ''
    tickDrift.tandemDist = math.floor((drift.tandemDist or 999) * 10) / 10
    tickDrift.tandemAngleMatch = math.floor((drift.tandemAngleMatch or 0) * 100) / 100
    tickDrift.cumulativeScore = math.floor(drift.cumulativeScore or 0)
    tickDrift.totalScore = drift.totalScore
    tickDrift.bestDrift = drift.bestDrift
    tickDrift.bestAngle = drift.bestAngle
    tickDrift.topSpeed = drift.topSpeed
    tickDrift.driftCount = drift.driftCount
    tickDrift.lastScore = drift.lastScore
    tickDrift.sessionTime = drift.totalPlayTime or drift.sessionTime
    tickDrift.currentLapScore = drift.currentLapScore
    tickDrift.bestLapScore = drift.bestLapScore
    tickDrift.hasLapScoring = trackHasSpline
    tickDrift.recordDrift = drift.recordDrift
    tickDrift.recordLap = drift.recordLap
    tickDrift.history = hist

    -- CSP API flags: set once, never changes
    if not tickData._cspApis then
        pcall(function()
            tickData._cspApis = {
                carSwap = false,
                resetTrack = ac.resetDynamicTrackObjects ~= nil,
                sendKey = ac.sendKeyboardButtonEvent ~= nil,
                setupTabs = ac.getSetupTabs ~= nil,
            }
        end)
    end

    -- Clear conditional fields (nil them so they don't persist from previous tick)
    tickData.playlists = nil
    tickData.music = nil
    tickData.keybinds = nil
    tickData.navHome = nil
    tickData.neon = nil
    tickData.fLights = nil
    tickData.purge = nil
    tickData.leaderboard = nil
    tickData.ghost = nil

    if #MUS.playlists > 0 or MUS.plDirty then
        local pls = {}
        for pi, p in ipairs(MUS.playlists) do
            local tracks = {}
            for ti, t in ipairs(p.tracks or {}) do
                tracks[ti] = { title = t.title, artist = t.artist or '', videoId = t.videoId or '', thumbnail = t.thumbnail or '' }
            end
            pls[pi] = { name = p.name, tracks = tracks }
        end
        tickData.playlists = pls
        MUS.plDirty = false
    end

    -- Add music data if relevant
    if MUS.playing or MUS.searching or MUS.streamLoading or #MUS.results > 0 then
        -- Use our own elapsed timer instead of broken MediaPlayer currentTime/duration
        local curTime = MUS.elapsed
        local durTime = MUS.knownDuration
        local results = {}
        for i, r in ipairs(MUS.results) do
            results[i] = { title = r.title, artist = r.artist or '', duration = r.duration or 0, thumbnail = r.thumbnail or '', videoId = r.videoId or '' }
        end
        tickData.music = {
            playing = MUS.playing,
            paused = MUS.paused,
            searching = MUS.searching,
            loading = MUS.streamLoading,
            volume = MUS.volume,
            track = MUS.currentTrack and { title = MUS.currentTrack.title, artist = MUS.currentTrack.artist, thumbnail = MUS.currentTrack.thumbnail or '', videoId = MUS.currentTrack.videoId or '', duration = MUS.currentTrack.duration or 0 } or nil,
            currentTime = curTime,
            duration = durTime,
            results = results
        }
    end

    -- Add keybind data (only when changed)
    local kbStr = (keyCfg.menu.name or '') .. (keyCfg.save.name or '') .. (keyCfg.tp.name or '') .. (keyCfg.purge.name or '')
    if kbStr ~= BR._lastKbStr then
        BR._lastKbStr = kbStr
        tickData.keybinds = {
            menu = { label = keyCfg.menu.label, key = keyCfg.menu.name, gp = keyCfg.menu.gpName },
            save = { label = keyCfg.save.label, key = keyCfg.save.name, gp = keyCfg.save.gpName },
            tp   = { label = keyCfg.tp.label, key = keyCfg.tp.name, gp = keyCfg.tp.gpName },
            purge = { label = keyCfg.purge.label, key = keyCfg.purge.name, gp = keyCfg.purge.gpName }
        }
    end

    -- Navigate to home when menu just opened
    if navHome then tickData.navHome = true end

    -- Add HUD config state (reuse table)
    if not BR._hudConfig then BR._hudConfig = {} end
    local hc = BR._hudConfig
    hc.showDriftHud = iddlStore and iddlStore.showDriftHud or 1
    hc.showChat = iddlStore and iddlStore.showChat or 1
    hc.showNametags = iddlStore and iddlStore.showNametags or 1
    hc.showSpeedo = iddlStore and iddlStore.showSpeedo or 1
    hc.showAngle = iddlStore and iddlStore.showAngle or 1
    hc.showLbHud = iddlStore and iddlStore.showLbHud or 1
    hc.chatLangIn = iddlStore and iddlStore.chatLangIn or 0
    hc.chatLangOut = iddlStore and iddlStore.chatLangOut or 0
    hc.chatLangInName = TRANS.langs[iddlStore and iddlStore.chatLangIn or 0] or 'OFF'
    hc.chatLangOutName = TRANS.langs[iddlStore and iddlStore.chatLangOut or 0] or 'OFF'
    tickData.hudConfig = hc

    -- Add server time (seconds since midnight) for time-of-day slider
    tickData.serverTime = getDaySeconds()

    -- Add neon underglow state (only when changed)
    local neonStr = tostring(neon.enabled) .. string.format('%.3f%.3f%.3f%.1f', neon._baseR, neon._baseG, neon._baseB, neon.brightness) .. (neon.mode or '')
    if neonStr ~= BR._lastNeonStr then
        BR._lastNeonStr = neonStr
        tickData.neon = {
            enabled = neon.enabled,
            r = neon._baseR, g = neon._baseG, b = neon._baseB,
            brightness = neon.brightness,
            mode = neon.mode
        }
    end

    -- Add front lights state (only when changed)
    local fl = neon.front
    local flStr = tostring(fl.enabled) .. string.format('%.3f%.3f%.3f%.1f', fl._baseR, fl._baseG, fl._baseB, fl.brightness) .. (fl.mode or '')
    if flStr ~= BR._lastFlStr then
        BR._lastFlStr = flStr
        tickData.fLights = {
            enabled = fl.enabled,
            r = fl._baseR, g = fl._baseG, b = fl._baseB,
            brightness = fl.brightness,
            mode = fl.mode
        }
    end

    -- Add license plate state (only when changed)
    local plateStr = (plate.text or '') .. (plate.bg or '') .. (plate.tx or '')
    if plateStr ~= BR._lastPlateStr then
        BR._lastPlateStr = plateStr
        tickData.plate = {
            text = plate.text,
            bg = plate.bg,
            tx = plate.tx
        }
    end

    -- Add smoke color state (only when changed)
    local smokeStr = tostring(smokeColor.enabled) .. string.format('%.3f%.3f%.3f', smokeColor.r, smokeColor.g, smokeColor.b) .. (smokeColor.mode or '')
    if smokeStr ~= BR._lastSmokeStr then
        BR._lastSmokeStr = smokeStr
        tickData.smoke = {
            enabled = smokeColor.enabled,
            r = smokeColor.r, g = smokeColor.g, b = smokeColor.b,
            mode = smokeColor.mode
        }
    end

    -- Add NOS purge state (only when changed)
    local purgeStr = tostring(purge.enabled) .. tostring(purge.active)
    if purgeStr ~= BR._lastPurgeStr then
        BR._lastPurgeStr = purgeStr
        tickData.purge = { enabled = purge.enabled, active = purge.active }
    end

    -- Add leaderboard data
    if #driftLB.entries > 0 then
        tickData.leaderboard = driftLB.entries
    end

    -- Add ghost state (from TG_GhostState OnlineEvent + local tracking)
    local ghostData = nil
    pcall(function()
        if ghostUI.listFetched or ghostUI.loaded then
            ghostData = {
                visible   = ghostUI.localVisible,
                loading   = ghostUI.loading or false,
                loaded    = ghostUI.loaded or false,
                paused    = ghostUI.paused or false,
                activeGhost = ghostUI.activeGhostName or '',
                ghostCar  = ghostUI.ghostCarId or '',
                duration  = ghostUI.totalTimeMs or 0,
                loopCount = ghostUI.loopCount or 0,
                error     = ghostUI.listFetchError,
                availableGhosts = ghostUI.availableGhosts,
            }
        end
    end)
    if ghostData then
        -- Only send ghost data when something actually changed (avoid constant re-renders)
        local gStr = tostring(ghostData.loaded) .. tostring(ghostData.paused) .. tostring(ghostData.visible)
            .. (ghostData.activeGhost or '') .. tostring(ghostData.loopCount) .. tostring(ghostData.loading)
            .. tostring(ghostData.error or '') .. '#' .. tostring(#(ghostData.availableGhosts or {}))
            .. (ghostData.ghostCar or '') .. tostring(ghostData.duration)
        if gStr ~= ghostUI._lastTickJson then
            ghostUI._lastTickJson = gStr
            tickData.ghost = ghostData
        end
    end

    browser:sendAsync('tick', tickData, function() BR._lastTickOk = CC.clock end)
end

MUS.searchFn = function(query)
    if not query or query == '' then return end
    MUS.searching = true
    MUS.results = {}
    MUS.debug = ''
    local encoded = query:gsub(' ', '+'):gsub('[^%w%+%.%-_]', function(c)
        return string.format('%%%02X', string.byte(c))
    end)
    local url = BASE_URL .. '/music/search?q=' .. encoded .. '&max=5'
    MUS.debug = 'Searching...'

    web.get(url, function(err, resp)
        if err then
            MUS.searching = false
            MUS.debug = 'Search err: ' .. tostring(err)
            notify('Search failed: ' .. tostring(err))
            return
        end
        if not resp or not resp.body then
            MUS.searching = false
            MUS.debug = 'Search: empty response'
            notify('Empty response')
            return
        end


        local ok, data = pcall(JSON.parse, resp.body)
        if not ok or type(data) ~= 'table' then
            MUS.searching = false
            MUS.debug = 'Search: parse error'
            notify('Parse error')
            return
        end

        if data.error then
            MUS.searching = false
            local msg = tostring(data.error)
            MUS.debug = 'Search: ' .. msg:sub(1, 50)
            notify('Search error')
            return
        end

        local items = data.results or {}
        for _, item in ipairs(items) do
            table.insert(MUS.results, {
                title = item.title or 'Unknown',
                artist = item.artist or '',
                duration = tonumber(item.duration) or 0,
                videoId = item.videoId,
                thumbnail = item.thumbnail or '',
            })
        end
        MUS.searching = false
        MUS.debug = #MUS.results .. ' results (server)'
        if #MUS.results > 0 then
            notify(#MUS.results .. ' tracks found')
            -- Push results immediately to browser
            if browser and BR.ready then
                local results = {}
                for ri, r in ipairs(MUS.results) do
                    results[ri] = { title = r.title, artist = r.artist, thumbnail = r.thumbnail or '', videoId = r.videoId or '' }
                end
                browser:sendAsync('musicResults', results, NOOP)
            end
        else
            notify('No results')
        end
    end)
end

MUS.stopFn = function()
    if MUS.player then
        pcall(function() MUS.player:setSource(''):stop() end)
    end
    MUS.playing = false
    MUS.paused = false
    MUS.currentTrack = nil
    web.get(BEAT_BASE .. '/beat/notify?action=stop', function(err, resp)
        if err then else end
    end)
end

MUS.playFn = function(result)
    -- Stop any ongoing beat analysis first (prevents race with separate stop cmd)
    web.get(BEAT_BASE .. '/beat/notify?action=stop', NOOP)
    MUS.streamLoading = true
    MUS.debug = 'Loading audio...'

    local audioUrl = BASE_URL .. '/music/audio?v=' .. result.videoId

    web.get(audioUrl, function(err, resp)
        if err then
            MUS.streamLoading = false
            MUS.debug = 'Audio error: ' .. tostring(err)
            notify('Cannot get audio stream')
            return
        end
        if not resp or not resp.body then
            MUS.streamLoading = false
            MUS.debug = 'Audio: empty response'
            notify('Cannot get audio stream')
            return
        end

        local body = resp.body

        local ok, data = pcall(JSON.parse, body)
        if not ok or type(data) ~= 'table' then
            MUS.streamLoading = false
            MUS.debug = 'Audio: invalid JSON'
            notify('Cannot get audio stream')
            return
        end
        if data.error then
            MUS.streamLoading = false
            MUS.debug = 'Audio: ' .. tostring(data.error)
            notify('Cannot get audio stream')
            return
        end

        -- Server returns relative URL like /music/stream?v=xxx, prepend BASE_URL
        local streamUrl = data.url
        if not streamUrl or streamUrl == '' then
            MUS.streamLoading = false
            MUS.debug = 'Audio: no URL returned'
            notify('Cannot get audio stream')
            return
        end
        -- Make absolute if relative
        if streamUrl:sub(1, 1) == '/' then
            streamUrl = BASE_URL .. streamUrl
        end

        MUS.streamLoading = false

        if not MUS.player then
            local ok2, err2 = pcall(function() MUS.player = ui.MediaPlayer() end)
        end
        if not MUS.player then notify('MediaPlayer not available'); return end

        local setOk, setErr = pcall(function()
            MUS.player:setSource(streamUrl):setAutoPlay(true):setVolume(MUS.volume):play()
        end)

        -- Set a retry timer for delayed play
        MUS.playRetryTimer = 1.0

        MUS.playing = true
        MUS.paused = false
        MUS.currentTrack = { title = result.title, artist = result.artist, thumbnail = result.thumbnail or '', videoId = result.videoId or '', duration = result.duration or 0 }
        MUS.knownDuration = tonumber(result.duration) or 0
        MUS.elapsed = 0
        local _beatUrl = BEAT_BASE .. '/beat/notify?action=play&v=' .. (result.videoId or '') .. '&t=0'
        web.get(_beatUrl, function(err, resp)
            if err then else end
        end)
        MUS.debug = 'Playing via server'
        MUS.trackEndGrace = 3.0  -- wait 3s before checking for track end
        MUS.lastTime = -1
        MUS.stallTimer = 0
        notify('Playing: ' .. result.title)
    end)
end

