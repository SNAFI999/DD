function script.drawUI(dt)
    dt = dt or 0.016

    -- Cache per-frame values (avoid repeated C calls)
    CC.clock = os.clock()
    CC.ui = ac.getUI()
    CC.sim = ac.getSim()

    -- Walking camera HUD disabled

    -- Re-enable collisions after teleport timeout
    if collisionReEnableTime > 0 and CC.clock > collisionReEnableTime then
        collisionReEnableTime = 0
        if hasCollisionCtrl then
            pcall(function() physics.disableCarCollisions(0, false) end)
        end
    end

    ----------------------------------------------------------------------
    -- DRIFT HUD OVERLAY - HTML/CSS via CEF browser (draggable)
    ----------------------------------------------------------------------
    if iddlStore and iddlStore.showDriftHud == 0 then
        -- drift HUD hidden by config
    elseif tutorialActive then
        -- drift HUD hidden during tutorial
    else
    pcall(function()
        local uiState = CC.ui
        local sw = (uiState and uiState.windowSize and uiState.windowSize.x) or 1920
        local sh = (uiState and uiState.windowSize and uiState.windowSize.y) or 1080

        -- Create drift HUD browser (once)
        if not _driftHudBrowser then
            pcall(function()
                _driftHudBrowser = WebBrowser({ size = vec2(460, 200), backgroundColor = rgbm(0, 0, 0, 0) })
                _driftHudBrowser:navigate(BASE_URL .. '/iddl/drift_hud.html?v=2')
                _driftHudBrowser:onReceive('iddldrifthud', function(self, data)
                    if data == 'ready' then _driftHudReady = true; _driftHudNavTime = nil end
                end)
                _driftHudReady = false
                _driftHudSendTimer = 0
                _driftHudNavTime = CC.clock
                _driftHudRetries = 0
            end)
        end
        -- Retry drift HUD if not ready within 5s (up to 6 retries)
        if _driftHudBrowser and not _driftHudReady and _driftHudNavTime and (_driftHudRetries or 0) < 6 then
            if CC.clock - _driftHudNavTime > 5.0 then
                _driftHudRetries = (_driftHudRetries or 0) + 1
                _driftHudNavTime = CC.clock
                pcall(function()
                    _driftHudBrowser:navigate(BASE_URL .. '/iddl/drift_hud.html?v=' .. tostring(os.clock()):gsub('%.', ''))
                end)
            end
        end

        -- === FLOATING COUNTER ===
        local hitW = 460
        local hitH = 200

        -- Init drag position
        if not driftHudPos then
            if iddlStore and iddlStore.driftHudPosX >= 0 and iddlStore.driftHudPosY >= 0 then
                driftHudPos = vec2(iddlStore.driftHudPosX, iddlStore.driftHudPosY)
            else
                driftHudPos = vec2((sw - hitW) / 2, sh * 0.32)
            end
        end

        local ax = driftHudPos.x
        local ay = driftHudPos.y

        -- Send data to HTML (~30fps for lower CPU cost without visible quality loss)
        if _driftHudBrowser and _driftHudReady then
            -- Suppress drift updates while bank animation is showing
            if (_bankHoldTimer or 0) > 0 then
                _bankHoldTimer = _bankHoldTimer - dt
            else
            _driftHudSendTimer = (_driftHudSendTimer or 0) + dt
            if _driftHudSendTimer >= 0.016 then
                _driftHudSendTimer = 0
                pcall(function()
                    -- Reuse table to reduce GC pressure
                    if not _driftHudData then _driftHudData = {} end
                    local d = _driftHudData
                    d.score = drift.currentScore or 0
                    d.displayScore = drift.displayScore or 0
                    d.displayBonus = drift.displayBonus or 0
                    d.combo = drift.combo or 1
                    d.comboReached = drift.comboReached or 0
                    d.mult = drift.extraMult or 1
                    d.timeout = drift.timeout or 0
                    d.praise = drift.praise or ''
                    d.isTandem = drift.isTandem or false
                    d.tandemRole = drift.tandemRole or ''
                    d.isWallRide = drift.isWallRide or false
                    d.isClipping = drift.isClipping or false
                    d.isReverse = drift.isReverse or false
                    d.isLongDrift = drift.isLongDrift or false
                    d.isTooSlow = drift.isTooSlow or false
                    d.isOffTrack = drift.isOffTrack or false
                    d.isBackwards = drift.isBackwards or false
                    d.isDonut = drift.isDonut or false
                    d.isRammed = drift.isRammed or false
                    d.collisionFlash = drift.collisionFlash or 0
                    d.collisionForce = drift.lastCollisionForce or 0
                    d.spinFlash = drift.spinFlash or 0
                    d.pillBonusLong = drift.pillBonusLong or 0
                    d.pillBonusWall = drift.pillBonusWall or 0
                    d.pillBonusTandem = drift.pillBonusTandem or 0
                    d.tandemDist = math.floor((drift.tandemDist or 999) * 100) / 100
                    d.pillBonusReverse = drift.pillBonusReverse or 0
                    d.angle = drift.angle or 0
                    d.wallProximityMult = math.ceil((drift.wallProximityMult or 1) * 10) / 10
                    d.wallDist = math.floor(math.min(drift.wallDistLeft or 999, drift.wallDistRight or 999) * 100) / 100
                    _driftHudBrowser:sendAsync('drift', d, function() _driftHudLastOk = CC.clock end)
                end)
            end
            end -- bankHoldTimer
        end

        -- === ADMIN TOAST ===
        if _adminToast.text and _adminToast.alpha > 0.01 then
            local elapsed = os.clock() - _adminToast.time
            if elapsed > _adminToast.duration then
                _adminToast.alpha = math.max(0, _adminToast.alpha - dt * 3)
            end
            local slideT = math.min(1, elapsed / 0.25)
            local ta = _adminToast.alpha * slideT
            if ta > 0.01 then
                local toastStr = _adminToast.text or ''
                local iconStr = _adminToast.icon or ''
                ui.pushDWriteFont(F.bold)
                local tSz = 12
                local tW = ui.measureDWriteText(toastStr, tSz).x
                local iSz = 14
                local iW = ui.measureDWriteText(iconStr, iSz).x
                ui.popDWriteFont()
                local iconCircle = 24
                local pillW = iconCircle + tW + 32
                local pillH = 28
                local pillX = ax + (hitW - pillW) / 2
                local slideOff = (1 - slideT) * 12
                local pillY = ay - pillH - 40 + slideOff
                local gp = 8
                ui.transparentWindow('iddlAdminToast', vec2(pillX - gp, pillY - gp), vec2(pillW + gp * 2, pillH + gp * 2), function()
                    local ox2, oy2 = gp, gp
                    for i = 2, 1, -1 do
                        local sp = i * 3
                        ui.drawRectFilled(vec2(ox2 - sp, oy2 - sp), vec2(ox2 + pillW + sp, oy2 + pillH + sp),
                            rgbm(_adminToast.r, _adminToast.g, _adminToast.b, 0.05 * ta * (3 - i)), pillH / 2 + sp)
                    end
                    ui.drawRectFilled(vec2(ox2, oy2), vec2(ox2 + pillW, oy2 + pillH),
                        rgbm(_adminToast.r, _adminToast.g, _adminToast.b, 0.92 * ta), pillH / 2)
                    local icX = ox2 + 3
                    local icY = oy2 + (pillH - iconCircle) / 2
                    ui.drawRectFilled(vec2(icX, icY), vec2(icX + iconCircle, icY + iconCircle), rgbm(0, 0, 0, 0.18 * ta), iconCircle / 2)
                    ui.pushDWriteFont(F.bold)
                    ui.dwriteDrawText(iconStr, iSz, vec2(icX + (iconCircle - iW) / 2, icY + (iconCircle - iSz) / 2), rgbm(1, 1, 1, ta))
                    local isGrn = _adminToast.g > 0.6 and _adminToast.r < 0.5
                    ui.dwriteDrawText(toastStr, tSz, vec2(icX + iconCircle + 6, oy2 + (pillH - tSz) / 2), isGrn and rgbm(0.02, 0.06, 0.02, ta) or rgbm(1, 1, 1, ta))
                    ui.popDWriteFont()
                end)
            end
        end

        -- === MAIN HUD: draw browser (skip when nothing visible to save GPU) ===
        local driftHudVisible = drift.inDrift or drift.timeout > 0 or (drift.collisionFlash or 0) > 0 or (drift.spinFlash or 0) > 0 or (_bankHoldTimer or 0) > 0
        if driftHudVisible then
