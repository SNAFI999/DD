        -- CSP 0.3.0: ac.resetDynamicTrackObjects()
        pcall(function()
            if ac.resetDynamicTrackObjects then
                ac.resetDynamicTrackObjects()
                notify('Track objects reset')
            else
                notify('Not available (need CSP 0.3.0+)')
            end
        end)

    elseif cmd == 'send-key-pits' then
        -- Teleport to current map spawn (pits)
        pcall(function()
            local m = mapLocations[currentMapIdx]
            if m then
                doTeleport(m.pos, m.dir, 'Teleported to ' .. m.name .. ' pits')
            else
                notify('No map location found')
            end
        end)

    elseif cmd:sub(1, 9) == 'send-key/' then
        -- Generic key send: send-key/{keyIndex}
        local keyIdx = tonumber(cmd:sub(10))
        if keyIdx then
            pcall(function()
                if ac.sendKeyboardButtonEvent then
                    ac.sendKeyboardButtonEvent(keyIdx, true)
                    setTimeout(function()
                        ac.sendKeyboardButtonEvent(keyIdx, false)
                    end, 50)
                else
                    notify('sendKeyboardButtonEvent not available')
                end
            end)
        end

    elseif cmd == 'get-setup' then
        -- CSP 0.3.0: ac.getSetupTabs() + ac.getSetupSpinners()
        pcall(function()
            local setupData = {}
            if ac.getSetupTabs then
                setupData.tabs = ac.getSetupTabs()
            end
            if ac.getSetupSpinners then
                setupData.spinners = ac.getSetupSpinners()
            end
            if browser and BR.ready then
                browser:sendAsync('setupData', setupData, NOOP)
            end
        end)

    ----------------------------------------------------------------
    -- PRIVATE LOBBY (routing buckets) — delegated to separate function
    ----------------------------------------------------------------
    elseif cmd:sub(1, 9) == 'pvtlobby-' then
        handlePvtLobbyCommand(cmd)

    ----------------------------------------------------------------
    -- CAR SWAP (seamless reconnect)
    ----------------------------------------------------------------
    elseif cmd:sub(1, 9) == 'car-swap/' then
        local newCarId = cmd:sub(10)
        if newCarId and newCarId ~= '' and newCarId ~= carId then
            notify('Switching to ' .. newCarId .. '...')
            pcall(function()
                if ac.reconnectTo then
                    local sIP = ac.getServerIP and ac.getServerIP() or nil
                    local sPort = ac.getServerPortTCP and ac.getServerPortTCP() or nil
                    local sHttpPort = ac.getServerPortHTTP and ac.getServerPortHTTP() or nil
                    if not sIP then sIP = ac.INIConfig.onlineExtras():get('SERVER', 'IP', '127.0.0.1') end
                    if not sPort then sPort = ac.INIConfig.onlineExtras():get('SERVER', 'PORT', '9981') end
                    if not sHttpPort then sHttpPort = ac.INIConfig.onlineExtras():get('EXTRA_DATA', 'HTTP_PORT', '8081') end
                    local sPass = ac.INIConfig.onlineExtras():get('SERVER', 'PASSWORD', '')
                    ac.reconnectTo({
                        serverIP = tostring(sIP),
                        serverPort = tonumber(sPort),
                        serverHttpPort = tonumber(sHttpPort),
                        serverPassword = tostring(sPass),
                        serverName = 'Illegal Drift',
                        carID = newCarId,
                    })
                else
                    notify('Car swap not available (need CSP 0.2.0+)')
                end
            end)
        end

    ----------------------------------------------------------------
    -- ADMIN PANEL COMMANDS (from in-game menu)
    ----------------------------------------------------------------
    elseif cmd:sub(1, 12) == 'admin-popup/' then
        if not isAdmin() then notify('No permission: Admin role required'); return end
        local msg = cmd:sub(13)
        msg = msg:gsub('%%(%x%x)', function(hex) return string.char(tonumber(hex, 16)) end)
        if msg ~= '' then
            -- Broadcast announcement via sync event (action=16)
            pcall(function()
                if syncEvent then syncEvent({ action = 16, key = msg }) end
            end)
            -- Also push to own browser
            pcall(function()
                if browser and BR.ready then
                    browser:sendAsync('announcement', { text = msg, from = ac.getDriverName(myCarIndex) or 'Admin' }, NOOP)
                end
            end)
            showAdminToast('\xF0\x9F\x93\xA2', msg, 8, 0.17, 0.84, 0.47)
            -- Also broadcast via server HTTP
            pcall(function()
                local body = '{"message":' .. jsonStr('[ANNOUNCEMENT] ' .. msg) .. '}'
                web.post(BASE_URL .. '/admin/broadcast', { ['Content-Type'] = 'application/json' }, body, NOOP)
            end)
        end
    elseif cmd:sub(1, 16) == 'admin-broadcast/' then
        if not isAdmin() then notify('No permission: Admin role required'); return end
        local msg = cmd:sub(17)
        msg = msg:gsub('%%(%x%x)', function(hex) return string.char(tonumber(hex, 16)) end)
        if msg ~= '' then
            pcall(function()
                local body = '{"message":' .. jsonStr(msg) .. '}'
                web.post(BASE_URL .. '/admin/broadcast', { ['Content-Type'] = 'application/json' }, body, NOOP)
            end)
        end
    elseif cmd:sub(1, 11) == 'admin-kick/' then
        -- Already done via HTTP from browser, but broadcast sync event for real-time notification
        if not isAdmin() then return end
    elseif cmd:sub(1, 11) == 'admin-mute/' then
        if not isAdmin() then return end
        local rest = cmd:sub(12)
        local targetName, mins = rest:match('^([^/]+)/(%d+)$')
        if not targetName then targetName = rest; mins = '5' end
        targetName = targetName:gsub('%%(%x%x)', function(hex) return string.char(tonumber(hex, 16)) end)
        local secs = (tonumber(mins) or 5) * 60
        _muteList[targetName] = os.clock() + secs
        pcall(function()
            if syncEvent then syncEvent({ action = 17, key = 'mute|' .. targetName .. '|' .. tostring(secs) }) end
        end)
    elseif cmd:sub(1, 13) == 'admin-unmute/' then
        if not isAdmin() then return end
        local targetName = cmd:sub(14)
        targetName = targetName:gsub('%%(%x%x)', function(hex) return string.char(tonumber(hex, 16)) end)
        _muteList[targetName] = nil
        pcall(function()
            if syncEvent then syncEvent({ action = 17, key = 'unmute|' .. targetName .. '|0' }) end
        end)
    elseif cmd:sub(1, 11) == 'admin-warn/' then
        if not isAdmin() then return end
        local rest = cmd:sub(12)
        local targetName, reason = rest:match('^([^/]+)/(.+)$')
        if not targetName then targetName = rest; reason = 'No reason' end
        targetName = targetName:gsub('%%(%x%x)', function(hex) return string.char(tonumber(hex, 16)) end)
        reason = (reason or ''):gsub('%%(%x%x)', function(hex) return string.char(tonumber(hex, 16)) end)
        _warnCounts[targetName] = (_warnCounts[targetName] or 0) + 1
        pcall(function()
            if syncEvent then syncEvent({ action = 17, key = 'warn|' .. targetName .. '|' .. reason .. '|' .. tostring(_warnCounts[targetName]) }) end
        end)

    end
end
