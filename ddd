-- Detect input device type (keyboard / gamepad / wheel)
local function detectInputType()
    -- 1. Use server-side CSP handshake data (most reliable)
    if _serverPlayersCache then
        local myName = ac.getDriverName(myCarIndex)
        local srv = myName and _serverPlayersCache[myName]
        if srv and srv.inputMethod and srv.inputMethod ~= 'unknown' then
            local im = srv.inputMethod:lower()
            if im == 'gamepad' or im == 'controller' then return 'gamepad' end
            if im == 'keyboard' then return 'keyboard' end
            if im == 'wheel' then return 'wheel' end
        end
    end
    -- 2. Fallback: check gamepad
    local hasGamepad = false
    pcall(function()
        for gi = 0, 3 do
            if ac.isGamepadConnected(gi) then hasGamepad = true end
        end
    end)
    if hasGamepad then return 'gamepad' end
    -- 3. Check keyboard steering
    local kbSteer = false
    pcall(function()
        if ac.isKeyboardSteerUsed and ac.isKeyboardSteerUsed() then kbSteer = true end
    end)
    if kbSteer then return 'keyboard' end
    -- 4. No gamepad, not keyboard = wheel / direct-input device
    return 'wheel'
end

local function submitDriftScore()
    if driftLB.submitting then
        if driftLB._submitTime and (os.clock() - driftLB._submitTime) > 10 then
            driftLB.submitting = false
        else
            return
        end
    end
    if drift.bestDrift <= 0 and drift.sessionTime < 60 then return end
    driftLB.submitting = true
    local playerName = ac.getDriverName(myCarIndex) or 'Unknown'
    local mySteamId = ''
    pcall(function() mySteamId = tostring(ac.getUserSteamID()) end)
    -- Calculate deltas since last submit
    local playTimeDelta = math.floor(drift.totalPlayTime) - (drift._lastSubmitSessionTime or 0)
    if playTimeDelta < 0 then playTimeDelta = 0 end
    drift._lastSubmitSessionTime = math.floor(drift.totalPlayTime)
    local totalScoreDelta = math.floor(drift.totalScore) - (drift._lastSubmitTotalScore or 0)
    drift._lastSubmitTotalScore = math.floor(drift.totalScore)
    local driftCountDelta = drift.driftCount - (drift._lastSubmitDriftCount or 0)
    drift._lastSubmitDriftCount = drift.driftCount
    local collisionDelta = (drift.collisionCount or 0) - (drift._lastSubmitCollisions or 0)
    if collisionDelta < 0 then collisionDelta = 0 end
    drift._lastSubmitCollisions = drift.collisionCount or 0
    local body = JSON.stringify({
        name = playerName,
        car = carId or '',
        bestDrift = math.floor(drift.bestDrift),
        totalScore = totalScoreDelta,
        driftCount = driftCountDelta,
        bestCombo = math.floor(drift.comboReached * 10) / 10,
        playTime = math.floor(playTimeDelta),
        bestAngle = drift.bestAngle or 0,
        topSpeed = math.floor(drift.topSpeed or 0),
        collisionCount = collisionDelta,
        inputType = detectInputType(),
        steamId = mySteamId,
    })
    driftLB._submitTime = os.clock()
    pcall(function()
        web.post(BASE_URL .. '/drift/submit', { ['Content-Type'] = 'application/json' }, body, function(err, resp)
            driftLB.submitting = false
            if err then return end
            if resp and resp.body then
                local ok, data = pcall(JSON.parse, resp.body)
                if ok and type(data) == 'table' then
                    driftLB.myRank = data.rank or 0
                    driftLB.totalPlayers = data.totalPlayers or 0
                    driftLB.lastSubmitTotalScore = drift.totalScore
                    fetchLeaderboard()
                end
            end
        end)
    end)
end

