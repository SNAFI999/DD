----------------------------------------------------------------------
-- TRANSFORM UPDATES
----------------------------------------------------------------------
local lastUpT = os.preciseClock()
local function updateTransforms()
    local now = os.preciseClock(); local dt = now - lastUpT; lastUpT = now
    if dt > 0.1 then dt = 0.016 end
    for ci, carEq in pairs(equippedPerCar) do
        local car = ac.getCar(ci)
        if car then for _, eq in pairs(carEq) do for _, p in ipairs(eq.placements) do
            if p.node then
                local spin = 0
                if p.wheelIndex then
                    local as = 0
                    if car.wheels then local w = car.wheels[p.wheelIndex]; if w then as = w.angularSpeed or 0 end end
                    -- Fallback: derive from speed. Raise threshold to 5 km/h to avoid jitter on remote cars
                    if as == 0 and math.abs(car.speedKmh or 0) > 5 then as = (car.speedKmh / 3.6) / 0.3 end
                    p.wheelSpinAngle = (p.wheelSpinAngle + (isRight(p.attachNodeName) and 1 or -1) * as * dt) % 6.2832
                    spin = p.wheelSpinAngle
                end
                local yr, pr, rr = math.rad(p.rotation.y), math.rad(p.rotation.x), math.rad(p.rotation.z)
                local lx, ly, lz = 0, 0, 1
                local ux, uy, uz = 0, 1, 0
                local rx, ry, rz = 1, 0, 0
                if yr ~= 0 then
                    local c, s = math.cos(yr), math.sin(yr)
                    local nlx, nly, nlz = lx * c + rx * s, ly * c + ry * s, lz * c + rz * s
                    rx, ry, rz = rx * c - lx * s, ry * c - ly * s, rz * c - lz * s
                    lx, ly, lz = nlx, nly, nlz
                end
                if pr ~= 0 then
                    local c, s = math.cos(pr), math.sin(pr)
                    local nlx, nly, nlz = lx * c + ux * s, ly * c + uy * s, lz * c + uz * s
                    ux, uy, uz = ux * c - lx * s, uy * c - ly * s, uz * c - lz * s
                    lx, ly, lz = nlx, nly, nlz
                end
                if rr ~= 0 then
                    local c, s = math.cos(rr), math.sin(rr)
                    local nux, nuy, nuz = ux * c + rx * s, uy * c + ry * s, uz * c + rz * s
                    rx, ry, rz = rx * c - ux * s, ry * c - uy * s, rz * c - uz * s
                    ux, uy, uz = nux, nuy, nuz
                end
                if spin ~= 0 then
                    local c, s = math.cos(spin), math.sin(spin)
                    local nlx, nly, nlz = lx * c + ux * s, ly * c + uy * s, lz * c + uz * s
                    ux, uy, uz = ux * c - lx * s, uy * c - ly * s, uz * c - lz * s
                    lx, ly, lz = nlx, nly, nlz
                end
                local sx, sy, sz = p.scale.x, p.scale.y, p.scale.z
                local m = p.node:getTransformationRaw()
                if m then
                    m.row1:set(rx * sx, ry * sx, rz * sx, 0)
                    m.row2:set(ux * sy, uy * sy, uz * sy, 0)
                    m.row3:set(lx * sz, ly * sz, lz * sz, 0)
                    m.row4:set(p.offset.x, p.offset.y, p.offset.z, 1)
                end
            end
        end end end
    end
end

----------------------------------------------------------------------
-- ANIMATION SYSTEM
----------------------------------------------------------------------
local function applyAnimGroup(ci, anim, angleDeg)
    if #anim.meshes == 0 then return end
    local origMap = animOrigMatrices[ci]; if not origMap then return end
    local anchorOrig = origMap[anim.meshes[1]]; if not anchorOrig then return end
    local cr = getCarRoot(ci); if not cr or #cr == 0 then return end
    local pivot = anim.pivot or { x = 0, y = 0, z = 0 }
    local ux, uy, uz
    if anim.axis == 'x' then ux, uy, uz = anchorOrig.r1x, anchorOrig.r1y, anchorOrig.r1z
    elseif anim.axis == 'y' then ux, uy, uz = anchorOrig.r2x, anchorOrig.r2y, anchorOrig.r2z
    elseif anim.axis == 'z' then ux, uy, uz = anchorOrig.r3x, anchorOrig.r3y, anchorOrig.r3z
    else return end
    local len = math.sqrt(ux * ux + uy * uy + uz * uz)
    if len < 0.0001 then return end
    ux, uy, uz = ux / len, uy / len, uz / len
    local pvx = anchorOrig.r4x + anchorOrig.r1x * pivot.x + anchorOrig.r2x * pivot.y + anchorOrig.r3x * pivot.z
    local pvy = anchorOrig.r4y + anchorOrig.r1y * pivot.x + anchorOrig.r2y * pivot.y + anchorOrig.r3y * pivot.z
    local pvz = anchorOrig.r4z + anchorOrig.r1z * pivot.x + anchorOrig.r2z * pivot.y + anchorOrig.r3z * pivot.z
    local rad = math.rad(angleDeg)
    local co, si = math.cos(rad), math.sin(rad)
    local t = 1 - co
    local Rxx = co + ux * ux * t;     local Rxy = ux * uy * t - uz * si; local Rxz = ux * uz * t + uy * si
    local Ryx = uy * ux * t + uz * si; local Ryy = co + uy * uy * t;     local Ryz = uy * uz * t - ux * si
    local Rzx = uz * ux * t - uy * si; local Rzy = uz * uy * t + ux * si; local Rzz = co + uz * uz * t
    for _, mn in ipairs(anim.meshes) do
        local orig = origMap[mn]
        if orig then pcall(function()
            -- Use cached node reference instead of findNodes per frame
            if not _animNodeCache[ci] then _animNodeCache[ci] = {} end
            local ref = _animNodeCache[ci][mn]
            if not ref then
                ref = cr:findNodes(mn)
                if not ref or #ref == 0 then ref = cr:findMeshes(mn) end
                if not ref or #ref == 0 then return end
                _animNodeCache[ci][mn] = ref
                -- Apply twoSided only once on cache
                if anim.twoSided then
                    local mRef = cr:findMeshes(mn)
                    if mRef and #mRef > 0 then mRef:setCullMode(2) end
                end
            end
            local m = ref:getTransformationRaw(); if not m then return end
            local o1x, o1y, o1z = orig.r1x, orig.r1y, orig.r1z
            local o2x, o2y, o2z = orig.r2x, orig.r2y, orig.r2z
            local o3x, o3y, o3z = orig.r3x, orig.r3y, orig.r3z
            m.row1.x = Rxx * o1x + Rxy * o1y + Rxz * o1z
            m.row1.y = Ryx * o1x + Ryy * o1y + Ryz * o1z
            m.row1.z = Rzx * o1x + Rzy * o1y + Rzz * o1z; m.row1.w = 0
            m.row2.x = Rxx * o2x + Rxy * o2y + Rxz * o2z
            m.row2.y = Ryx * o2x + Ryy * o2y + Ryz * o2z
            m.row2.z = Rzx * o2x + Rzy * o2y + Rzz * o2z; m.row2.w = 0
            m.row3.x = Rxx * o3x + Rxy * o3y + Rxz * o3z
            m.row3.y = Ryx * o3x + Ryy * o3y + Ryz * o3z
            m.row3.z = Rzx * o3x + Rzy * o3y + Rzz * o3z; m.row3.w = 0
            local dx, dy, dz = orig.r4x - pvx, orig.r4y - pvy, orig.r4z - pvz
            m.row4.x = pvx + Rxx * dx + Rxy * dy + Rxz * dz
            m.row4.y = pvy + Ryx * dx + Ryy * dy + Ryz * dz
            m.row4.z = pvz + Rzx * dx + Rzy * dy + Rzz * dz; m.row4.w = 1
        end) end
    end
end

local function toggleAnim(ci, animIdx)
    local states = ensureAnimState(ci); ensureAnimOrig(ci)
    local st = states[animIdx]; if st then st.open = not st.open end
end

local function updateAnimations(dt)
    if #animDefs == 0 then return end
    for ci, ciStates in pairs(animStates) do
        for idx, st in pairs(ciStates) do
            local anim = animDefs[idx]
            if anim then
                local target = st.open and anim.angle or 0
                if math.abs(st.t - target) > 0.05 then
                    local dir = (target > st.t) and 1 or -1
                    st.t = st.t + dir * (anim.speed or 90) * dt
                    if (dir > 0 and st.t > target) or (dir < 0 and st.t < target) then st.t = target end
                end
                applyAnimGroup(ci, anim, st.t)
            end
        end
    end
end

