uSt.gifSearch = function(q)
  if uSt.gifBusy then return end
  uSt.gifBusy = true
  uSt.gifMsg = "جاري البحث..."
  local enc = tostring(q or ""):gsub("([^%w%-%._~])", function(c) return string.format("%%%02X", string.byte(c)) end)
  -- v2 أولاً (أحدث) ثم v1 كبديل
  local url = "https://tenor.googleapis.com/v2/search?q=" .. enc .. "&key=LIVDSRZULELA&client_key=teamkabos&limit=30&media_filter=gif,tinygif&contentfilter=high"
  local function parse(body)
    local ok, data = pcall(JSON.parse, body)
    if not ok or type(data) ~= "table" then return nil end
    local res = data.results
    if type(res) ~= "table" then return nil end
    local out = {}
    for _, it in ipairs(res) do
      local mf = it.media_formats or (it.media and it.media[1])
      local g = mf and (mf.tinygif or mf.gif or mf.nanogif)
      local u = g and g.url
      if u then out[#out + 1] = u end
    end
    return out
  end
  local function done(list, why)
    uSt.gifBusy = false
    if list and #list > 0 then uSt.gifList = list; uSt.gifMsg = #list .. " نتيجة"
    else uSt.gifMsg = why or "ما فيه نتائج" end
  end
  local tried2 = false
  local function tryFetch(u, isV2)
    local ok = pcall(function()
      web.get(u, function(err, resp)
        if (err or not resp or not resp.body) then
          if isV2 and not tried2 then tried2 = true
            tryFetch("https://g.tenor.com/v1/search?q=" .. enc .. "&key=LIVDSRZULELA&limit=30&media_filter=minimal&contentfilter=high", false)
          else done(nil, "تعذّر الاتصال") end
          return
        end
        local list = parse(resp.body)
        if (not list or #list == 0) and isV2 and not tried2 then tried2 = true
          tryFetch("https://g.tenor.com/v1/search?q=" .. enc .. "&key=LIVDSRZULELA&limit=30&media_filter=minimal&contentfilter=high", false)
        else done(list) end
      end)
    end)
    if not ok then done(nil, "web.get غير متاح") end
  end
  tryFetch(url, true)
end

uSt.gifSend = function(url)
  if not url or url == "" then return end
  pcall(function() ac.sendChatMessage("$TeamKabos_GIF:" .. url) end)
  uSt.gifOpen = false
