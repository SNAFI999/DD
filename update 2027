-- Build a COMPLETE file map for the skin folder and apply that. Nothing is filtered out:
-- the earlier version skipped preview/json/ini AND preferred CSP's folder-based applySkin,
-- which on many mod skins only mapped part of the textures — so the car kept showing its
-- base colour underneath and the skin looked wrong ("غير واقعي").
local function applySkinDir(carNode, dir)
  local files = io.scanDir(dir, '*')
  if not files or #files == 0 then return end
  local map = {}
  for i = 1, #files do map[files[i]] = dir .. '/' .. files[i] end
  if next(map) ~= nil then carNode:applySkin(map) end
end

local function doApplySkin(skinName, carIndex)
  local theCar = ac.getCar(carIndex or 0)
  if not theCar then return end
  local carName = ac.getCarID(carIndex or 0)
  local carNode = ac.findNodes('carRoot:' .. theCar.index)
  local dir = ac.getFolder(ac.FolderID.ContentCars) .. '/' .. carName .. '/skins/' .. skinName
  -- Reset first, then apply the full file map. No "original skin" base layer and no
  -- folder-based shortcut: mapping every file explicitly is what makes the skin land
  -- exactly as its author shipped it, on your car and on everyone else's screen.
  carNode:resetSkin()
  applySkinDir(carNode, dir)
end

