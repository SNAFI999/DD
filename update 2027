    dwRightBox("شرطنا: الشكوى تُقبل كاملة إذا لك بالسيرفر آخر ٥ دقائق", 13, 24, 56, bw - 48, 18, rgbm(1, 0.85, 0.6, 1))
    dwRightBox("تقدر تشتكي بعد ٣٠ ثانية من دخولك، وتُقبل بحالات خاصة لو أقل", 12, 24, 80, bw - 48, 18, rgbm(0.82, 0.86, 0.92, 1))
    dwRightBox("اكتب السبب بوضوح ويترفع لنا مع مقطع الفيديو", 12, 24, 100, bw - 48, 18, rgbm(0.82, 0.86, 0.92, 1))
    ui.drawRectFilled(vec2(16, 128), vec2(bw - 16, 190), rgbm(0.95, 0.75, 0.2, 0.14), 10)
    ui.drawRect(vec2(16, 128), vec2(bw - 16, 190), rgbm(0.95, 0.75, 0.2, 0.6), 10, nil, 1.2)
    dwBox("مهم لحفظ المقطع", 13, 16, 133, bw - 32, 18, rgbm(1, 0.85, 0.4, 1))
    dwRightBox("١) وقت المخالفة اضغط  Ctrl + Shift + S  (يحفظ آخر ٣ دقائق)", 12, 24, 153, bw - 48, 18, CW)
    dwRightBox("٢) بعدها افتح هذي النافذة، اكتب السبب، وأرسل", 12, 24, 171, bw - 48, 18, CW)
    local iy = 202
    ui.setCursor(vec2(24, iy + 6))
    ui.setNextItemWidth(bw - 48)
    local nt, changed, entered = ui.inputText("##reportin" .. reportInputGen, reportInput, ui.InputTextFlags.RetainSelection)
    if changed then reportInput = nt end
    ui.drawRectFilled(vec2(16, iy), vec2(bw - 16, iy + 44), rgbm(0.11, 0.115, 0.14, 1), 9)
    ui.drawRect(vec2(16, iy), vec2(bw - 16, iy + 44), rgbm(1, 1, 1, 0.1), 9, nil, 1)
    if reportInput ~= "" then
      dwRightBox(reportInput, 16, 24, iy + 3, bw - 64, 38, CW)
    else
      dwRightBox("مثال: اللاعب فلان يصدم عمداً بنص الموكب", 13, 24, iy + 3, bw - 64, 38, CDm)
    end
    local by = iy + 62
    local hw = (bw - 60) * 0.5
    if bigButton(24, by, hw, 42, "إرسال الشكوى", reportInput ~= "" and rgbm(0.9, 0.24, 0.26, 1) or rgbm(0.3, 0.3, 0.36, 1), "##repsend") or (entered and reportInput ~= "") then
      if reportInput ~= "" then
        pcall(function()
          ac.sendChatMessage("/report " .. reportInput)
          ac.setMessage("تم إرسال شكواك", "وصلت الإدارة — شكراً لك", nil, 4)
        end)
        reportInput = ""; reportInputGen = reportInputGen + 1
        reportOpen = false
      end
    end
    if bigButton(24 + hw + 12, by, hw, 42, "إلغاء", rgbm(0.28, 0.30, 0.36, 1), "##repcancel") then
      reportOpen = false
    end
    dwBox("الإساءة باستخدام البلاغات تعرّضك للحظر", 11, 0, bh - 26, bw, 16, CDm)
  end)
end

function script.drawUI()
  local sim = ac.getSim()
  uSt.drawSpectate(sim)

  -- إخفاء شات اللعبة الأصلي (طريقة IDDL): نبحث عن نافذته ونخفيها، ونعيد التطبيق كل 5ث
  pcall(function()
    local now = pulseT
    if not uSt.vanillaWin then
      if now - (uSt.vanillaLastTry or -10) >= 3 then
        uSt.vanillaLastTry = now
        for _, nm in ipairs({ "Chat", "chat", "AC_CHAT", "ac_chat", "CHAT" }) do
          local w = ac.accessAppWindow(nm)
          if w and w:valid() then uSt.vanillaWin = w; break end
        end
      end
    end
    local w = uSt.vanillaWin
    if w and w:valid() and (not uSt.vanillaHidden or now >= (uSt.vanillaReapplyAt or 0)) then
      w:setVisible(false)
      w:resize(vec2(1, 1))
      w:move(vec2(99999, 99999))
      uSt.vanillaHidden = true
      uSt.vanillaReapplyAt = now + 5
    end
  end)

  if not rulesInit then
    rulesInit = true
    rulesOpen = true
  end

  if not rulesOpen then drawRulesNotification(sim) end
  drawDriftHud(sim)
  drawRewindHud(sim)
  drawChatLog(sim)
  drawChatBar(sim)
  if hoverInfo and (pulseT - hoverInfo.t) < 0.15 then pcall(function()
    local mp = ui.mousePos()
    local tw, th = 244, 96
    local tx = math.min(mp.x + 16, sim.windowWidth - tw - 8)
    local ty = math.min(mp.y + 4, sim.windowHeight - th - 8)
    ui.transparentWindow("hovertipTeamKabos", vec2(tx, ty), vec2(tw, th), function()
      ui.drawRectFilled(vec2(0, 0), vec2(tw, th), rgbm(0.05, 0.06, 0.09, 0.96), 8)
      ui.drawRect(vec2(0.5, 0.5), vec2(tw - 0.5, th - 0.5), rgbm(ACC.r, ACC.g, ACC.b, 0.6), 8, nil, 1)
      if hoverInfo.av then pcall(function() ui.drawImage(hoverInfo.av, vec2(8, 8), vec2(52, 52)) end) end
      if hoverInfo.inp then uSt.drawInp(16, 58, 24, hoverInfo.inp, 1) end
      dwRightBox(hoverInfo.name or "", 14, 58, 6, tw - 66, 20, CW)
      dwRightBox(string.format("السرعة: %d كم/س", hoverInfo.spd or 0), 12, 58, 28, tw - 66, 18, CY)
      dwRightBox(string.format("البنق: %d ms", hoverInfo.ping or -1), 12, 58, 48, tw - 66, 18, CGR)
      dwRightBox("كلك يمين على الاسم = انتقل له", 11, 8, 70, tw - 16, 16, rgbm(0.7, 0.75, 0.85, 1))
    end)
  end) end

  if menuOpen then
    local sw = sim.windowWidth
    local sh = sim.windowHeight
    local S = 1
    local pw, ph = PANEL_W * S, PANEL_H * S
    local px = math.floor((sw - pw) * 0.5) + stor.menuOfsX
    local py = math.floor((sh - ph) * 0.5) + stor.menuOfsY
    px = math.max(-pw + 80, math.min(sw - 80, px))
    py = math.max(0, math.min(sh - 60, py))
    ui.transparentWindow("menuTeamKabos", vec2(px, py), vec2(pw, ph), true, true, function()
      uSt.S = S
      local swapped = uSt.scaleOn()
      local ok, err = pcall(drawMenu)
      if swapped then uSt.scaleOff() end
      uSt.S = 1
      if not ok then ac.error("[TeamKabos] drawMenu: " .. tostring(err)) end
    end)
  else
    drawBottomHud(sim)
  end

  drawReport(sim)
  if uSt.spotsOpen and uSt.drawSpots then uSt.drawSpots(sim) end

  if ghostOn then
    ui.transparentWindow("ghostHUD", vec2(10, 10), vec2(320, 50), function()
      ui.drawRectFilled(vec2(0, 0), vec2(320, 50), rgbm(0, 0, 0, 0.6), 8)
      ui.dwriteTextAligned(string.format("بدون تصادم  %.1f ث", ghostT),
        17, ui.Alignment.Center, ui.Alignment.Center, vec2(300, 40), false, CC)
    end)
  end
  if swapTransition.active then
    local sw, sh = sim.windowWidth, sim.windowHeight
    ui.transparentWindow("swapOverlay", vec2(0, 0), vec2(sw, sh), function()
      ui.drawRectFilled(vec2(-100, -100), vec2(sw + 100, sh + 100), rgbm(0, 0, 0, 0.82))
      local cx, cy = sw * 0.5, sh * 0.5
      ui.setCursor(vec2(cx - 340, cy - 78))
      ui.dwriteTextAligned("جاري تبديل سيارتك...", 36, ui.Alignment.Center, ui.Alignment.Center, vec2(680, 48), false, CC)
      ui.setCursor(vec2(cx - 340, cy - 22))
      ui.dwriteTextAligned("انتظر لحظة، بيعيد اتصالك", 19, ui.Alignment.Center, ui.Alignment.Center, vec2(680, 28), false, rgbm(0.72, 0.75, 0.82, 1))
      local a = swapTransition.t * 7
      for i = 0, 11 do
        local ang = a + i * math.pi / 6
        local al = 0.15 + 0.85 * (i / 11)
        ui.drawCircleFilled(vec2(cx + math.cos(ang) * 34, cy + 62 + math.sin(ang) * 34), 5, rgbm(CC.r, CC.g, CC.b, al), 10)
      end
    end)
  end

  if rulesOpen then drawRulesScreen(sim) end
  -- بعد الموافقة على القوانين مباشرة: اختيار وضع السرعة (مرة كل دخول)
  if not rulesOpen and uSt.speedMode == nil then uSt.drawModePick(sim) end
end

