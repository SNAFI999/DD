-- UI scale. uSt.S is 1 everywhere except inside the menu window, where drawMenu raises it — so
-- the chat, the HUDs and the drift meter are untouched by it. Text goes through these three
-- helpers (153 call sites), so scaling here covers all of them at once. ui.beginScale() is NOT
-- usable for this: it only rewrites the vertex buffer, leaving every button's hit box behind
-- (CSP's own AppShelf only ever wraps it around a text draw).
uSt.S = 1

-- Scaling the rest: rects, circles, lines and — critically — ui.setCursor + the widget sizes,
-- because that is what decides where a button actually responds. Rather than touching 250-odd
-- call sites, we swap the ui.* functions for scaling versions while the menu draws and put the
-- originals back straight after. uSt.uiRaw holds the originals; if the ui table turns out to be
-- write-protected, uSt.scaleOk stays false, the swap never happens and the menu simply draws at
-- 1.0 — no crash, no half-scaled mess.
uSt.uiRaw = {}
uSt.scaleOk = false
do
  -- Every ui.* the menu draws with that takes a position or a size. Miss one and it renders at
  -- 1.0 inside a scaled panel — that's what cut the car thumbnails in half on the first attempt.
  local names = { "setCursor", "drawRectFilled", "drawRect", "drawCircleFilled", "drawCircle",
                  "drawLine", "drawTriangleFilled", "invisibleButton", "setNextItemWidth",
                  "image", "drawImage", "dummy", "childWindow", "measureDWriteText" }
  for _, n in ipairs(names) do uSt.uiRaw[n] = ui[n] end
  -- Probe once: can we even write to this table?
  local probe = ui.setCursor
  local ok = pcall(function() ui.setCursor = probe end)
  uSt.scaleOk = ok and ui.setCursor == probe
end

--- Multiplies vec2/number arguments by uSt.S. Colours, strings, flags and radii-as-numbers all
--- need different treatment, so each wrapper is explicit rather than clever.
--- Fields on uSt, not top-level locals: the chunk is at 199/200 and two more would kill the menu.
uSt.scaleOn = function()
  if not uSt.scaleOk or uSt.S == 1 then return false end
  local S, R = uSt.S, uSt.uiRaw
  ui.setCursor = function(p) return R.setCursor(vec2(p.x * S, p.y * S)) end
  ui.setNextItemWidth = function(w) return R.setNextItemWidth(w * S) end
  ui.invisibleButton = function(id, sz, ...) return R.invisibleButton(id, vec2(sz.x * S, sz.y * S), ...) end
  ui.drawRectFilled = function(p1, p2, col, r, ...) return R.drawRectFilled(vec2(p1.x * S, p1.y * S), vec2(p2.x * S, p2.y * S), col, r and r * S or r, ...) end
  ui.drawRect = function(p1, p2, col, r, f, t, ...) return R.drawRect(vec2(p1.x * S, p1.y * S), vec2(p2.x * S, p2.y * S), col, r and r * S or r, f, t and t * S or t, ...) end
  ui.drawCircleFilled = function(c, rad, col, seg, ...) return R.drawCircleFilled(vec2(c.x * S, c.y * S), rad * S, col, seg, ...) end
  ui.drawCircle = function(c, rad, col, seg, th, ...) return R.drawCircle(vec2(c.x * S, c.y * S), rad * S, col, seg, th and th * S or th, ...) end
  ui.drawLine = function(p1, p2, col, th, ...) return R.drawLine(vec2(p1.x * S, p1.y * S), vec2(p2.x * S, p2.y * S), col, th and th * S or th, ...) end
  ui.drawTriangleFilled = function(a, b, c, col, ...) return R.drawTriangleFilled(vec2(a.x * S, a.y * S), vec2(b.x * S, b.y * S), vec2(c.x * S, c.y * S), col, ...) end
  ui.image = function(src, sz, ...) return R.image(src, vec2(sz.x * S, sz.y * S), ...) end
  ui.drawImage = function(src, p1, p2, ...) return R.drawImage(src, vec2(p1.x * S, p1.y * S), vec2(p2.x * S, p2.y * S), ...) end
  ui.dummy = function(sz) return R.dummy(vec2(sz.x * S, sz.y * S)) end
  ui.childWindow = function(id, sz, ...) return R.childWindow(id, vec2(sz.x * S, sz.y * S), ...) end
  -- measureDWriteText is asked for a size in layout units, so ask the real one at the scaled
  -- font size and hand the answer back unscaled — callers do their own layout maths with it.
  ui.measureDWriteText = function(t, s, w)
    local r = R.measureDWriteText(t, s * S, w and w * S or w)
    return vec2(r.x / S, r.y / S)
  end
  return true
end

uSt.scaleOff = function()
  local R = uSt.uiRaw
  for n, f in pairs(R) do ui[n] = f end
end

-- IMPORTANT: pass x/y through UNSCALED. While the menu draws, ui.setCursor is the wrapped version
-- and already multiplies by uSt.S — scaling here too put the text at x*S² while its box sat at x*S,
-- which is what tore the key badges away from their letters. Only the font size and the text box,
-- which go to the unwrapped ui.dwriteTextAligned, need scaling by hand.
local function dwBox(t, s, x, y, w, h, c)
  local S = uSt.S
  ui.setCursor(vec2(x, y))
  ui.dwriteTextAligned(t, s * S, ui.Alignment.Center, ui.Alignment.Center, vec2(w * S, h * S), false, c or CW)
end
local function dwRightBox(t, s, x, y, w, h, c)
  local S = uSt.S
  ui.setCursor(vec2(x, y))
  ui.dwriteTextAligned(t, s * S, ui.Alignment.End, ui.Alignment.Center, vec2(w * S, h * S), false, c or CW)
end
local function dwLeftBox(t, s, x, y, w, h, c)
  local S = uSt.S
  ui.setCursor(vec2(x, y))
