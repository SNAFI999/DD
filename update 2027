uSt.czCfg = function()
  local ck = uSt.czCarKey()
  uSt.czMap[ck] = uSt.czMap[ck] or {}
  local m = uSt.czMap[ck]
  m.po = m.po or { y = 0.62, z = -2.35, w = 0.52 }
