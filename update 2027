uSt.hideCar = function(i, hide)
  local n = uSt.carNode(i)
  if not n then uSt.hideWay = "no-node"; return end
  if n.setVisible then
    if pcall(function() n:setVisible(not hide) end) then uSt.hideWay = "setVisible" end
  end
  if n.setOpacity then
    pcall(function() n:setOpacity(hide and 0 or 1) end)
