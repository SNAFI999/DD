  m.pBg = m.pBg or 1     -- لون خلفية اللوحة
  m.pFg = m.pFg or 2     -- لون خط اللوحة
  m.gFg = m.gFg or 1     -- لون خط القزاز (بلا خلفية)
  m.bright = m.bright or 3.5
  -- لوحات الصدام: القيم المشتركة في جدول، واللوحات في مصفوفة نقية.
  -- ⚠️ الخلط بينهما كان يفسد الحفظ: JSON يحوّل [1][2][3] لمفاتيح نصية فترجع nil
  -- ويموت رسم القسم كله عند أول قراءة بعد إعادة الدخول.
  -- نظّف أي bp قديم محفوظ بالصيغة المختلطة (كان يحمل مفاتيح "1","2","3" من JSON)
  if type(m.bp) == "table" and (m.bp[1] ~= nil or m.bp["1"] ~= nil) then m.bp = nil end
  m.bp = m.bp or { y = 0.40, z = -2.45, fg = 2, bg = 1 }
  m.bp.y = tonumber(m.bp.y) or 0.40
  m.bp.z = tonumber(m.bp.z) or -2.45
  m.bp.bg = tonumber(m.bp.bg) or 1
  m.bp.fg = tonumber(m.bp.fg) or 2
  m.pTxt = m.pTxt or ""      -- محفوظ: نص اللوحة
  m.gTxt = m.gTxt or ""      -- محفوظ: نص القزاز
  if m.pOn == nil then m.pOn = false end
  if m.gOn == nil then m.gOn = false end
  if type(m.bpl) ~= "table" or type(m.bpl[1]) ~= "table" or type(m.bpl[2]) ~= "table" or type(m.bpl[3]) ~= "table" then
    m.bpl = { { t = "", x = -0.55, w = 0.34 }, { t = "", x = 0, w = 0.34 }, { t = "", x = 0.55, w = 0.34 } }
  end
  for k = 1, 3 do
    local p = m.bpl[k]
    p.t = tostring(p.t or "")
    p.x = tonumber(p.x) or 0
    p.w = tonumber(p.w) or 0.34
  end
  return m
end
