-- طابور إرسال: سطر واحد كل ثانية. إرسال سطرين متلاصقين يجعل السيرفر يسقط
-- الثاني بحماية الإغراق — وهذا سبب تأخّر ظهور لوحات الصدام عند بقية اللاعبين.
uSt.czQ = {}
uSt.czQNext = 0
uSt.czPush = function(line)
  for _, v in ipairs(uSt.czQ) do if v == line then return end end   -- لا نكرر نفس السطر
  uSt.czQ[#uSt.czQ + 1] = line
end
uSt.czPump = function()
  if #uSt.czQ == 0 or pulseT < uSt.czQNext then return end
  local line = table.remove(uSt.czQ, 1)
  uSt.czQNext = pulseT + 1.0
  pcall(function() ac.sendChatMessage(line) end)
end

